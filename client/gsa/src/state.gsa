pub def markDirty(m: ClientModel): ClientModel = {
    let u = m.cmUi;
    if (u.uiDirty) m
    else withUi(m, MkUiChrome {
        uiLogs: u.uiLogs, uiNextLogId: u.uiNextLogId, uiUnreadLogs: u.uiUnreadLogs,
        uiDesktopDrawer: u.uiDesktopDrawer, uiCharSubTab: u.uiCharSubTab, uiMobileTab: u.uiMobileTab,
        uiSelectedNpc: u.uiSelectedNpc, uiFocusedInput: u.uiFocusedInput, uiSayDraft: u.uiSayDraft,
        uiDirty: true,
    })
}

pub def clearDirty(m: ClientModel): ClientModel = {
    let u = m.cmUi;
    if (!u.uiDirty) m
    else withUi(m, MkUiChrome {
        uiLogs: u.uiLogs, uiNextLogId: u.uiNextLogId, uiUnreadLogs: u.uiUnreadLogs,
        uiDesktopDrawer: u.uiDesktopDrawer, uiCharSubTab: u.uiCharSubTab, uiMobileTab: u.uiMobileTab,
        uiSelectedNpc: u.uiSelectedNpc, uiFocusedInput: u.uiFocusedInput, uiSayDraft: u.uiSayDraft,
        uiDirty: false,
    })
}

// ============================================================================
// Pure `ClientM a` Effect Monad (`MonadState ClientModel` + `MonadWriter (List ClientCmd)`)
// ============================================================================

pub data ClientM a {
    MkClientM(ClientModel -> (a, ClientModel, List ClientCmd)),
}

pub def runClientM(act: ClientM a, m0: ClientModel): (ClientModel, List ClientCmd) = match act {
    MkClientM(f) -> {
        let (_, m1, cmds) = f(m0);
        (m1, cmds)
    },
}

instance Functor ClientM {
    def fmap(g, ma) = match ma {
        MkClientM(f) -> MkClientM((m0) -> {
            let (a, m1, cs) = f(m0);
            (g(a), m1, cs)
        }),
    }
}

instance Applicative ClientM {
    def pure(x) = MkClientM((m) -> (x, m, Nil))
    def ap(mf, ma) = match (mf, ma) {
        (MkClientM(ff), MkClientM(fa)) -> MkClientM((m0) -> {
            let (f, m1, c1) = ff(m0);
            let (a, m2, c2) = fa(m1);
            (f(a), m2, listAppend(c1, c2))
        }),
    }
}

instance Monad ClientM {
    def (>>=)(ma, k) = match ma {
        MkClientM(fa) -> MkClientM((m0) -> {
            let (a, m1, c1) = fa(m0);
            match k(a) {
                MkClientM(fb) -> {
                    let (b, m2, c2) = fb(m1);
                    (b, m2, listAppend(c1, c2))
                },
            }
        }),
    }
}

instance MonadState ClientModel ClientM {
    def get() = MkClientM((m) -> (m, m, Nil))
    def put(m) = MkClientM((_) -> ((), m, Nil))
}

instance MonadWriter (List ClientCmd) ClientM {
    def tell(cs) = MkClientM((m) -> ((), m, cs))
}

def emitCmd(cmd: ClientCmd): ClientM Void = tell([cmd])
def emitCmds(cmds: List ClientCmd): ClientM Void = tell(cmds)

