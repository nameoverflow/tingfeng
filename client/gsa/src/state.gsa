            let u = m0.cmUi;
            let m1 = withUi(m0, MkUiChrome {
                uiLogs: u.uiLogs, uiNextLogId: u.uiNextLogId, uiUnreadLogs: u.uiUnreadLogs,
                uiDesktopDrawer: u.uiDesktopDrawer, uiCharSubTab: u.uiCharSubTab, uiMobileTab: u.uiMobileTab,
                uiSelectedNpc: None, uiFocusedInput: u.uiFocusedInput, uiSayDraft: u.uiSayDraft,
                uiDirty: true,
            });
            (m1, [CmdSendWs(encodePlayerAction(ActAttack(a1)))])
        },
        "learn" -> {
            let n = parseIntOr(a2, 1);
            match strSplitChar(a1, ':') {
                Cons(tid, Cons(aid, Nil)) -> (m0, [CmdSendWs(encodePlayerAction(ActLearn(tid, aid, n)))]),
                _ -> (m0, Nil),
            }
        },
        "buy" -> match strSplitChar(a1, ':') {
            Cons(merch, Cons(iid, Nil)) -> {
                let mMerch = if (strLen(merch) == 0) None else Some(merch);
                (m0, [CmdSendWs(encodePlayerAction(ActBuy(mMerch, iid)))])
            },
            _ -> (m0, [CmdSendWs(encodePlayerAction(ActBuy(None, a1)))]),
        },
        "perform" -> (m0, [CmdSendWs(encodePlayerAction(ActPerform(a1)))]),
        "perform_index" -> {
            let idx = parseIntOr(a1, -1);
            let skills = match m0.cmBattle.btSnap { Some(bs) -> bs.bsActiveSkills, None -> Nil };
            if (idx >= 0 && idx < listLen(skills)) {
                match std.list.listNth(skills, idx) {
                    Some(sk) -> (m0, [CmdSendWs(encodePlayerAction(ActPerform(sk.asId)))]),
                    None -> (m0, Nil),
                }
            } else (m0, Nil)
        },
        "practice" -> {
            let n = parseIntOr(a2, 1);
            (m0, [CmdSendWs(encodePlayerAction(ActPractice(a1, n)))])
        },
