// Sub-record update helpers on `ClientModel` (zero 70-field boilerplate!)

pub def withVp(m: ClientModel, vp: ViewportState): ClientModel = MkClientModel {
    cmPoseLib: m.cmPoseLib, cmCatalog: m.cmCatalog, cmVp: vp, cmAuth: m.cmAuth,
    cmWorld: m.cmWorld, cmHero: m.cmHero, cmCam: m.cmCam, cmBattle: m.cmBattle,
    cmFx: m.cmFx, cmLab: m.cmLab, cmUi: m.cmUi, cmScroll: m.cmScroll,
}

pub def withAuth(m: ClientModel, au: AuthState): ClientModel = MkClientModel {
    cmPoseLib: m.cmPoseLib, cmCatalog: m.cmCatalog, cmVp: m.cmVp, cmAuth: au,
    cmWorld: m.cmWorld, cmHero: m.cmHero, cmCam: m.cmCam, cmBattle: m.cmBattle,
    cmFx: m.cmFx, cmLab: m.cmLab, cmUi: m.cmUi, cmScroll: m.cmScroll,
}

pub def withWorld(m: ClientModel, wv: WorldView): ClientModel = MkClientModel {
    cmPoseLib: m.cmPoseLib, cmCatalog: m.cmCatalog, cmVp: m.cmVp, cmAuth: m.cmAuth,
    cmWorld: wv, cmHero: m.cmHero, cmCam: m.cmCam, cmBattle: m.cmBattle,
    cmFx: m.cmFx, cmLab: m.cmLab, cmUi: m.cmUi, cmScroll: m.cmScroll,
}

