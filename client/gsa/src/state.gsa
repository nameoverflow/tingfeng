def apBaselineAgility(): Float = 19.0
def apGainPerAgilitySecond(): Float = 100.0 / (2.0 * apBaselineAgility())
def gridScaleX(): Float = 178.0
def gridScaleY(): Float = 128.0

pub def worldPosFromGrid(pos: (Int, Int)): (Float, Float) = match pos {
    (gx, gy) -> (intToFloat(gx) * gridScaleX(), intToFloat(-gy) * gridScaleY()),
}

