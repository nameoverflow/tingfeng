        "enable" -> (m0, [CmdSendWs(encodePlayerAction(ActEnable(a1, a2)))]),
        "meditate" -> (m0, [CmdSendWs(encodePlayerAction(ActMeditate(20, 10)))]),
        "halt" -> (m0, [CmdSendWs(encodePlayerAction(ActOther("halt")))]),
        "use" -> (m0, [CmdSendWs(encodePlayerAction(ActUse(a1)))]),
        "study" -> (m0, [CmdSendWs(encodePlayerAction(ActStudy(a1, 10)))]),
        "refresh" -> (m0, [
            CmdSendWs(encodePlayerAction(ActOther("view"))),
            CmdSendWs(encodePlayerAction(ActOther("quests"))),
            CmdSendWs(encodePlayerAction(ActOther("inventory"))),
            CmdSendWs(encodePlayerAction(ActOther("arts")))
        ]),
        "say" -> {
            let s = utf8Trim(a1);
            if (strLen(s) == 0) (m0, Nil)
            else (m0, [CmdSendWs(encodePlayerAction(ActSay(s)))])
        },
        "clear_logs" -> {
            let u = m0.cmUi;
            (withUi(m0, MkUiChrome {
                uiLogs: Nil, uiNextLogId: u.uiNextLogId, uiUnreadLogs: 0,
                uiDesktopDrawer: u.uiDesktopDrawer, uiCharSubTab: u.uiCharSubTab, uiMobileTab: u.uiMobileTab,
