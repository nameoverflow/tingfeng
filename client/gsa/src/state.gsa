}

pub data ClientCmd {
    CmdSendWs(String),
    CmdConnectWs(String, String, Option CreationChoice),
    CmdOpenConfigWs,
    CmdSetCursor(String),
    CmdPlaySfx(String),
    CmdSaveLocal(String, String),
    CmdFocusInput(String, String, Float, Float, Float, Float),
    CmdBlurInput,
}

