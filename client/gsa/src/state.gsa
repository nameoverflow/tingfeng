// ============================================================================
// Logging, Camera Target Inference & Combat Presentation Queue
// ============================================================================

pub def pushLog(kind: String, txt: String, m: ClientModel): ClientModel =
    if (strLen(utf8Trim(txt)) == 0) m
    else {
        let u = m.cmUi;
        let lid = u.uiNextLogId;
        let entry = MkLogLine { llId: lid, llKind: kind, llText: txt };
        let prev = u.uiLogs;
        let nPrev = listLen(prev);
        let nextLogs =
            if (nPrev >= 80) listAppend(listDrop(prev, nPrev - 79), [entry])
            else listAppend(prev, [entry]);
        let unread =
            if (u.uiMobileTab == "world" || u.uiMobileTab == "log" || !m.cmAuth.auConnected) 0
            else minInt(99, u.uiUnreadLogs + 1);
        withUi(m, MkUiChrome {
            uiLogs: nextLogs,
            uiNextLogId: lid + 1,
            uiUnreadLogs: unread,
            uiDesktopDrawer: u.uiDesktopDrawer,
            uiCharSubTab: u.uiCharSubTab,
            uiMobileTab: u.uiMobileTab,
            uiSelectedNpc: u.uiSelectedNpc,
            uiFocusedInput: u.uiFocusedInput,
            uiSayDraft: u.uiSayDraft,
            uiDirty: true,
        })
    }

def inferCurrentGrid(exits: List RoomExit): Option (Int, Int) =
    listHead(listFilterMap(exits, (ex) -> match ex.rePos {
        Some((px, py)) -> {
            let (dx, dy) = directionGridDelta(ex.reDirection);
            Some((px - dx, py - dy))
        },
        None -> None,
    }))

def updateCameraTarget(m: ClientModel): ClientModel = {
    let mGrid = match m.cmWorld.wvMapOverview {
        Some(mo) -> Some(mo.moCurrentPos),
        None -> inferCurrentGrid(m.cmWorld.wvRoomExits),
    };
    let (tx, ty) = match mGrid {
        Some(g) -> worldPosFromGrid(g),
        None -> (0.0, 0.0),
    };
    let c = m.cmCam;
    withCam(m, MkCameraState {
        camX: c.camX, camY: c.camY,
        targetCamX: tx, targetCamY: ty,
        panX: c.panX, panY: c.panY, mapZoom: c.mapZoom,
    })
}

def snapCamToTarget(m: ClientModel): ClientModel = {
    let c = m.cmCam;
    withCam(m, MkCameraState {
        camX: c.targetCamX, camY: c.targetCamY,
        targetCamX: c.targetCamX, targetCamY: c.targetCamY,
        panX: c.panX, panY: c.panY, mapZoom: c.mapZoom,
    })
}

def currentStylesAndProfiles(m: ClientModel): (CombatStyle, CombatStyle, WeaponVisual, WeaponVisual, VisualProfile, VisualProfile, String, String) =
    match m.cmBattle.btSnap {
        Some(bs) -> {
            let p = bs.bsPlayer;
            let e = bs.bsEnemy;
            let pSt = parseCombatStyle(p.cbStyle);
            let eSt = parseCombatStyle(e.cbStyle);
            (
                pSt,
                eSt,
                parseWeaponVisual(p.cbWeaponVisual, pSt),
                parseWeaponVisual(e.cbWeaponVisual, eSt),
                parseVisualProfile(p.cbGender),
                parseVisualProfile(e.cbGender),
                p.cbName,
                e.cbName
            )
        },
        None -> (
            StyleFist,
            StyleSword,
            WeaponUnarmed,
            WeaponJian,
            parseVisualProfile(m.cmHero.hsStats.psGender),
            ProfileMale,
            if (strLen(m.cmAuth.auUsername) == 0) "行者" else m.cmAuth.auUsername,
            "对手"
        ),
    }

def formatCombatLogText(loc: Locale, ev: CombatEvt): String =
    if (ev.ceMsgKind == "effect_tick") {
        let amt = intToStr(ev.ceEffectAmount);
        if (ev.ceEffectKind == "hot") {
            ev.ceText + (if (isZh(loc)) "回复 " + amt + " 点气血" else " +" + amt + " HP")
        } else {
            ev.ceText + (if (isZh(loc)) "造成 " + amt + " 点伤害" else " -" + amt + " HP")
        }
    } else if (strLen(utf8Trim(ev.ceText)) > 0) {
        let base = utf8Trim(ev.ceText);
        let suffix = match (ev.ceResult, ev.ceDamage, ev.ceHeal) {
            (ResHit, Some(d), _) if (d > 0) -> "（-" + intToStr(d) + " " + tr(loc, "resource.hp") + "）",
            (_, _, Some(h)) if (h > 0) -> "（+" + intToStr(h) + " " + tr(loc, "resource.hp") + "）",
            (ResDodge, _, _) -> if (strContains(base, "闪")) "" else "（闪避）",
            (ResParry, _, _) -> if (strContains(base, "架")) "" else "（招架）",
            _ -> "",
        };
        base + suffix
    } else {
        ev.ceActorName + " → " + ev.ceTargetName
    }

def snapToPresentation(bs: BattleSnap): PresentationState = MkPresentationState {
    prPlayerHp: bs.bsPlayer.cbHp,
    prEnemyHp: bs.bsEnemy.cbHp,
    prPlayerQi: bs.bsPlayer.cbQi,
    prEnemyQi: bs.bsEnemy.cbQi,
    prPlayerEffects: bs.bsPlayer.cbEffects,
    prEnemyEffects: bs.bsEnemy.cbEffects,
}

def commitHitsUpToM(elapsed: Float): ClientM Void =
    get() >>= (m0) ->
    match m0.cmBattle.btActiveTimeline {
        None -> pure(()),
        Some(tl) ->
            if (tl.tlKind == "settlement") pure(())
            else {
                let hits = tl.tlHits;
                let nHits = listLen(hits);
                let already = m0.cmBattle.btAppliedHits;
                let dueIdx = listFilter(
                    intRange(0, nHits - 1),
                    (i) -> i >= already && elapsed >= (listNthOr(hits, i, MkResolvedHit {
                        rhAtMs: 999999.0, rhHitStopMs: 0.0, rhDamage: None, rhHeal: None,
                        rhFloatText: "", rhResult: ResHit, rhReaction: catalog.ReactNone,
                        rhTargetVisual: tl.tlTarget.rtVisual, rhStaging: tl.tlStaging,
                    })).rhAtMs
                );
                if (listIsEmpty(dueIdx)) pure(())
                else {
                    let pMax = match m0.cmBattle.btSnap {
                        Some(bs) -> bs.bsPlayer.cbMaxHp,
                        None -> m0.cmHero.hsStats.psMaxHp,
                    };
                    let eMax = match m0.cmBattle.btSnap {
                        Some(bs) -> bs.bsEnemy.cbMaxHp,
                        None -> 180,
                    };
                    let pr0 = optOr(m0.cmBattle.btPresentation, MkPresentationState {
                        prPlayerHp: 100, prEnemyHp: 100, prPlayerQi: 100, prEnemyQi: 100,
                        prPlayerEffects: Nil, prEnemyEffects: Nil,
                    });
                    let pr1 = std.list.listFold(dueIdx, pr0, (pr, idx) -> {
                        let h = listNthOr(hits, idx, optOr(listHead(hits), MkResolvedHit {
                            rhAtMs: 0.0, rhHitStopMs: 0.0, rhDamage: None, rhHeal: None,
                            rhFloatText: "", rhResult: ResHit, rhReaction: catalog.ReactNone,
                            rhTargetVisual: tl.tlTarget.rtVisual, rhStaging: tl.tlStaging,
                        }));
                        let dmg = if (combatResEq(h.rhResult, ResHit)) optOr(h.rhDamage, 0) else 0;
                        let hl = optOr(h.rhHeal, 0);
                        let delta = -dmg + hl;
                        if (sideEq(tl.tlTargetSide, SidePlayer)) {
                            MkPresentationState {
                                prPlayerHp: clampInt(0, pMax, pr.prPlayerHp + delta),
                                prEnemyHp: pr.prEnemyHp,
                                prPlayerQi: pr.prPlayerQi, prEnemyQi: pr.prEnemyQi,
                                prPlayerEffects: pr.prPlayerEffects, prEnemyEffects: pr.prEnemyEffects,
                            }
                        } else {
                            MkPresentationState {
                                prPlayerHp: pr.prPlayerHp,
                                prEnemyHp: clampInt(0, eMax, pr.prEnemyHp + delta),
                                prPlayerQi: pr.prPlayerQi, prEnemyQi: pr.prEnemyQi,
                                prPlayerEffects: pr.prPlayerEffects, prEnemyEffects: pr.prEnemyEffects,
                            }
                        }
                    });
                    let lastIdx = optOr(listLast(dueIdx), already);
                    let lastHit = listNthOr(hits, lastIdx, optOr(listHead(hits), MkResolvedHit {
                        rhAtMs: 0.0, rhHitStopMs: 0.0, rhDamage: None, rhHeal: None,
                        rhFloatText: "", rhResult: ResHit, rhReaction: catalog.ReactNone,
                        rhTargetVisual: tl.tlTarget.rtVisual, rhStaging: tl.tlStaging,
                    }));
                    let prFinal =
                        if (lastIdx + 1 >= nHits && listIsEmpty(m0.cmBattle.btQueue)) {
                            match m0.cmBattle.btSnap {
                                Some(bs) -> MkPresentationState {
                                    prPlayerHp: pr1.prPlayerHp,
                                    prEnemyHp: pr1.prEnemyHp,
                                    prPlayerQi: bs.bsPlayer.cbQi,
                                    prEnemyQi: bs.bsEnemy.cbQi,
                                    prPlayerEffects: bs.bsPlayer.cbEffects,
                                    prEnemyEffects: bs.bsEnemy.cbEffects,
                                },
                                None -> pr1,
                            }
                        } else pr1;

                    let fx0 = m0.cmFx;
                    let hitFlashP =
                        if (sideEq(tl.tlTargetSide, SidePlayer) && combatResEq(lastHit.rhResult, ResHit)) 220.0
                        else fx0.fxPlayerHitFlashMs;
                    let hitFlashE =
                        if (sideEq(tl.tlTargetSide, SideEnemy) && combatResEq(lastHit.rhResult, ResHit)) 220.0
                        else fx0.fxEnemyHitFlashMs;

                    let sc = sampleBattleScene(Some(tl), elapsed, tl.tlActor.raVisual, tl.tlTarget.rtVisual, m0.cmVp.vpReducedMotion);
                    let (wx, wy) = sc.scContact;
                    let showImpact = !m0.cmVp.vpReducedMotion && !combatResEq(lastHit.rhResult, ResDodge);
                    let newParts =
                        if (!showImpact) Nil
                        else spawnHitParticles((wx, wy), tl.tlActorSide, lastHit.rhResult, lastHit.rhStaging.spForce, roundInt(m0.cmVp.vpClockMs) + lastIdx * 31);

                    let bt0 = m0.cmBattle;
                    let m1 = markDirty(withFx(
                        withBattle(m0, MkBattleStateView {
                            btInBattle: bt0.btInBattle, btSnap: bt0.btSnap,
                            btCooldownSyncedMs: bt0.btCooldownSyncedMs, btActionLockUntilMs: bt0.btActionLockUntilMs,
                            btPresentation: Some(prFinal), btPreEventSnap: bt0.btPreEventSnap,
                            btActiveTimeline: bt0.btActiveTimeline, btTimelineElapsedMs: bt0.btTimelineElapsedMs,
                            btAppliedHits: lastIdx + 1, btNextTimelineId: bt0.btNextTimelineId,
                            btQueue: bt0.btQueue,
                        }),
                        MkBattleFxState {
                            fxPlayerHpTrail: fx0.fxPlayerHpTrail, fxEnemyHpTrail: fx0.fxEnemyHpTrail,
                            fxPlayerApAnim: fx0.fxPlayerApAnim, fxEnemyApAnim: fx0.fxEnemyApAnim,
                            fxPlayerHitFlashMs: hitFlashP, fxEnemyHitFlashMs: hitFlashE,
                            fxParticles: listAppend(fx0.fxParticles, newParts),
                            fxShockPos: (wx, wy),
                            fxShockAge: 0.0,
                            fxShockPower: if (showImpact) lastHit.rhStaging.spForce else 0.0,
                        }
                    ));
                    put(m1) *>>
                    whenM(m0.cmVp.vpSoundOn, () -> {
                        let kind =
                            if (combatResEq(lastHit.rhResult, ResParry)) "parry"
                            else if (combatResEq(lastHit.rhResult, ResHit)) "impact"
                            else "whoosh";
                        emitCmd(CmdPlaySfx(kind))
                    })
                }
            },
    }

def startNextBattleItemM(): ClientM Void =
    get() >>= (m0) ->
    let bt0 = m0.cmBattle in
    match bt0.btQueue {
        Nil -> {
            let alignedPres = match bt0.btSnap {
                Some(bs) -> Some(snapToPresentation(bs)),
                None -> bt0.btPresentation,
            };
            put(markDirty(withBattle(m0, MkBattleStateView {
                btInBattle: bt0.btInBattle, btSnap: bt0.btSnap,
                btCooldownSyncedMs: bt0.btCooldownSyncedMs, btActionLockUntilMs: bt0.btActionLockUntilMs,
                btPresentation: alignedPres, btPreEventSnap: bt0.btPreEventSnap,
                btActiveTimeline: None, btTimelineElapsedMs: 0.0,
                btAppliedHits: 0, btNextTimelineId: bt0.btNextTimelineId,
                btQueue: Nil,
            })))
        },
        Cons(item, rest) -> {
            let (pStyle, eStyle, pWeapon, eWeapon, pProf, eProf, pName, eName) = currentStylesAndProfiles(m0);
            let tid = bt0.btNextTimelineId;
            match item {
                QCombat(ev, mPreSnap) -> {
                    let actorSide = if (ev.ceActorName == eName && ev.ceActorName != pName) SideEnemy else SidePlayer;
                    let targetSide =
                        if (ev.ceTargetName == pName) SidePlayer
                        else if (ev.ceTargetName == eName) SideEnemy
                        else if (sideEq(actorSide, SidePlayer)) SideEnemy
                        else SidePlayer;
                    let logTxt = formatCombatLogText(m0.cmVp.vpLocale, ev);
                    let tl = resolveCombatTimeline(
                        m0.cmCatalog, ev, tid, actorSide, targetSide, logTxt,
                        if (sideEq(actorSide, SidePlayer)) pProf else eProf,
                        if (sideEq(targetSide, SidePlayer)) pProf else eProf,
                        if (sideEq(actorSide, SidePlayer)) pStyle else eStyle,
                        if (sideEq(targetSide, SidePlayer)) pStyle else eStyle,
                        if (sideEq(actorSide, SidePlayer)) pWeapon else eWeapon,
                        if (sideEq(targetSide, SidePlayer)) pWeapon else eWeapon
                    );
                    let pres0 = match (bt0.btPresentation, mPreSnap) {
                        (Some(pr), _) -> pr,
                        (None, Some(pr)) -> pr,
                        (None, None) -> match bt0.btSnap {
                            Some(bs) -> snapToPresentation(bs),
                            None -> MkPresentationState {
                                prPlayerHp: m0.cmHero.hsStats.psHp, prEnemyHp: 100,
                                prPlayerQi: m0.cmHero.hsStats.psQi, prEnemyQi: 100,
                                prPlayerEffects: Nil, prEnemyEffects: Nil,
                            },
                        },
                    };
                    let fx0 = m0.cmFx;
                    let (pApNext, eApNext) = match bt0.btSnap {
                        Some(bs) -> (
                            if (sideEq(actorSide, SidePlayer)) bs.bsPlayer.cbApProgress else fx0.fxPlayerApAnim,
                            if (sideEq(actorSide, SideEnemy)) bs.bsEnemy.cbApProgress else fx0.fxEnemyApAnim
                        ),
                        None -> (fx0.fxPlayerApAnim, fx0.fxEnemyApAnim),
                    };
                    let m1 = pushLog("combat", logTxt, withFx(
                        withBattle(m0, MkBattleStateView {
                            btInBattle: true, btSnap: bt0.btSnap,
                            btCooldownSyncedMs: bt0.btCooldownSyncedMs, btActionLockUntilMs: bt0.btActionLockUntilMs,
                            btPresentation: Some(pres0), btPreEventSnap: bt0.btPreEventSnap,
                            btActiveTimeline: Some(tl), btTimelineElapsedMs: 0.0,
                            btAppliedHits: 0, btNextTimelineId: tid + 1,
                            btQueue: rest,
                        }),
                        MkBattleFxState {
                            fxPlayerHpTrail: fx0.fxPlayerHpTrail, fxEnemyHpTrail: fx0.fxEnemyHpTrail,
                            fxPlayerApAnim: pApNext, fxEnemyApAnim: eApNext,
                            fxPlayerHitFlashMs: fx0.fxPlayerHitFlashMs, fxEnemyHitFlashMs: fx0.fxEnemyHitFlashMs,
                            fxParticles: fx0.fxParticles, fxShockPos: fx0.fxShockPos,
                            fxShockAge: fx0.fxShockAge, fxShockPower: fx0.fxShockPower,
                        }
                    ));
                    put(m1) *>>
                    (if (m1.cmVp.vpDocHidden) {
                        commitHitsUpToM(tl.tlDurationMs + 1.0) *>>
                        drainImmediatelyM()
                    } else {
                        whenM(m1.cmVp.vpSoundOn && tl.tlKind != "effect_tick", () -> emitCmd(CmdPlaySfx("whoosh"))) *>>
                        commitHitsUpToM(0.0)
                    })
                },
                QSettlement(atk, dfd, win) -> {
                    let actorSide = if (win) SidePlayer else SideEnemy;
                    let targetSide = if (win) SideEnemy else SidePlayer;
                    let enemyName = if (atk == m0.cmAuth.auUsername) dfd else atk;
                    let txt =
                        if (isZh(m0.cmVp.vpLocale)) (if (win) "胜。与" else "败。与") + enemyName + "的交锋已分胜负。"
                        else (if (win) "Victory against " else "Defeat against ") + enemyName + ".";
                    let tl = resolveSettlementTimeline(m0.cmCatalog, tid, actorSide, targetSide, txt, pProf, eProf, pStyle, eStyle, pWeapon, eWeapon);
                    let m1 = pushLog("combat", txt, withBattle(m0, MkBattleStateView {
                        btInBattle: bt0.btInBattle, btSnap: bt0.btSnap,
                        btCooldownSyncedMs: bt0.btCooldownSyncedMs, btActionLockUntilMs: bt0.btActionLockUntilMs,
                        btPresentation: bt0.btPresentation, btPreEventSnap: bt0.btPreEventSnap,
                        btActiveTimeline: Some(tl), btTimelineElapsedMs: 0.0,
                        btAppliedHits: 1, btNextTimelineId: tid + 1,
                        btQueue: rest,
                    }));
                    put(m1) *>>
                    whenM(m1.cmVp.vpDocHidden, () -> drainImmediatelyM())
                },
            }
        },
    }

def drainImmediatelyM(): ClientM Void =
    get() >>= (m0) ->
    let bt0 = m0.cmBattle in
    match bt0.btActiveTimeline {
        None ->
            if (listIsEmpty(bt0.btQueue)) pure(())
            else {
                let (m1, _) = runClientM(startNextBattleItemM(), m0);
                put(m1) *>> drainImmediatelyM()
            },
        Some(tl) -> {
            let (m1, _) = runClientM(commitHitsUpToM(tl.tlDurationMs + 1.0), m0);
            let bt1 = m1.cmBattle;
            let m2 =
                if (tl.tlKind == "settlement") {
                    markDirty(withBattle(m1, MkBattleStateView {
                        btInBattle: false, btSnap: bt1.btSnap,
                        btCooldownSyncedMs: bt1.btCooldownSyncedMs, btActionLockUntilMs: bt1.btActionLockUntilMs,
                        btPresentation: None, btPreEventSnap: bt1.btPreEventSnap,
                        btActiveTimeline: None, btTimelineElapsedMs: bt1.btTimelineElapsedMs,
                        btAppliedHits: bt1.btAppliedHits, btNextTimelineId: bt1.btNextTimelineId,
                        btQueue: bt1.btQueue,
                    }))
                } else {
                    markDirty(withBattle(m1, MkBattleStateView {
                        btInBattle: bt1.btInBattle, btSnap: bt1.btSnap,
                        btCooldownSyncedMs: bt1.btCooldownSyncedMs, btActionLockUntilMs: bt1.btActionLockUntilMs,
                        btPresentation: bt1.btPresentation, btPreEventSnap: bt1.btPreEventSnap,
                        btActiveTimeline: None, btTimelineElapsedMs: bt1.btTimelineElapsedMs,
                        btAppliedHits: bt1.btAppliedHits, btNextTimelineId: bt1.btNextTimelineId,
                        btQueue: bt1.btQueue,
                    }))
                };
            put(m2) *>>
            (if (listIsEmpty(m2.cmBattle.btQueue)) pure(())
             else {
                 let (m3, _) = runClientM(startNextBattleItemM(), m2);
                 put(m3) *>> drainImmediatelyM()
             })
        },
    }

// ============================================================================
// Story Sequencing & Server Message Application
// ============================================================================

def isStorySequencedMsg(msg: ServerMsg): Bool = match msg {
    SmStory(_, _) -> true,
    SmDialogue(_, _) -> true,
    SmStoryTransition(_, _) -> true,
    SmStorySequence(_) -> true,
    SmStoryDelay(_) -> true,
    SmMove(_) -> true,
    SmView(_, _, _, _) -> true,
    SmMapOverview(_) -> true,
    SmReward(_) -> true,
    _ -> false,
}

def setWorldStoryQueue(m: ClientModel, q: List ServerMsg, remMs: Float): ClientModel = {
    let wv = m.cmWorld;
    withWorld(m, MkWorldView {
        wvRoomName: wv.wvRoomName, wvRoomDesc: wv.wvRoomDesc,
        wvRoomChars: wv.wvRoomChars, wvRoomExits: wv.wvRoomExits,
        wvMapOverview: wv.wvMapOverview, wvMapCache: wv.wvMapCache,
        wvRequestedInit: wv.wvRequestedInit, wvStoryActive: wv.wvStoryActive,
        wvStoryQueue: q, wvStoryDelayRemMs: remMs, wvTransitionBanner: wv.wvTransitionBanner,
    })
}

def applyServerMessageNowM(msg: ServerMsg): ClientM Void =
    get() >>= (m0) ->
    match msg {
        SmCreationConfig(cfg) -> {
            let defGender = match listHead(cfg.cfgGenders) { Some((g, _)) -> g, None -> "female" };
            let defOrig = match listHead(cfg.cfgOrigins) { Some(o) -> o.coId, None -> "" };
            let defC1 = match listHead(cfg.cfgChildhood1) { Some(o) -> o.coId, None -> "" };
            let defC2 = match listHead(cfg.cfgChildhood2) { Some(o) -> o.coId, None -> "" };
            let au = m0.cmAuth;
            put(markDirty(withAuth(m0, MkAuthState {
                auConnected: au.auConnected, auConnecting: au.auConnecting,
                auUsername: au.auUsername, auLastError: au.auLastError,
                auLoginMode: au.auLoginMode, auCreateStep: au.auCreateStep,
                auCreationCfg: Some(cfg),
                auCreateChoice: MkCreationChoice {
                    ccGender: defGender, ccOrigin: defOrig, ccChildhood1: defC1, ccChildhood2: defC2,
                },
                auDevReset: au.auDevReset,
            })))
        },
        SmMove(dst) -> {
            let txt = if (isZh(m0.cmVp.vpLocale)) "你进入了【" + dst + "】。" else "Entered [" + dst + "].";
            let c = m0.cmCam;
            let m1 = withCam(m0, MkCameraState {
                camX: c.camX, camY: c.camY,
                targetCamX: c.targetCamX, targetCamY: c.targetCamY,
                panX: 0.0, panY: 0.0, mapZoom: c.mapZoom,
            });
            put(pushLog("move", txt, m1))
        },
        SmView(rName, rDesc, chars, exits) -> {
            let findInMo = (mo: MapOverview) -> match listFind(mo.moRooms, (r) -> r.mrRoomName == rName) {
                Some(r) -> Some(MkMapOverview {
                    moMapId: mo.moMapId, moMapName: mo.moMapName,
                    moCurrentPos: r.mrPos, moRooms: mo.moRooms, moEdges: mo.moEdges,
                }),
                None -> None,
            };
            let searchCache = () -> listHead(listFilterMap(mapElems(m0.cmWorld.wvMapCache), findInMo));
            let (nextMo, switchedMap) = match m0.cmWorld.wvMapOverview {
                Some(mo) -> match findInMo(mo) {
                    Some(mo2) -> (Some(mo2), false),
                    None -> match searchCache() {
                        Some(mo2) -> (Some(mo2), true),
                        None -> (Some(mo), false),
                    },
                },
                None -> match searchCache() {
                    Some(mo2) -> (Some(mo2), true),
                    None -> (None, false),
                },
            };
            let wv0 = m0.cmWorld;
            let au0 = m0.cmAuth;
            let ui0 = m0.cmUi;
            let mBase = markDirty(withUi(
                withAuth(
                    withWorld(m0, MkWorldView {
                        wvRoomName: rName, wvRoomDesc: rDesc,
                        wvRoomChars: chars, wvRoomExits: exits,
                        wvMapOverview: nextMo, wvMapCache: wv0.wvMapCache,
                        wvRequestedInit: true, wvStoryActive: wv0.wvStoryActive,
                        wvStoryQueue: wv0.wvStoryQueue, wvStoryDelayRemMs: wv0.wvStoryDelayRemMs,
                        wvTransitionBanner: wv0.wvTransitionBanner,
                    }),
                    MkAuthState {
                        auConnected: true, auConnecting: false,
                        auUsername: au0.auUsername, auLastError: None,
                        auLoginMode: au0.auLoginMode, auCreateStep: au0.auCreateStep,
                        auCreationCfg: au0.auCreationCfg, auCreateChoice: au0.auCreateChoice,
                        auDevReset: au0.auDevReset,
                    }
                ),
                MkUiChrome {
                    uiLogs: ui0.uiLogs, uiNextLogId: ui0.uiNextLogId, uiUnreadLogs: ui0.uiUnreadLogs,
                    uiDesktopDrawer: ui0.uiDesktopDrawer, uiCharSubTab: ui0.uiCharSubTab, uiMobileTab: ui0.uiMobileTab,
                    uiSelectedNpc: None, uiFocusedInput: ui0.uiFocusedInput, uiSayDraft: ui0.uiSayDraft,
                    uiDirty: true,
                }
            ));
            let m1 = updateCameraTarget(mBase);
            let m2 = if (switchedMap) snapCamToTarget(m1) else m1;
            put(m2) *>>
            (if (!wv0.wvRequestedInit) {
                emitCmds([
                    CmdSendWs(encodePlayerAction(ActOther("map"))),
                    CmdSendWs(encodePlayerAction(ActOther("quests"))),
                    CmdSendWs(encodePlayerAction(ActOther("inventory"))),
                    CmdSendWs(encodePlayerAction(ActOther("arts")))
                ])
            } else {
                let prevMapId = match wv0.wvMapOverview { Some(m) -> m.moMapId, None -> "" };
                let nextMapId = match nextMo { Some(m) -> m.moMapId, None -> "" };
                let foundRoom = match nextMo { Some(m) -> optIsSome(findInMo(m)), None -> false };
                whenM(switchedMap || nextMapId != prevMapId || !foundRoom, () ->
                    emitCmd(CmdSendWs(encodePlayerAction(ActOther("map"))))
                )
            })
        },
        SmMapOverview(mo) -> {
            let prevId = match m0.cmWorld.wvMapOverview { Some(old) -> old.moMapId, None -> "" };
            let mapChanged = optIsNone(m0.cmWorld.wvMapOverview) || prevId != mo.moMapId;
            let wv0 = m0.cmWorld;
            let cacheNext = mapInsert(wv0.wvMapCache, mo.moMapId, mo);
            let m1 = updateCameraTarget(markDirty(withWorld(m0, MkWorldView {
                wvRoomName: wv0.wvRoomName, wvRoomDesc: wv0.wvRoomDesc,
                wvRoomChars: wv0.wvRoomChars, wvRoomExits: wv0.wvRoomExits,
                wvMapOverview: Some(mo), wvMapCache: cacheNext,
                wvRequestedInit: wv0.wvRequestedInit, wvStoryActive: wv0.wvStoryActive,
                wvStoryQueue: wv0.wvStoryQueue, wvStoryDelayRemMs: wv0.wvStoryDelayRemMs,
                wvTransitionBanner: wv0.wvTransitionBanner,
            })));
            put(if (mapChanged) snapCamToTarget(m1) else m1)
        },
        SmAttack(atk, dfd) -> {
            let txt = atk + (if (isZh(m0.cmVp.vpLocale)) " 对 " else " attacks ") + dfd + "！";
            let bt0 = m0.cmBattle;
            let ui0 = m0.cmUi;
            let m1 = pushLog("combat", txt, withUi(
                withBattle(m0, MkBattleStateView {
                    btInBattle: true, btSnap: bt0.btSnap,
                    btCooldownSyncedMs: bt0.btCooldownSyncedMs, btActionLockUntilMs: bt0.btActionLockUntilMs,
                    btPresentation: bt0.btPresentation, btPreEventSnap: bt0.btPreEventSnap,
                    btActiveTimeline: bt0.btActiveTimeline, btTimelineElapsedMs: bt0.btTimelineElapsedMs,
                    btAppliedHits: bt0.btAppliedHits, btNextTimelineId: bt0.btNextTimelineId,
                    btQueue: bt0.btQueue,
                }),
                MkUiChrome {
                    uiLogs: ui0.uiLogs, uiNextLogId: ui0.uiNextLogId, uiUnreadLogs: ui0.uiUnreadLogs,
                    uiDesktopDrawer: "", uiCharSubTab: ui0.uiCharSubTab, uiMobileTab: "world",
                    uiSelectedNpc: None, uiFocusedInput: ui0.uiFocusedInput, uiSayDraft: ui0.uiSayDraft,
                    uiDirty: true,
                }
            ));
            put(m1)
        },
        SmBattleState(bs) -> {
            let p = bs.bsPlayer;
            let e = bs.bsEnemy;
            let bt0 = m0.cmBattle;
            let idleQueue = optIsNone(bt0.btActiveTimeline) && listIsEmpty(bt0.btQueue);
            let fullPres = snapToPresentation(bs);
            let nextPres =
                if (idleQueue) Some(fullPres)
                else match bt0.btPresentation {
                    Some(pr) -> Some(pr),
                    None -> Some(fullPres),
                };
            let curPHp = match nextPres { Some(pr) -> pr.prPlayerHp, None -> p.cbHp };
            let curEHp = match nextPres { Some(pr) -> pr.prEnemyHp, None -> e.cbHp };
            let pRatio = intToFloat(curPHp) / intToFloat(maxInt(1, p.cbMaxHp));
            let eRatio = intToFloat(curEHp) / intToFloat(maxInt(1, e.cbMaxHp));
            let lockUntil = m0.cmVp.vpClockMs + maxFloat(0.0, bs.bsActionLock) * 1000.0;
            let fx0 = m0.cmFx;
            put(markDirty(withFx(
                withBattle(m0, MkBattleStateView {
                    btInBattle: true,
                    btSnap: Some(bs),
                    btCooldownSyncedMs: m0.cmVp.vpClockMs,
                    btActionLockUntilMs: lockUntil,
                    btPresentation: nextPres,
                    btPreEventSnap: Some(fullPres),
                    btActiveTimeline: bt0.btActiveTimeline,
                    btTimelineElapsedMs: bt0.btTimelineElapsedMs,
                    btAppliedHits: bt0.btAppliedHits,
                    btNextTimelineId: bt0.btNextTimelineId,
                    btQueue: bt0.btQueue,
                }),
                MkBattleFxState {
                    fxPlayerHpTrail: maxFloat(fx0.fxPlayerHpTrail, pRatio),
                    fxEnemyHpTrail: maxFloat(fx0.fxEnemyHpTrail, eRatio),
                    fxPlayerApAnim: p.cbApProgress,
                    fxEnemyApAnim: e.cbApProgress,
                    fxPlayerHitFlashMs: fx0.fxPlayerHitFlashMs,
                    fxEnemyHitFlashMs: fx0.fxEnemyHitFlashMs,
                    fxParticles: fx0.fxParticles,
                    fxShockPos: fx0.fxShockPos,
                    fxShockAge: fx0.fxShockAge,
                    fxShockPower: fx0.fxShockPower,
                }
            )))
        },
        SmCombatEvent(ev) -> {
            let bt0 = m0.cmBattle;
            let mQueued = withBattle(m0, MkBattleStateView {
                btInBattle: true, btSnap: bt0.btSnap,
                btCooldownSyncedMs: bt0.btCooldownSyncedMs, btActionLockUntilMs: bt0.btActionLockUntilMs,
                btPresentation: bt0.btPresentation, btPreEventSnap: bt0.btPreEventSnap,
                btActiveTimeline: bt0.btActiveTimeline, btTimelineElapsedMs: bt0.btTimelineElapsedMs,
                btAppliedHits: bt0.btAppliedHits, btNextTimelineId: bt0.btNextTimelineId,
                btQueue: listAppend(bt0.btQueue, [QCombat(ev, bt0.btPreEventSnap)]),
            });
            put(mQueued) *>>
            (if (mQueued.cmVp.vpDocHidden) drainImmediatelyM()
             else if (optIsSome(mQueued.cmBattle.btActiveTimeline)) modify(markDirty)
             else startNextBattleItemM())
        },
        SmCombatSettlement(atk, dfd, win) -> {
            let bt0 = m0.cmBattle;
            let mQueued = withBattle(m0, MkBattleStateView {
                btInBattle: bt0.btInBattle, btSnap: bt0.btSnap,
                btCooldownSyncedMs: bt0.btCooldownSyncedMs, btActionLockUntilMs: bt0.btActionLockUntilMs,
                btPresentation: bt0.btPresentation, btPreEventSnap: bt0.btPreEventSnap,
                btActiveTimeline: bt0.btActiveTimeline, btTimelineElapsedMs: bt0.btTimelineElapsedMs,
                btAppliedHits: bt0.btAppliedHits, btNextTimelineId: bt0.btNextTimelineId,
                btQueue: listAppend(bt0.btQueue, [QSettlement(atk, dfd, win)]),
            });
            put(mQueued) *>>
            (if (mQueued.cmVp.vpDocHidden) drainImmediatelyM()
             else if (optIsSome(mQueued.cmBattle.btActiveTimeline)) modify(markDirty)
             else startNextBattleItemM())
        },
        SmActiveSkillFailure(reason) -> {
            let loc = m0.cmVp.vpLocale;
            let txt = match reason {
                FailNeedAp(req, cur) ->
                    if (isZh(loc)) "行动不足：需要 " + intToStr(req) + "，当前 " + intToStr(cur) + "。"
                    else "Need " + intToStr(req) + " AP.",
                FailNeedQi(req, cur) ->
                    trParams(loc, "error.not_enough_qi", [("required", intToStr(req)), ("current", intToStr(cur))]),
                FailCooldown(s) ->
                    if (isZh(loc)) "招式仍在冷却，还需 " + intToStr(s) + " 秒。"
                    else "On cooldown: " + intToStr(s) + "s.",
                FailMissingStatus(sts) ->
                    (if (isZh(loc)) "缺少前置状态：" else "Missing status: ") + strJoin(sts, "、"),
                FailUnavailable(sid) ->
                    (if (isZh(loc)) "当前无法施展：" else "Unavailable: ") + sid,
            };
            put(pushLog("error", txt, m0))
        },
        SmDialogue(who, txt) -> put(pushLog("dialogue", who + "：「" + txt + "」", m0)),
        SmStory(speaker, txt) -> {
            let pre = if (strLen(speaker) == 0) "" else "【" + speaker + "】";
            put(pushLog("story", pre + txt, m0))
        },
        SmStorySequence(active) -> {
            let wv0 = m0.cmWorld;
            put(markDirty(withWorld(m0, MkWorldView {
                wvRoomName: wv0.wvRoomName, wvRoomDesc: wv0.wvRoomDesc,
                wvRoomChars: wv0.wvRoomChars, wvRoomExits: wv0.wvRoomExits,
                wvMapOverview: wv0.wvMapOverview, wvMapCache: wv0.wvMapCache,
                wvRequestedInit: wv0.wvRequestedInit, wvStoryActive: active,
                wvStoryQueue: wv0.wvStoryQueue, wvStoryDelayRemMs: wv0.wvStoryDelayRemMs,
                wvTransitionBanner: wv0.wvTransitionBanner,
            })))
        },
        SmStoryDelay(ms) ->
            if (m0.cmVp.vpDocHidden || ms <= 0) pure(())
            else put(setWorldStoryQueue(m0, m0.cmWorld.wvStoryQueue, intToFloat(ms))),
        SmStoryTransition(txt, durMs) -> {
            let wv0 = m0.cmWorld;
            let m1 = withWorld(m0, MkWorldView {
                wvRoomName: wv0.wvRoomName, wvRoomDesc: wv0.wvRoomDesc,
                wvRoomChars: wv0.wvRoomChars, wvRoomExits: wv0.wvRoomExits,
                wvMapOverview: wv0.wvMapOverview, wvMapCache: wv0.wvMapCache,
                wvRequestedInit: wv0.wvRequestedInit, wvStoryActive: wv0.wvStoryActive,
                wvStoryQueue: wv0.wvStoryQueue, wvStoryDelayRemMs: wv0.wvStoryDelayRemMs,
                wvTransitionBanner: Some((txt, intToFloat(maxInt(800, durMs)))),
            });
            put(pushLog("story", "—— " + txt + " ——", m1))
        },
        SmSay(who, txt) -> put(pushLog("say", who + "：「" + txt + "」", m0)),
        SmUseItem(_, txt) -> put(pushLog("reward", txt, m0)),
        SmPlayerStats(st) -> {
            let bt0 = m0.cmBattle;
            let shouldExitBattle =
                st.psStatus != "in_battle"
                    && pageEq(m0.cmVp.vpPage, PageGame)
                    && optIsNone(bt0.btActiveTimeline)
                    && listIsEmpty(bt0.btQueue);
            let hs0 = m0.cmHero;
            let au0 = m0.cmAuth;
            let nowClock = m0.cmVp.vpClockMs;
            let (mergedBusy, nextBusySyncMs) = match (hs0.hsStats.psBusy, st.psBusy) {
                (Some(prevBi), Some(newBi))
                    if (prevBi.biAction == newBi.biAction
                        && prevBi.biTarget == newBi.biTarget
                        && prevBi.biCompleted == newBi.biCompleted) -> {
                    // Mid-step vitals update (e.g. Jing/Qi regeneration): keep the smooth 60fps step anchor untouched!
                    let bestName = if (strLen(newBi.biTargetName) > 0) newBi.biTargetName else prevBi.biTargetName;
                    (Some(MkBusyInfo {
                        biAction: newBi.biAction,
                        biTarget: newBi.biTarget,
                        biTargetName: bestName,
                        biCompleted: newBi.biCompleted,
                        biRemaining: newBi.biRemaining,
                        biSeconds: prevBi.biSeconds,
                        biStepSeconds: newBi.biStepSeconds,
                    }), hs0.hsBusySyncedAtMs)
                },
                (_, Some(newBi)) -> {
                    let stepSec = maxFloat(0.2, newBi.biStepSeconds);
                    let startSec = if (newBi.biSeconds >= stepSec - 0.18) stepSec else newBi.biSeconds;
                    (Some(MkBusyInfo {
                        biAction: newBi.biAction,
                        biTarget: newBi.biTarget,
                        biTargetName: newBi.biTargetName,
                        biCompleted: newBi.biCompleted,
                        biRemaining: newBi.biRemaining,
                        biSeconds: startSec,
                        biStepSeconds: stepSec,
                    }), nowClock)
                },
                (_, None) -> (None, nowClock),
            };
            let mergedStats = MkPlayerStatsInfo {
                psHp: st.psHp, psMaxHp: st.psMaxHp, psQi: st.psQi, psMaxQi: st.psMaxQi,
                psJing: st.psJing, psMaxJing: st.psMaxJing, psAp: st.psAp,
                psStatus: st.psStatus, psGender: st.psGender, psAppearance: st.psAppearance,
                psAppearanceText: st.psAppearanceText, psPortraitKey: st.psPortraitKey,
                psStrength: st.psStrength, psAgility: st.psAgility, psVitality: st.psVitality,
                psPotential: st.psPotential, psCombatExp: st.psCombatExp,
                psInjuredSeconds: st.psInjuredSeconds, psCombatInsight: st.psCombatInsight,
                psBusy: mergedBusy,
            };
            let m1 = markDirty(withBattle(
                withAuth(
                    withHero(m0, MkHeroSheets {
                        hsStats: mergedStats,
                        hsStatsSyncedAtMs: nowClock,
                        hsBusySyncedAtMs: nextBusySyncMs,
                        hsMoney: hs0.hsMoney,
                        hsInventory: hs0.hsInventory,
                        hsArts: hs0.hsArts,
                        hsQuests: hs0.hsQuests,
                    }),
                    MkAuthState {
                        auConnected: true, auConnecting: false,
                        auUsername: au0.auUsername, auLastError: au0.auLastError,
                        auLoginMode: au0.auLoginMode, auCreateStep: au0.auCreateStep,
                        auCreationCfg: au0.auCreationCfg, auCreateChoice: au0.auCreateChoice,
                        auDevReset: au0.auDevReset,
                    }
                ),
                MkBattleStateView {
                    btInBattle: if (shouldExitBattle) false else bt0.btInBattle,
                    btSnap: bt0.btSnap,
                    btCooldownSyncedMs: bt0.btCooldownSyncedMs,
                    btActionLockUntilMs: bt0.btActionLockUntilMs,
                    btPresentation: bt0.btPresentation,
                    btPreEventSnap: bt0.btPreEventSnap,
                    btActiveTimeline: bt0.btActiveTimeline,
                    btTimelineElapsedMs: bt0.btTimelineElapsedMs,
                    btAppliedHits: bt0.btAppliedHits,
                    btNextTimelineId: bt0.btNextTimelineId,
                    btQueue: bt0.btQueue,
                }
            ));
            put(m1)
        },
        SmInventory(money, items) -> {
            let hs0 = m0.cmHero;
            put(markDirty(withHero(m0, MkHeroSheets {
                hsStats: hs0.hsStats, hsStatsSyncedAtMs: hs0.hsStatsSyncedAtMs, hsBusySyncedAtMs: hs0.hsBusySyncedAtMs,
                hsMoney: money, hsInventory: items, hsArts: hs0.hsArts, hsQuests: hs0.hsQuests,
            })))
        },
        SmArts(arts) -> {
            let hs0 = m0.cmHero;
            put(markDirty(withHero(m0, MkHeroSheets {
                hsStats: hs0.hsStats, hsStatsSyncedAtMs: hs0.hsStatsSyncedAtMs, hsBusySyncedAtMs: hs0.hsBusySyncedAtMs,
                hsMoney: hs0.hsMoney, hsInventory: hs0.hsInventory, hsArts: arts, hsQuests: hs0.hsQuests,
            })))
        },
        SmQuests(qs) -> {
            let hs0 = m0.cmHero;
            put(markDirty(withHero(m0, MkHeroSheets {
                hsStats: hs0.hsStats, hsStatsSyncedAtMs: hs0.hsStatsSyncedAtMs, hsBusySyncedAtMs: hs0.hsBusySyncedAtMs,
                hsMoney: hs0.hsMoney, hsInventory: hs0.hsInventory, hsArts: hs0.hsArts, hsQuests: qs,
            })))
        },
        SmReward(rs) -> {
            let parts = listMap(rs, (r) -> r.rwName + " ×" + intToStr(r.rwAmount));
            let txt = (if (isZh(m0.cmVp.vpLocale)) "获得奖励：" else "Reward: ") + strJoin(parts, "、");
            put(pushLog("reward", txt, m0))
        },
        SmSystem(code, params) ->
            put(pushLog("system", formatSystemMsg(m0.cmVp.vpLocale, code, params), m0)),
        SmError(code, params) -> {
            let txt = formatErrorMsg(m0.cmVp.vpLocale, code, params);
            let au0 = m0.cmAuth;
            let m1 = withAuth(m0, MkAuthState {
                auConnected: au0.auConnected, auConnecting: false,
                auUsername: au0.auUsername, auLastError: Some(txt),
                auLoginMode: au0.auLoginMode, auCreateStep: au0.auCreateStep,
                auCreationCfg: au0.auCreationCfg, auCreateChoice: au0.auCreateChoice,
                auDevReset: au0.auDevReset,
            });
            put(pushLog("error", txt, m1))
        },
        SmIgnored(_) -> pure(()),
    }

def drainStoryQueueM(): ClientM Void =
    get() >>= (m0) ->
    match m0.cmWorld.wvStoryQueue {
        Nil -> put(setWorldStoryQueue(m0, Nil, 0.0)),
        Cons(sm, rest) -> {
            put(setWorldStoryQueue(m0, rest, 0.0)) *>>
            (match sm {
                SmStoryDelay(_) -> pure(()),
                _ -> applyServerMessageNowM(sm),
            }) *>>
            drainStoryQueueM()
        },
    }

def popStoryQueueLoopM(): ClientM Void =
    get() >>= (m) ->
    match m.cmWorld.wvStoryQueue {
        Nil -> pure(()),
        Cons(SmStoryDelay(ms), rest) ->
            if (ms > 0) put(setWorldStoryQueue(m, rest, intToFloat(ms)))
            else put(setWorldStoryQueue(m, rest, 0.0)) *>> popStoryQueueLoopM(),
        Cons(sm, rest) ->
            put(setWorldStoryQueue(m, rest, 0.0)) *>>
            applyServerMessageNowM(sm) *>>
            get() >>= (mAfter) ->
            if (mAfter.cmWorld.wvStoryDelayRemMs > 0.0) pure(())
            else popStoryQueueLoopM(),
    }

def stepStoryQueueM(dtMs: Float): ClientM Void =
    get() >>= (m0) ->
    let rem = m0.cmWorld.wvStoryDelayRemMs in
    if (rem <= 0.0 && listIsEmpty(m0.cmWorld.wvStoryQueue)) pure(())
    else if (rem > dtMs) put(setWorldStoryQueue(m0, m0.cmWorld.wvStoryQueue, rem - dtMs))
    else put(setWorldStoryQueue(m0, m0.cmWorld.wvStoryQueue, 0.0)) *>> popStoryQueueLoopM()

pub def applyServerMessage(msg: ServerMsg, m0: ClientModel): (ClientModel, List ClientCmd) =
    if (!m0.cmVp.vpDocHidden
        && isStorySequencedMsg(msg)
        && (m0.cmWorld.wvStoryDelayRemMs > 0.0 || !listIsEmpty(m0.cmWorld.wvStoryQueue))) {
        (setWorldStoryQueue(m0, listAppend(m0.cmWorld.wvStoryQueue, [msg]), m0.cmWorld.wvStoryDelayRemMs), Nil)
    } else {
        runClientM(applyServerMessageNowM(msg), m0)
    }

pub def setDocumentHidden(hidden: Bool, m0: ClientModel): ClientModel = {
    let vp0 = m0.cmVp;
    let m1 = markDirty(withVp(m0, MkViewportState {
        vpPage: vp0.vpPage, vpLocale: vp0.vpLocale, vpReducedMotion: vp0.vpReducedMotion,
        vpDocHidden: hidden, vpSoundOn: vp0.vpSoundOn, vpLookStyle: vp0.vpLookStyle,
        vpWidth: vp0.vpWidth, vpHeight: vp0.vpHeight, vpClockMs: vp0.vpClockMs,
        vpLastSyncTickMs: vp0.vpLastSyncTickMs, vpWasmStepMs: vp0.vpWasmStepMs, vpDrawCmdCount: vp0.vpDrawCmdCount,
    }));
    if (hidden) {
        let (m2, _) = runClientM(drainStoryQueueM() *>> drainImmediatelyM(), m1);
        m2
    } else m1
}

// ============================================================================
// Per-Frame Simulation Step (`stepClientFrame`)
// ============================================================================

def stepBattleTimelineM(stepMs: Float): ClientM Void =
    get() >>= (m0) ->
    let bt0 = m0.cmBattle in
    match bt0.btActiveTimeline {
        None -> pure(()),
        Some(tl) -> {
            let nextElapsed = bt0.btTimelineElapsedMs + stepMs;
            let clamped = minFloat(tl.tlDurationMs, nextElapsed);
            put(withBattle(m0, MkBattleStateView {
                btInBattle: bt0.btInBattle, btSnap: bt0.btSnap,
                btCooldownSyncedMs: bt0.btCooldownSyncedMs, btActionLockUntilMs: bt0.btActionLockUntilMs,
                btPresentation: bt0.btPresentation, btPreEventSnap: bt0.btPreEventSnap,
                btActiveTimeline: bt0.btActiveTimeline, btTimelineElapsedMs: clamped,
                btAppliedHits: bt0.btAppliedHits, btNextTimelineId: bt0.btNextTimelineId,
                btQueue: bt0.btQueue,
            })) *>>
            commitHitsUpToM(clamped) *>>
            (if (nextElapsed < tl.tlDurationMs) pure(())
             else if (tl.tlKind == "settlement") {
                 get() >>= (m1) -> {
                     let bt1 = m1.cmBattle;
                     let mDone = markDirty(withBattle(m1, MkBattleStateView {
                         btInBattle: false, btSnap: None,
                         btCooldownSyncedMs: bt1.btCooldownSyncedMs, btActionLockUntilMs: bt1.btActionLockUntilMs,
                         btPresentation: None, btPreEventSnap: bt1.btPreEventSnap,
                         btActiveTimeline: None, btTimelineElapsedMs: 0.0,
                         btAppliedHits: bt1.btAppliedHits, btNextTimelineId: bt1.btNextTimelineId,
                         btQueue: bt1.btQueue,
                     }));
                     put(mDone) *>>
                     whenM(pageEq(mDone.cmVp.vpPage, PageGame), () ->
                         emitCmd(CmdSendWs(encodePlayerAction(ActOther("view"))))
                     )
                 }
             } else {
                 get() >>= (m1) -> {
                     let bt1 = m1.cmBattle;
                     put(withBattle(m1, MkBattleStateView {
                         btInBattle: bt1.btInBattle, btSnap: bt1.btSnap,
                         btCooldownSyncedMs: bt1.btCooldownSyncedMs, btActionLockUntilMs: bt1.btActionLockUntilMs,
                         btPresentation: bt1.btPresentation, btPreEventSnap: bt1.btPreEventSnap,
                         btActiveTimeline: None, btTimelineElapsedMs: 0.0,
                         btAppliedHits: bt1.btAppliedHits, btNextTimelineId: bt1.btNextTimelineId,
                         btQueue: bt1.btQueue,
                     })) *>>
                     startNextBattleItemM()
                 }
             })
        },
    }

pub def stepClientFrame(rawDtMs: Float, rawW: Float, rawH: Float, m0: ClientModel): (ClientModel, List ClientCmd) = {
    let dtSec = clampFloat(0.001, 0.25, rawDtMs / 1000.0);
    let dtMs = dtSec * 1000.0;
    let w = maxFloat(320.0, rawW);
    let h = maxFloat(220.0, rawH);
    let vp0 = m0.cmVp;
    let nowMs = vp0.vpClockMs + dtMs;

    let camAlpha = if (vp0.vpReducedMotion) 1.0 else 1.0 - exp(-14.0 * dtSec);

    let mInit = withVp(m0, MkViewportState {
        vpPage: vp0.vpPage, vpLocale: vp0.vpLocale, vpReducedMotion: vp0.vpReducedMotion,
        vpDocHidden: vp0.vpDocHidden, vpSoundOn: vp0.vpSoundOn, vpLookStyle: vp0.vpLookStyle,
        vpWidth: w, vpHeight: h, vpClockMs: nowMs,
        vpLastSyncTickMs: vp0.vpLastSyncTickMs, vpWasmStepMs: vp0.vpWasmStepMs, vpDrawCmdCount: vp0.vpDrawCmdCount,
    });

    let effDtMs = if (mInit.cmLab.labPaused) 0.0 else dtMs * mInit.cmLab.labSpeed;
    let (mAfterTl, cmds) = runClientM(stepStoryQueueM(dtMs) *>> stepBattleTimelineM(effDtMs), mInit);

    let pCurRatio = match (mAfterTl.cmBattle.btPresentation, mAfterTl.cmBattle.btSnap) {
        (Some(pr), Some(bs)) -> intToFloat(pr.prPlayerHp) / intToFloat(maxInt(1, bs.bsPlayer.cbMaxHp)),
        _ -> intToFloat(mAfterTl.cmHero.hsStats.psHp) / intToFloat(maxInt(1, mAfterTl.cmHero.hsStats.psMaxHp)),
    };
    let eCurRatio = match (mAfterTl.cmBattle.btPresentation, mAfterTl.cmBattle.btSnap) {
        (Some(pr), Some(bs)) -> intToFloat(pr.prEnemyHp) / intToFloat(maxInt(1, bs.bsEnemy.cbMaxHp)),
        _ -> 1.0,
    };
    let stepTrail = (cur: Float, tgt: Float) -> if (cur > tgt) maxFloat(tgt, cur - dtSec * 0.42) else tgt;
    let fxA = mAfterTl.cmFx;
    let pTrail1 = stepTrail(fxA.fxPlayerHpTrail, pCurRatio);
    let eTrail1 = stepTrail(fxA.fxEnemyHpTrail, eCurRatio);

    let (pAgi, eAgi) = match mAfterTl.cmBattle.btSnap {
        Some(bs) -> (intToFloat(bs.bsPlayer.cbAgility), intToFloat(bs.bsEnemy.cbAgility)),
        None -> (intToFloat(mAfterTl.cmHero.hsStats.psAgility), apBaselineAgility()),
    };
    let canGrowAp =
        mAfterTl.cmBattle.btInBattle
            && !mAfterTl.cmLab.labPaused
            && optIsNone(mAfterTl.cmBattle.btActiveTimeline)
            && nowMs >= mAfterTl.cmBattle.btActionLockUntilMs;
    let stepAp = (cur: Float, agi: Float) ->
        if (canGrowAp) {
            if (cur >= 99.9) 100.0
            else minFloat(99.0, cur + maxFloat(1.0, agi) * apGainPerAgilitySecond() * dtSec)
        } else cur;
    let pAp1 = stepAp(fxA.fxPlayerApAnim, pAgi);
    let eAp1 = stepAp(fxA.fxEnemyApAnim, eAgi);

    let pFlash1 = maxFloat(0.0, fxA.fxPlayerHitFlashMs - dtMs);
    let eFlash1 = maxFloat(0.0, fxA.fxEnemyHitFlashMs - dtMs);
    let flashEnded =
        (fxA.fxPlayerHitFlashMs > 0.0 && pFlash1 <= 0.0)
            || (fxA.fxEnemyHitFlashMs > 0.0 && eFlash1 <= 0.0);

    let wvA = mAfterTl.cmWorld;
    let nextBanner = match wvA.wvTransitionBanner {
        None -> None,
        Some((txt, remMs)) -> {
            let rNext = remMs - dtMs;
            if (rNext <= 0.0) None else Some((txt, rNext))
        },
    };
    let bannerChanged = optIsSome(wvA.wvTransitionBanner) != optIsSome(nextBanner);

    let liveParts = listFilter(
        listMap(fxA.fxParticles, (p) -> MkInkParticle {
            ipX: p.ipX + p.ipVx * dtSec,
            ipY: p.ipY + p.ipVy * dtSec,
            ipVx: p.ipVx * (1.0 - 3.2 * dtSec),
            ipVy: p.ipVy + 340.0 * dtSec,
            ipRadius: p.ipRadius,
            ipLife: p.ipLife + dtSec,
            ipMaxLife: p.ipMaxLife,
            ipColor: p.ipColor,
        }),
        (p) -> p.ipLife < p.ipMaxLife
    );

    let hasLiveTimers =
        mAfterTl.cmBattle.btInBattle
            || optIsSome(mAfterTl.cmHero.hsStats.psBusy)
            || mAfterTl.cmHero.hsStats.psInjuredSeconds > 0;
    let syncIntervalMs =
        if (optIsSome(mAfterTl.cmHero.hsStats.psBusy)) 16.0
        else if (mAfterTl.cmBattle.btInBattle) 80.0
        else 180.0;
    let vpA = mAfterTl.cmVp;
    let tickSyncDue = hasLiveTimers && (nowMs - vpA.vpLastSyncTickMs >= syncIntervalMs);
    let nextSyncTick = if (tickSyncDue) nowMs else vpA.vpLastSyncTickMs;

    let cA = mAfterTl.cmCam;
    let cx1 = cA.camX + (cA.targetCamX - cA.camX) * camAlpha;
    let cy1 = cA.camY + (cA.targetCamY - cA.camY) * camAlpha;
    let camMoving = absFloat(cA.targetCamX - cx1) > 0.05 || absFloat(cA.targetCamY - cy1) > 0.05;
    let mOut = withFx(
        withWorld(
            withCam(
                withVp(mAfterTl, MkViewportState {
                    vpPage: vpA.vpPage, vpLocale: vpA.vpLocale, vpReducedMotion: vpA.vpReducedMotion,
                    vpDocHidden: vpA.vpDocHidden, vpSoundOn: vpA.vpSoundOn, vpLookStyle: vpA.vpLookStyle,
                    vpWidth: vpA.vpWidth, vpHeight: vpA.vpHeight, vpClockMs: vpA.vpClockMs,
                    vpLastSyncTickMs: nextSyncTick, vpWasmStepMs: vpA.vpWasmStepMs, vpDrawCmdCount: vpA.vpDrawCmdCount,
                }),
                MkCameraState {
                    camX: cx1, camY: cy1,
                    targetCamX: cA.targetCamX, targetCamY: cA.targetCamY,
                    panX: cA.panX, panY: cA.panY, mapZoom: cA.mapZoom,
                }
            ),
            MkWorldView {
                wvRoomName: wvA.wvRoomName, wvRoomDesc: wvA.wvRoomDesc,
                wvRoomChars: wvA.wvRoomChars, wvRoomExits: wvA.wvRoomExits,
                wvMapOverview: wvA.wvMapOverview, wvMapCache: wvA.wvMapCache,
                wvRequestedInit: wvA.wvRequestedInit, wvStoryActive: wvA.wvStoryActive,
                wvStoryQueue: wvA.wvStoryQueue, wvStoryDelayRemMs: wvA.wvStoryDelayRemMs,
                wvTransitionBanner: nextBanner,
            }
        ),
        MkBattleFxState {
            fxPlayerHpTrail: pTrail1, fxEnemyHpTrail: eTrail1,
            fxPlayerApAnim: pAp1, fxEnemyApAnim: eAp1,
            fxPlayerHitFlashMs: pFlash1, fxEnemyHitFlashMs: eFlash1,
            fxParticles: liveParts,
            fxShockPos: fxA.fxShockPos,
            fxShockAge: minFloat(99.0, fxA.fxShockAge + dtSec),
            fxShockPower: fxA.fxShockPower,
        }
    );

    let finalM = if (bannerChanged || flashEnded || tickSyncDue || camMoving) markDirty(mOut) else mOut;
    (finalM, cmds)
}

// ============================================================================
// Pointer, Scroll, IME, Keyboard & Camera Controls
// ============================================================================

pub def isCameraPanned(m: ClientModel): Bool = {
    let c = m.cmCam;
    absFloat(c.panX) > 6.0 || absFloat(c.panY) > 6.0 || absFloat(c.mapZoom - 1.0) > 0.04
}

pub def panCameraBy(dx: Float, dy: Float, m: ClientModel): ClientModel =
    if (m.cmBattle.btInBattle || !pageEq(m.cmVp.vpPage, PageGame)) m
    else {
        let c = m.cmCam;
        let m1 = withCam(m, MkCameraState {
            camX: c.camX, camY: c.camY,
            targetCamX: c.targetCamX, targetCamY: c.targetCamY,
            panX: clampFloat(-900.0, 900.0, c.panX + dx),
            panY: clampFloat(-700.0, 700.0, c.panY + dy),
            mapZoom: c.mapZoom,
        });
        if (isCameraPanned(m1) != isCameraPanned(m)) markDirty(m1) else m1
    }

pub def zoomCameraBy(factor: Float, m: ClientModel): ClientModel =
    if (m.cmBattle.btInBattle || !pageEq(m.cmVp.vpPage, PageGame)) m
    else {
        let c = m.cmCam;
        let m1 = withCam(m, MkCameraState {
            camX: c.camX, camY: c.camY,
            targetCamX: c.targetCamX, targetCamY: c.targetCamY,
            panX: c.panX, panY: c.panY,
            mapZoom: clampFloat(0.58, 1.75, c.mapZoom * factor),
        });
        if (isCameraPanned(m1) != isCameraPanned(m)) markDirty(m1) else m1
    }

pub def resetCameraPan(m: ClientModel): ClientModel = {
    let c = m.cmCam;
    markDirty(withCam(m, MkCameraState {
        camX: c.camX, camY: c.camY,
        targetCamX: c.targetCamX, targetCamY: c.targetCamY,
        panX: 0.0, panY: 0.0, mapZoom: 1.0,
    }))
}

def findHit(x: Float, y: Float, hbs: List CanvasHitbox): Option CanvasHitbox =
    listFind(listRev(hbs), (hb) ->
        x >= hb.chX && x <= hb.chX + hb.chW && y >= hb.chY && y <= hb.chY + hb.chH
    )

def findScrollZone(x: Float, y: Float, szs: List ScrollZone): Option ScrollTarget =
    match listFind(listRev(szs), (sz) ->
        x >= sz.szX && x <= sz.szX + sz.szW && y >= sz.szY && y <= sz.szY + sz.szH
    ) {
        Some(sz) -> Some(sz.szTarget),
        None -> None,
    }

pub def handlePointerMove(x: Float, y: Float, m: ClientModel): (ClientModel, List ClientCmd) = {
    let mHit = findHit(x, y, m.cmScroll.shHitboxes);
    let nextTarget = match mHit { Some(hb) -> Some(hb.chTarget), None -> None };
    let cursor = match mHit { Some(hb) -> hb.chCursor, None -> "default" };
    let sh = m.cmScroll;
    let changed = !optHitEq(nextTarget, sh.shHovered);
    let m1 = withScroll(m, MkScrollHitState {
        shLogScroll: sh.shLogScroll, shLogMaxScroll: sh.shLogMaxScroll, shLogStickBottom: sh.shLogStickBottom,
        shDrawerScroll: sh.shDrawerScroll, shDrawerMaxScroll: sh.shDrawerMaxScroll,
        shOnboardScroll: sh.shOnboardScroll, shOnboardMaxScroll: sh.shOnboardMaxScroll,
        shNpcScroll: sh.shNpcScroll, shNpcMaxScroll: sh.shNpcMaxScroll,
        shHovered: nextTarget, shHitboxes: sh.shHitboxes, shScrollZones: sh.shScrollZones,
    });
    (m1, if (changed) [CmdSetCursor(cursor)] else Nil)
}

def setFocusedInput(m: ClientModel, fOpt: Option String): ClientModel = {
    let u = m.cmUi;
    withUi(m, MkUiChrome {
        uiLogs: u.uiLogs, uiNextLogId: u.uiNextLogId, uiUnreadLogs: u.uiUnreadLogs,
        uiDesktopDrawer: u.uiDesktopDrawer, uiCharSubTab: u.uiCharSubTab, uiMobileTab: u.uiMobileTab,
        uiSelectedNpc: u.uiSelectedNpc, uiFocusedInput: fOpt, uiSayDraft: u.uiSayDraft,
        uiDirty: u.uiDirty,
    })
}

def optStrEq(a: Option String, b: Option String): Bool = match (a, b) {
    (None, None) -> true,
    (Some(x), Some(y)) -> x == y,
    _ -> false,
}

def blurIfOther(m0: ClientModel, targetInput: Option String): (ClientModel, List ClientCmd) =
    if (!optStrEq(m0.cmUi.uiFocusedInput, targetInput) && optIsSome(m0.cmUi.uiFocusedInput)) {
        (setFocusedInput(m0, None), [CmdBlurInput])
    } else (m0, Nil)

pub def handlePointerClick(x: Float, y: Float, m0: ClientModel): (ClientModel, List ClientCmd) =
    match findHit(x, y, m0.cmScroll.shHitboxes) {
        None ->
            if (optIsSome(m0.cmUi.uiFocusedInput)) (setFocusedInput(m0, None), [CmdBlurInput])
            else (m0, Nil),
        Some(hb) -> match hb.chTarget {
            HitSwallow -> blurIfOther(m0, None),
            HitFocusInput(inpId) -> {
                let curVal = if (inpId == "login") m0.cmAuth.auUsername else m0.cmUi.uiSayDraft;
                (
                    setFocusedInput(m0, Some(inpId)),
                    [CmdFocusInput(inpId, curVal, hb.chX, hb.chY, hb.chW, hb.chH)]
                )
            },
            HitExit(dir) -> {
                let (m1, bc) = blurIfOther(m0, None);
                if (m1.cmAuth.auConnected && !m1.cmWorld.wvStoryActive) {
                    (m1, listAppend(bc, [CmdSendWs(encodePlayerAction(ActGo(dir)))]))
                } else (m1, bc)
            },
            HitNpc(cid) -> {
                let (m1, bc) = blurIfOther(m0, None);
                let nextSel = if (optStrEq(m1.cmUi.uiSelectedNpc, Some(cid))) None else Some(cid);
                let u = m1.cmUi;
                let sh = m1.cmScroll;
                let m2 = withScroll(
                    withUi(m1, MkUiChrome {
                        uiLogs: u.uiLogs, uiNextLogId: u.uiNextLogId, uiUnreadLogs: u.uiUnreadLogs,
                        uiDesktopDrawer: u.uiDesktopDrawer, uiCharSubTab: u.uiCharSubTab, uiMobileTab: u.uiMobileTab,
                        uiSelectedNpc: nextSel, uiFocusedInput: u.uiFocusedInput, uiSayDraft: u.uiSayDraft,
                        uiDirty: true,
                    }),
                    MkScrollHitState {
                        shLogScroll: sh.shLogScroll, shLogMaxScroll: sh.shLogMaxScroll, shLogStickBottom: sh.shLogStickBottom,
                        shDrawerScroll: sh.shDrawerScroll, shDrawerMaxScroll: sh.shDrawerMaxScroll,
                        shOnboardScroll: sh.shOnboardScroll, shOnboardMaxScroll: sh.shOnboardMaxScroll,
                        shNpcScroll: 0.0, shNpcMaxScroll: sh.shNpcMaxScroll,
                        shHovered: sh.shHovered, shHitboxes: sh.shHitboxes, shScrollZones: sh.shScrollZones,
                    }
                );
                (m2, bc)
            },
            HitResetCam -> {
                let (m1, bc) = blurIfOther(m0, None);
                (resetCameraPan(m1), bc)
            },
            HitUi(k, a1, a2) -> {
                let (m1, bc) = blurIfOther(m0, None);
                let (m2, ucs) = handleUiAction(k, a1, a2, m1);
                (m2, listAppend(bc, ucs))
            },
            HitLab(cmd, a1, a2, a3, num) -> {
                let (m1, bc) = blurIfOther(m0, None);
                let (m2, lcs) = handleLabCommand(cmd, a1, a2, a3, num, m1);
                (m2, listAppend(bc, lcs))
            },
            HitLabScrub(x0, w0) -> {
                let (m1, bc) = blurIfOther(m0, None);
                let ratio = clamp01((x - x0) / maxFloat(1.0, w0));
                let dur = match m1.cmBattle.btActiveTimeline { Some(tl) -> tl.tlDurationMs, None -> 0.0 };
                let (m2, l1) = handleLabCommand("pause", "true", "", "", 0.0, m1);
                let (m3, l2) = handleLabCommand("seek", "", "", "", ratio * dur, m2);
                (m3, listAppend(bc, listAppend(l1, l2)))
            },
        },
    }

def applyScrollDelta(tgt: ScrollTarget, deltaY: Float, m: ClientModel): ClientModel = {
    let sh = m.cmScroll;
    match tgt {
        ScrollLog -> {
            let maxS = sh.shLogMaxScroll;
            let cur = if (sh.shLogStickBottom) maxS else sh.shLogScroll;
            let next = clampFloat(0.0, maxS, cur + deltaY);
            let stick = maxS <= 1.0 || (maxS - next) <= 22.0;
            withScroll(m, MkScrollHitState {
                shLogScroll: next, shLogMaxScroll: maxS, shLogStickBottom: stick,
                shDrawerScroll: sh.shDrawerScroll, shDrawerMaxScroll: sh.shDrawerMaxScroll,
                shOnboardScroll: sh.shOnboardScroll, shOnboardMaxScroll: sh.shOnboardMaxScroll,
                shNpcScroll: sh.shNpcScroll, shNpcMaxScroll: sh.shNpcMaxScroll,
                shHovered: sh.shHovered, shHitboxes: sh.shHitboxes, shScrollZones: sh.shScrollZones,
            })
        },
        ScrollDrawer -> {
            let next = clampFloat(0.0, sh.shDrawerMaxScroll, sh.shDrawerScroll + deltaY);
            withScroll(m, MkScrollHitState {
                shLogScroll: sh.shLogScroll, shLogMaxScroll: sh.shLogMaxScroll, shLogStickBottom: sh.shLogStickBottom,
                shDrawerScroll: next, shDrawerMaxScroll: sh.shDrawerMaxScroll,
                shOnboardScroll: sh.shOnboardScroll, shOnboardMaxScroll: sh.shOnboardMaxScroll,
                shNpcScroll: sh.shNpcScroll, shNpcMaxScroll: sh.shNpcMaxScroll,
                shHovered: sh.shHovered, shHitboxes: sh.shHitboxes, shScrollZones: sh.shScrollZones,
            })
        },
        ScrollOnboard -> {
            let next = clampFloat(0.0, sh.shOnboardMaxScroll, sh.shOnboardScroll + deltaY);
            withScroll(m, MkScrollHitState {
                shLogScroll: sh.shLogScroll, shLogMaxScroll: sh.shLogMaxScroll, shLogStickBottom: sh.shLogStickBottom,
                shDrawerScroll: sh.shDrawerScroll, shDrawerMaxScroll: sh.shDrawerMaxScroll,
                shOnboardScroll: next, shOnboardMaxScroll: sh.shOnboardMaxScroll,
                shNpcScroll: sh.shNpcScroll, shNpcMaxScroll: sh.shNpcMaxScroll,
                shHovered: sh.shHovered, shHitboxes: sh.shHitboxes, shScrollZones: sh.shScrollZones,
            })
        },
        ScrollNpc -> {
            let next = clampFloat(0.0, sh.shNpcMaxScroll, sh.shNpcScroll + deltaY);
            withScroll(m, MkScrollHitState {
                shLogScroll: sh.shLogScroll, shLogMaxScroll: sh.shLogMaxScroll, shLogStickBottom: sh.shLogStickBottom,
                shDrawerScroll: sh.shDrawerScroll, shDrawerMaxScroll: sh.shDrawerMaxScroll,
                shOnboardScroll: sh.shOnboardScroll, shOnboardMaxScroll: sh.shOnboardMaxScroll,
                shNpcScroll: next, shNpcMaxScroll: sh.shNpcMaxScroll,
                shHovered: sh.shHovered, shHitboxes: sh.shHitboxes, shScrollZones: sh.shScrollZones,
            })
        },
    }
}

pub def handleScrollAt(x: Float, y: Float, deltaY: Float, m: ClientModel): ClientModel =
    match findScrollZone(x, y, m.cmScroll.shScrollZones) {
        Some(tgt) -> applyScrollDelta(tgt, deltaY, m),
        None -> zoomCameraBy(if (deltaY < 0.0) 1.09 else 0.92, m),
    }

pub def handleDragAt(x: Float, y: Float, dx: Float, dy: Float, m: ClientModel): ClientModel =
    match findHit(x, y, m.cmScroll.shHitboxes) {
        Some(hb) -> match hb.chTarget {
            HitLabScrub(x0, w0) -> {
                let ratio = clamp01((x - x0) / maxFloat(1.0, w0));
                let dur = match m.cmBattle.btActiveTimeline { Some(tl) -> tl.tlDurationMs, None -> 0.0 };
                let (m1, _) = handleLabCommand("pause", "true", "", "", 0.0, m);
                let (m2, _) = handleLabCommand("seek", "", "", "", ratio * dur, m1);
                m2
            },
            _ -> match findScrollZone(x, y, m.cmScroll.shScrollZones) {
                Some(tgt) -> applyScrollDelta(tgt, -dy, m),
                None -> panCameraBy(dx, dy, m),
            },
        },
        None -> match findScrollZone(x, y, m.cmScroll.shScrollZones) {
            Some(tgt) -> applyScrollDelta(tgt, -dy, m),
            None -> panCameraBy(dx, dy, m),
        },
    }

pub def handleTextInput(inpId: String, val: String, m: ClientModel): ClientModel =
    if (inpId == "login") {
        let au = m.cmAuth;
        withAuth(m, MkAuthState {
            auConnected: au.auConnected, auConnecting: au.auConnecting,
            auUsername: val, auLastError: au.auLastError,
            auLoginMode: au.auLoginMode, auCreateStep: au.auCreateStep,
            auCreationCfg: au.auCreationCfg, auCreateChoice: au.auCreateChoice,
            auDevReset: au.auDevReset,
        })
    } else if (inpId == "say") {
        let u = m.cmUi;
        withUi(m, MkUiChrome {
            uiLogs: u.uiLogs, uiNextLogId: u.uiNextLogId, uiUnreadLogs: u.uiUnreadLogs,
            uiDesktopDrawer: u.uiDesktopDrawer, uiCharSubTab: u.uiCharSubTab, uiMobileTab: u.uiMobileTab,
            uiSelectedNpc: u.uiSelectedNpc, uiFocusedInput: u.uiFocusedInput, uiSayDraft: val,
            uiDirty: u.uiDirty,
        })
    } else m

pub def handleTextSubmit(inpId: String, m0: ClientModel): (ClientModel, List ClientCmd) =
    if (inpId == "login") {
        let m1 = setFocusedInput(m0, None);
        if (m1.cmAuth.auLoginMode == "create") {
            let (m2, cs) = handleUiAction("create_step", "1", "", m1);
            (m2, Cons(CmdBlurInput, cs))
        } else {
            let passFlag = if (m1.cmAuth.auDevReset) "reset" else "";
            let (m2, cs) = handleUiAction("login_submit", m1.cmAuth.auUsername, passFlag, m1);
            (m2, Cons(CmdBlurInput, cs))
        }
    } else if (inpId == "say") {
        let txt = utf8Trim(m0.cmUi.uiSayDraft);
        let u = m0.cmUi;
        let sh = m0.cmScroll;
        let m1 = withScroll(
            withUi(m0, MkUiChrome {
                uiLogs: u.uiLogs, uiNextLogId: u.uiNextLogId, uiUnreadLogs: u.uiUnreadLogs,
                uiDesktopDrawer: u.uiDesktopDrawer, uiCharSubTab: u.uiCharSubTab, uiMobileTab: u.uiMobileTab,
                uiSelectedNpc: u.uiSelectedNpc, uiFocusedInput: None, uiSayDraft: "",
                uiDirty: u.uiDirty,
            }),
            MkScrollHitState {
                shLogScroll: sh.shLogScroll, shLogMaxScroll: sh.shLogMaxScroll, shLogStickBottom: true,
                shDrawerScroll: sh.shDrawerScroll, shDrawerMaxScroll: sh.shDrawerMaxScroll,
                shOnboardScroll: sh.shOnboardScroll, shOnboardMaxScroll: sh.shOnboardMaxScroll,
                shNpcScroll: sh.shNpcScroll, shNpcMaxScroll: sh.shNpcMaxScroll,
                shHovered: sh.shHovered, shHitboxes: sh.shHitboxes, shScrollZones: sh.shScrollZones,
            }
        );
        if (strLen(txt) == 0) (m1, [CmdBlurInput])
        else (m1, [CmdBlurInput, CmdSendWs(encodePlayerAction(ActSay(txt)))])
    } else (m0, Nil)

pub def handleFocusInputId(inpId: String, m: ClientModel): ClientModel =
    setFocusedInput(m, if (strLen(inpId) == 0) None else Some(inpId))

pub def handleBlurInput(m: ClientModel): ClientModel =
    setFocusedInput(m, None)

pub def handleKeyDown(key: String, m0: ClientModel): (ClientModel, List ClientCmd) =
    if (optIsSome(m0.cmUi.uiFocusedInput)) {
        if (key == "Escape") (setFocusedInput(m0, None), [CmdBlurInput])
        else (m0, Nil)
    } else if (key == "Escape") {
        let u = m0.cmUi;
        (withUi(m0, MkUiChrome {
            uiLogs: u.uiLogs, uiNextLogId: u.uiNextLogId, uiUnreadLogs: u.uiUnreadLogs,
            uiDesktopDrawer: "", uiCharSubTab: u.uiCharSubTab, uiMobileTab: u.uiMobileTab,
            uiSelectedNpc: None, uiFocusedInput: u.uiFocusedInput, uiSayDraft: u.uiSayDraft,
            uiDirty: true,
        }), Nil)
    } else if (m0.cmBattle.btInBattle) {
        match key {
            "1" -> handleUiAction("perform_index", "0", "", m0),
            "2" -> handleUiAction("perform_index", "1", "", m0),
            "3" -> handleUiAction("perform_index", "2", "", m0),
            "4" -> handleUiAction("perform_index", "3", "", m0),
            "5" -> handleUiAction("perform_index", "4", "", m0),
            "6" -> handleUiAction("perform_index", "5", "", m0),
            _ -> (m0, Nil),
        }
    } else if (m0.cmAuth.auConnected
               && !m0.cmWorld.wvStoryActive
               && strLen(m0.cmUi.uiDesktopDrawer) == 0
               && optIsNone(m0.cmUi.uiSelectedNpc)) {
        let mDir = match key {
            "ArrowUp" -> Some(North),
            "w" -> Some(North),
            "W" -> Some(North),
            "ArrowDown" -> Some(South),
            "s" -> Some(South),
            "S" -> Some(South),
            "ArrowLeft" -> Some(West),
            "a" -> Some(West),
            "A" -> Some(West),
            "ArrowRight" -> Some(East),
            "d" -> Some(East),
            "D" -> Some(East),
            _ -> None,
        };
        match mDir {
            Some(dir) ->
                if (optIsSome(listFind(m0.cmWorld.wvRoomExits, (ex) -> dirEq(ex.reDirection, dir)))) {
                    (m0, [CmdSendWs(encodePlayerAction(ActGo(dir)))])
                } else (m0, Nil),
            None -> (m0, Nil),
        }
    } else (m0, Nil)

// ============================================================================
// UI Action Dispatcher & BattleLab / Playwright Fixtures
// ============================================================================

pub def labActionOrder(m: ClientModel): List String =
    listFilter(m.cmCatalog.acOrder, (aid) ->
        match mapLookup(m.cmCatalog.acActions, aid) {
            Some(act) ->
                isTravelMotion(act.adActorMotion)
                    || act.adActorMotion == "focus"
                    || strStartsWith(aid, "rig.effect."),
            None -> false,
        }
    )

pub def handleUiAction(kind: String, a1: String, a2: String, m0: ClientModel): (ClientModel, List ClientCmd) =
    match kind {
        "reset_cam" -> (resetCameraPan(m0), Nil),
        "zoom_in" -> (zoomCameraBy(1.18, m0), Nil),
        "zoom_out" -> (zoomCameraBy(0.85, m0), Nil),
        "close_all" -> {
            let u = m0.cmUi;
            (withUi(m0, MkUiChrome {
                uiLogs: u.uiLogs, uiNextLogId: u.uiNextLogId, uiUnreadLogs: u.uiUnreadLogs,
                uiDesktopDrawer: "", uiCharSubTab: u.uiCharSubTab, uiMobileTab: u.uiMobileTab,
                uiSelectedNpc: None, uiFocusedInput: u.uiFocusedInput, uiSayDraft: u.uiSayDraft,
                uiDirty: true,
            }), Nil)
        },
        "toggle_dev_reset" -> {
            let au = m0.cmAuth;
            (markDirty(withAuth(m0, MkAuthState {
                auConnected: au.auConnected, auConnecting: au.auConnecting,
                auUsername: au.auUsername, auLastError: au.auLastError,
                auLoginMode: au.auLoginMode, auCreateStep: au.auCreateStep,
                auCreationCfg: au.auCreationCfg, auCreateChoice: au.auCreateChoice,
                auDevReset: !au.auDevReset,
            })), Nil)
        },
        "scroll_log_bottom" -> {
            let sh = m0.cmScroll;
            (withScroll(m0, MkScrollHitState {
                shLogScroll: sh.shLogMaxScroll, shLogMaxScroll: sh.shLogMaxScroll, shLogStickBottom: true,
                shDrawerScroll: sh.shDrawerScroll, shDrawerMaxScroll: sh.shDrawerMaxScroll,
                shOnboardScroll: sh.shOnboardScroll, shOnboardMaxScroll: sh.shOnboardMaxScroll,
                shNpcScroll: sh.shNpcScroll, shNpcMaxScroll: sh.shNpcMaxScroll,
                shHovered: sh.shHovered, shHitboxes: sh.shHitboxes, shScrollZones: sh.shScrollZones,
            }), Nil)
        },
        "send_say_draft" -> handleTextSubmit("say", m0),
        "lab_cycle_action" -> {
            let acts = labActionOrder(m0);
            let n = maxInt(1, listLen(acts));
            let step = if (a1 == "prev") -1 else 1;
            let lb = m0.cmLab;
            let idxNext = floorMod(lb.labActionIdx + step + n, n);
            (withLab(m0, MkLabControls {
                labPaused: lb.labPaused, labSpeed: lb.labSpeed,
                labActionIdx: idxNext, labOutcomeIdx: lb.labOutcomeIdx, labSideIdx: lb.labSideIdx,
                labPlayerWeaponIdx: lb.labPlayerWeaponIdx, labEnemyWeaponIdx: lb.labEnemyWeaponIdx,
            }), Nil)
        },
        "lab_cycle_outcome" -> {
            let lb = m0.cmLab;
            (withLab(m0, MkLabControls {
                labPaused: lb.labPaused, labSpeed: lb.labSpeed,
                labActionIdx: lb.labActionIdx, labOutcomeIdx: floorMod(lb.labOutcomeIdx + 1, 4), labSideIdx: lb.labSideIdx,
                labPlayerWeaponIdx: lb.labPlayerWeaponIdx, labEnemyWeaponIdx: lb.labEnemyWeaponIdx,
            }), Nil)
        },
        "lab_cycle_side" -> {
            let lb = m0.cmLab;
            (withLab(m0, MkLabControls {
                labPaused: lb.labPaused, labSpeed: lb.labSpeed,
                labActionIdx: lb.labActionIdx, labOutcomeIdx: lb.labOutcomeIdx, labSideIdx: floorMod(lb.labSideIdx + 1, 2),
                labPlayerWeaponIdx: lb.labPlayerWeaponIdx, labEnemyWeaponIdx: lb.labEnemyWeaponIdx,
            }), Nil)
        },
        "lab_cycle_p_weapon" -> {
            let ws = allWeaponVisuals();
            let wn = maxInt(1, listLen(ws));
            let lb = m0.cmLab;
            let nextIdx = floorMod(lb.labPlayerWeaponIdx + 1, wn);
            let wv = listNthOr(ws, nextIdx, WeaponUnarmed);
            let m1 = withLab(m0, MkLabControls {
                labPaused: lb.labPaused, labSpeed: lb.labSpeed,
                labActionIdx: lb.labActionIdx, labOutcomeIdx: lb.labOutcomeIdx, labSideIdx: lb.labSideIdx,
                labPlayerWeaponIdx: nextIdx, labEnemyWeaponIdx: lb.labEnemyWeaponIdx,
            });
            handleLabCommand("weapon", "player", weaponVisualText(wv), "", 0.0, m1)
        },
        "lab_cycle_e_weapon" -> {
            let ws = allWeaponVisuals();
            let wn = maxInt(1, listLen(ws));
            let lb = m0.cmLab;
            let nextIdx = floorMod(lb.labEnemyWeaponIdx + 1, wn);
            let wv = listNthOr(ws, nextIdx, WeaponJian);
            let m1 = withLab(m0, MkLabControls {
                labPaused: lb.labPaused, labSpeed: lb.labSpeed,
                labActionIdx: lb.labActionIdx, labOutcomeIdx: lb.labOutcomeIdx, labSideIdx: lb.labSideIdx,
                labPlayerWeaponIdx: lb.labPlayerWeaponIdx, labEnemyWeaponIdx: nextIdx,
            });
            handleLabCommand("weapon", "enemy", weaponVisualText(wv), "", 0.0, m1)
        },
        "lab_play_selected" -> {
            let acts = labActionOrder(m0);
            let aid =
                if (listIsEmpty(acts)) "rig.fist.punch_a"
                else listNthOr(acts, floorMod(m0.cmLab.labActionIdx, listLen(acts)), "rig.fist.punch_a");
            let out = listNthOr(["hit", "dodge", "parry", "effect"], floorMod(m0.cmLab.labOutcomeIdx, 4), "hit");
            let side = listNthOr(["player", "enemy"], floorMod(m0.cmLab.labSideIdx, 2), "player");
            let (m1, c1) = handleLabCommand("seed", "female", "male", "", 0.0, m0);
            let (m2, c2) = handleLabCommand("submit", aid, out, side, 18.0, m1);
            (m2, listAppend(c1, c2))
        },
