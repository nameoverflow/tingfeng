        },
        "random_name" -> {
            let au = m0.cmAuth;
            let style =
                if (a1 == "male" || a1 == "female" || a1 == "unisex") a1
                else if (au.auCreateStep >= 1 && (au.auCreateChoice.ccGender == "male" || au.auCreateChoice.ccGender == "female")) au.auCreateChoice.ccGender
                else "any";
            let seed = floorInt(m0.cmVp.vpClockMs * 17.0) + m0.cmVp.vpDrawCmdCount * 13 + au.auCreateStep * 31 + 97;
            let picked = rollWuxiaName(style, seed, au.auUsername);
            let nextGender =
                if (a1 == "male" || a1 == "female") a1
                else au.auCreateChoice.ccGender;
            let nextChoice = MkCreationChoice {
                ccGender: nextGender,
                ccOrigin: au.auCreateChoice.ccOrigin,
                ccChildhood1: au.auCreateChoice.ccChildhood1,
                ccChildhood2: au.auCreateChoice.ccChildhood2,
            };
            (markDirty(withAuth(m0, MkAuthState {
                auConnected: au.auConnected, auConnecting: au.auConnecting,
                auUsername: picked, auLastError: None,
                auLoginMode: au.auLoginMode, auCreateStep: au.auCreateStep,
                auCreationCfg: au.auCreationCfg, auCreateChoice: nextChoice,
                auDevReset: au.auDevReset,
            })), [CmdBlurInput])
        },
        "create_step" -> {
            let stp = clampInt(0, 5, parseIntOr(a1, 0));
            let au = m0.cmAuth;
            (markDirty(withAuth(m0, MkAuthState {
                auConnected: au.auConnected, auConnecting: au.auConnecting,
