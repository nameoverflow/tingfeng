// ============================================================================
// Page Modes, Hitboxes, Scroll Zones & Outbound Host Commands
// ============================================================================

pub data AppPage {
    PageGame,
    PageBattleLab,
    PagePoseSheet,
}

pub def pageEq(a: AppPage, b: AppPage): Bool = match (a, b) {
    (PageGame, PageGame) -> true,
    (PageBattleLab, PageBattleLab) -> true,
    (PagePoseSheet, PagePoseSheet) -> true,
    _ -> false,
}

pub data LogLine {
    MkLogLine { llId: Int, llKind: String, llText: String },
}

pub data HitTarget {
    HitExit(Direction),
    HitNpc(String),
    HitResetCam,
    HitUi(String, String, String),
    HitFocusInput(String),
    HitLab(String, String, String, String, Float),
    HitLabScrub(Float, Float),
    HitSwallow,
}

pub def hitTargetEq(a: HitTarget, b: HitTarget): Bool = match (a, b) {
    (HitExit(d1), HitExit(d2)) -> dirEq(d1, d2),
    (HitNpc(x), HitNpc(y)) -> x == y,
    (HitResetCam, HitResetCam) -> true,
    (HitUi(k1, a1, b1), HitUi(k2, a2, b2)) -> k1 == k2 && a1 == a2 && b1 == b2,
    (HitFocusInput(x), HitFocusInput(y)) -> x == y,
    (HitLab(c1, x1, y1, z1, n1), HitLab(c2, x2, y2, z2, n2)) ->
        c1 == c2 && x1 == x2 && y1 == y2 && z1 == z2 && n1 == n2,
    (HitLabScrub(x1, w1), HitLabScrub(x2, w2)) -> x1 == x2 && w1 == w2,
    (HitSwallow, HitSwallow) -> true,
    _ -> false,
}

pub def optHitEq(a: Option HitTarget, b: Option HitTarget): Bool = match (a, b) {
    (None, None) -> true,
    (Some(x), Some(y)) -> hitTargetEq(x, y),
    _ -> false,
}

pub data CanvasHitbox {
    MkCanvasHitbox {
        chX: Float,
        chY: Float,
        chW: Float,
        chH: Float,
        chTarget: HitTarget,
        chCursor: String,
    },
}

pub data ScrollTarget {
    ScrollLog,
    ScrollDrawer,
    ScrollOnboard,
    ScrollNpc,
}

pub data ScrollZone {
    MkScrollZone {
        szX: Float,
        szY: Float,
        szW: Float,
        szH: Float,
        szTarget: ScrollTarget,
