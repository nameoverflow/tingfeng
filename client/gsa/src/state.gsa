                auDevReset: au.auDevReset,
            })), Nil)
        },
        "create_pick" -> {
            let au = m0.cmAuth;
            let cc = au.auCreateChoice;
            let ccNext = match a1 {
                "gender" -> MkCreationChoice { ccGender: a2, ccOrigin: cc.ccOrigin, ccChildhood1: cc.ccChildhood1, ccChildhood2: cc.ccChildhood2 },
                "origin" -> MkCreationChoice { ccGender: cc.ccGender, ccOrigin: a2, ccChildhood1: cc.ccChildhood1, ccChildhood2: cc.ccChildhood2 },
                "childhood1" -> MkCreationChoice { ccGender: cc.ccGender, ccOrigin: cc.ccOrigin, ccChildhood1: a2, ccChildhood2: cc.ccChildhood2 },
                "childhood2" -> MkCreationChoice { ccGender: cc.ccGender, ccOrigin: cc.ccOrigin, ccChildhood1: cc.ccChildhood1, ccChildhood2: a2 },
                _ -> cc,
            };
            let nextStep = minInt(5, au.auCreateStep + 1);
            (markDirty(withAuth(m0, MkAuthState {
                auConnected: au.auConnected, auConnecting: au.auConnecting,
                auUsername: au.auUsername, auLastError: au.auLastError,
                auLoginMode: au.auLoginMode, auCreateStep: nextStep,
                auCreationCfg: au.auCreationCfg, auCreateChoice: ccNext,
                auDevReset: au.auDevReset,
            })), Nil)
        },
        "login_submit" -> {
            let u = utf8Trim(a1);
            let pass = if (a2 == "reset") "__dev_reset" else "";
            let au = m0.cmAuth;
            if (strLen(u) == 0) {
                (markDirty(withAuth(m0, MkAuthState {
