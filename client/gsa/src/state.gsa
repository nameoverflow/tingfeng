                vpLastSyncTickMs: vp.vpLastSyncTickMs, vpWasmStepMs: vp.vpWasmStepMs, vpDrawCmdCount: vp.vpDrawCmdCount,
            })), Nil)
        },
        _ -> (m0, Nil),
    }

def labCombatant(name: String, style: String, weaponVisual: String, gender: String): CombatantInfo = MkCombatantInfo {
    cbId: name, cbName: name, cbGender: gender, cbStyle: style, cbWeaponVisual: weaponVisual,
    cbHp: 180, cbMaxHp: 180, cbQi: 100, cbMaxQi: 100,
    cbAp: 100, cbApProgress: 100.0, cbAgility: 18, cbEffects: Nil,
}

def withCombatantStyle(cb: CombatantInfo, st: String): CombatantInfo = MkCombatantInfo {
    cbId: cb.cbId, cbName: cb.cbName, cbGender: cb.cbGender, cbStyle: st, cbWeaponVisual: cb.cbWeaponVisual,
    cbHp: cb.cbHp, cbMaxHp: cb.cbMaxHp, cbQi: cb.cbQi, cbMaxQi: cb.cbMaxQi,
    cbAp: cb.cbAp, cbApProgress: cb.cbApProgress, cbAgility: cb.cbAgility, cbEffects: cb.cbEffects,
}

def withCombatantWeapon(cb: CombatantInfo, wv: WeaponVisual): CombatantInfo = MkCombatantInfo {
    cbId: cb.cbId, cbName: cb.cbName, cbGender: cb.cbGender,
    cbStyle: combatStyleText(weaponRigStyle(wv)),
    cbWeaponVisual: weaponVisualText(wv),
    cbHp: cb.cbHp, cbMaxHp: cb.cbMaxHp, cbQi: cb.cbQi, cbMaxQi: cb.cbMaxQi,
    cbAp: cb.cbAp, cbApProgress: cb.cbApProgress, cbAgility: cb.cbAgility, cbEffects: cb.cbEffects,
}

def withCombatantHpDelta(cb: CombatantInfo, delta: Int): CombatantInfo = MkCombatantInfo {
    cbId: cb.cbId, cbName: cb.cbName, cbGender: cb.cbGender, cbStyle: cb.cbStyle, cbWeaponVisual: cb.cbWeaponVisual,
    cbHp: clampInt(0, cb.cbMaxHp, cb.cbHp + delta),
    cbMaxHp: cb.cbMaxHp, cbQi: cb.cbQi, cbMaxQi: cb.cbMaxQi,
    cbAp: cb.cbAp, cbApProgress: cb.cbApProgress, cbAgility: cb.cbAgility, cbEffects: cb.cbEffects,
}

pub def handleLabCommand(
    cmd: String,
    a1: String,
    a2: String,
    a3: String,
    numArg: Float,
    m0: ClientModel
): (ClientModel, List ClientCmd) = match cmd {
    "seed" -> {
        let pGender = if (strLen(a1) == 0) "female" else a1;
        let eGender = if (strLen(a2) == 0) "male" else a2;
        let ws = allWeaponVisuals();
        let wn = maxInt(1, listLen(ws));
        let pWv = listNthOr(ws, floorMod(m0.cmLab.labPlayerWeaponIdx, wn), WeaponUnarmed);
        let eWv = listNthOr(ws, floorMod(m0.cmLab.labEnemyWeaponIdx, wn), WeaponJian);
        let snap = MkBattleSnap {
            bsPlayer: labCombatant("行者", combatStyleText(weaponRigStyle(pWv)), weaponVisualText(pWv), pGender),
            bsEnemy: labCombatant("守擂人", combatStyleText(weaponRigStyle(eWv)), weaponVisualText(eWv), eGender),
            bsCooldowns: mapEmpty(),
            bsActiveSkills: Nil,
            bsActionLock: 0.0,
            bsPendingSkillId: None,
        };
        let au = m0.cmAuth;
        let hs = m0.cmHero;
        let st = hs.hsStats;
        let wv = m0.cmWorld;
        let bt = m0.cmBattle;
        let lb = m0.cmLab;
        let ui = m0.cmUi;
        let mReset = withUi(
            withLab(
                withBattle(
                    withWorld(
                        withHero(
                            withAuth(m0, MkAuthState {
                                auConnected: true, auConnecting: au.auConnecting,
                                auUsername: "行者", auLastError: au.auLastError,
                                auLoginMode: au.auLoginMode, auCreateStep: au.auCreateStep,
                                auCreationCfg: au.auCreationCfg, auCreateChoice: au.auCreateChoice,
                                auDevReset: au.auDevReset,
                            }),
                            MkHeroSheets {
                                hsStats: MkPlayerStatsInfo {
                                    psHp: 180, psMaxHp: 180, psQi: st.psQi, psMaxQi: st.psMaxQi,
                                    psJing: st.psJing, psMaxJing: st.psMaxJing, psAp: st.psAp,
                                    psStatus: st.psStatus, psGender: pGender, psAppearance: st.psAppearance,
                                    psAppearanceText: st.psAppearanceText, psPortraitKey: st.psPortraitKey,
                                    psStrength: st.psStrength, psAgility: st.psAgility, psVitality: st.psVitality,
                                    psPotential: st.psPotential, psCombatExp: st.psCombatExp,
                                    psInjuredSeconds: st.psInjuredSeconds, psCombatInsight: st.psCombatInsight,
                                    psBusy: st.psBusy,
                                },
                                hsStatsSyncedAtMs: hs.hsStatsSyncedAtMs,
                                hsBusySyncedAtMs: hs.hsBusySyncedAtMs,
                                hsMoney: hs.hsMoney, hsInventory: hs.hsInventory,
                                hsArts: hs.hsArts, hsQuests: hs.hsQuests,
                            }
                        ),
                        MkWorldView {
                            wvRoomName: "竹间试招", wvRoomDesc: wv.wvRoomDesc,
                            wvRoomChars: wv.wvRoomChars, wvRoomExits: wv.wvRoomExits,
                            wvMapOverview: wv.wvMapOverview, wvMapCache: wv.wvMapCache,
                            wvRequestedInit: wv.wvRequestedInit, wvStoryActive: wv.wvStoryActive,
                            wvStoryQueue: wv.wvStoryQueue, wvStoryDelayRemMs: wv.wvStoryDelayRemMs,
                            wvTransitionBanner: wv.wvTransitionBanner,
                        }
                    ),
                    MkBattleStateView {
                        btInBattle: bt.btInBattle, btSnap: bt.btSnap,
                        btCooldownSyncedMs: bt.btCooldownSyncedMs, btActionLockUntilMs: bt.btActionLockUntilMs,
                        btPresentation: None, btPreEventSnap: None,
                        btActiveTimeline: None, btTimelineElapsedMs: 0.0,
                        btAppliedHits: 0, btNextTimelineId: bt.btNextTimelineId,
                        btQueue: Nil,
                    }
                ),
                MkLabControls {
                    labPaused: false, labSpeed: 1.0,
                    labActionIdx: lb.labActionIdx, labOutcomeIdx: lb.labOutcomeIdx, labSideIdx: lb.labSideIdx,
                    labPlayerWeaponIdx: lb.labPlayerWeaponIdx, labEnemyWeaponIdx: lb.labEnemyWeaponIdx,
                }
            ),
            MkUiChrome {
                uiLogs: Nil, uiNextLogId: ui.uiNextLogId, uiUnreadLogs: ui.uiUnreadLogs,
                uiDesktopDrawer: ui.uiDesktopDrawer, uiCharSubTab: ui.uiCharSubTab, uiMobileTab: ui.uiMobileTab,
                uiSelectedNpc: ui.uiSelectedNpc, uiFocusedInput: ui.uiFocusedInput, uiSayDraft: ui.uiSayDraft,
                uiDirty: true,
            }
        );
        applyServerMessage(SmBattleState(snap), mReset)
    },
    "weapon" -> {
        let side = parseBattleSide(if (strLen(a1) == 0) "player" else a1);
        let wv = parseWeaponVisual(a2, if (sideEq(side, SidePlayer)) StyleFist else StyleSword);
        let bs0 = optOr(m0.cmBattle.btSnap, MkBattleSnap {
            bsPlayer: labCombatant("行者", "fist", "unarmed", "female"),
            bsEnemy: labCombatant("守擂人", "sword", "jian", "male"),
            bsCooldowns: mapEmpty(), bsActiveSkills: Nil, bsActionLock: 0.0, bsPendingSkillId: None,
        });
        let nextSnap =
            if (sideEq(side, SidePlayer)) {
                MkBattleSnap {
                    bsPlayer: withCombatantWeapon(bs0.bsPlayer, wv), bsEnemy: bs0.bsEnemy,
                    bsCooldowns: bs0.bsCooldowns, bsActiveSkills: bs0.bsActiveSkills,
                    bsActionLock: bs0.bsActionLock, bsPendingSkillId: bs0.bsPendingSkillId,
                }
            } else {
                MkBattleSnap {
                    bsPlayer: bs0.bsPlayer, bsEnemy: withCombatantWeapon(bs0.bsEnemy, wv),
                    bsCooldowns: bs0.bsCooldowns, bsActiveSkills: bs0.bsActiveSkills,
                    bsActionLock: bs0.bsActionLock, bsPendingSkillId: bs0.bsPendingSkillId,
                }
            };
        let ws = allWeaponVisuals();
        let wIdx = optOr(listFindIndex(ws, (item) -> weaponVisualText(item) == weaponVisualText(wv)), 0);
        let lb = m0.cmLab;
        let m1 = withLab(m0, MkLabControls {
            labPaused: lb.labPaused, labSpeed: lb.labSpeed,
            labActionIdx: lb.labActionIdx, labOutcomeIdx: lb.labOutcomeIdx, labSideIdx: lb.labSideIdx,
            labPlayerWeaponIdx: if (sideEq(side, SidePlayer)) wIdx else lb.labPlayerWeaponIdx,
            labEnemyWeaponIdx: if (sideEq(side, SideEnemy)) wIdx else lb.labEnemyWeaponIdx,
        });
        applyServerMessage(SmBattleState(nextSnap), m1)
    },
    "submit" -> {
        let aid = if (strLen(a1) == 0) "rig.fist.punch_a" else a1;
        let res = parseCombatResult(if (strLen(a2) == 0) "hit" else a2);
        let side = parseBattleSide(if (strLen(a3) == 0) "player" else a3);
        let dmg = if (numArg <= 0.0) 18 else roundInt(numArg);
        let act = battleActionFor(m0.cmCatalog, aid, StyleFist);
        let bs0 = optOr(m0.cmBattle.btSnap, MkBattleSnap {
            bsPlayer: labCombatant("行者", "fist", "unarmed", "female"),
            bsEnemy: labCombatant("守擂人", "sword", "jian", "male"),
            bsCooldowns: mapEmpty(), bsActiveSkills: Nil, bsActionLock: 0.0, bsPendingSkillId: None,
        });
        let isSelf = act.adActorMotion == "focus";
        let isEff = strStartsWith(aid, "rig.effect.");
        let pl0 = bs0.bsPlayer;
        let en0 = bs0.bsEnemy;
        let actorC = if (sideEq(side, SidePlayer)) pl0 else en0;
        let targetIsPlayer = if (isSelf) sideEq(side, SidePlayer) else sideEq(side, SideEnemy);
        let targetC = if (targetIsPlayer) pl0 else en0;
        let snapBefore = MkBattleSnap {
            bsPlayer: pl0, bsEnemy: en0,
            bsCooldowns: bs0.bsCooldowns, bsActiveSkills: bs0.bsActiveSkills,
            bsActionLock: act.adDurationMs / 1000.0, bsPendingSkillId: bs0.bsPendingSkillId,
        };
        let mHeal = if (strContains(aid, "healing") || strEndsWith(aid, "hot")) Some(22) else None;
        let mDmg = if (combatResEq(res, ResHit) && optIsNone(mHeal)) Some(dmg) else None;
        let evKind = if (isEff) "effect_tick" else if (isSelf) "active_skill" else "normal";
        let evRes = if (isSelf || optIsSome(mHeal)) ResEffect else res;
        let ev = MkCombatEvt {
            ceKind: evKind, ceActorName: actorC.cbName, ceTargetName: targetC.cbName,
            ceMsgKind: "script", ceText: act.adLabel, ceEffectKind: "", ceEffectAmount: 0,
            ceDamage: mDmg, ceHeal: mHeal, ceResult: evRes, ceHits: Nil,
            ceActionId: aid, ceTags: act.adTags, ceLabel: None,
            ceDurationMs: Some(act.adDurationMs), ceStagingOverride: None,
        };
        let hpDelta = -optOr(mDmg, 0) + optOr(mHeal, 0);
        let snapAfter =
            if (targetIsPlayer) {
                MkBattleSnap {
                    bsPlayer: withCombatantHpDelta(pl0, hpDelta), bsEnemy: en0,
                    bsCooldowns: snapBefore.bsCooldowns, bsActiveSkills: snapBefore.bsActiveSkills,
                    bsActionLock: snapBefore.bsActionLock, bsPendingSkillId: snapBefore.bsPendingSkillId,
                }
            } else {
                MkBattleSnap {
                    bsPlayer: pl0, bsEnemy: withCombatantHpDelta(en0, hpDelta),
                    bsCooldowns: snapBefore.bsCooldowns, bsActiveSkills: snapBefore.bsActiveSkills,
                    bsActionLock: snapBefore.bsActionLock, bsPendingSkillId: snapBefore.bsPendingSkillId,
                }
            };
        let (m1, c1) = applyServerMessage(SmBattleState(snapBefore), m0);
        let (m2, c2) = applyServerMessage(SmCombatEvent(ev), m1);
        let (m3, c3) = applyServerMessage(SmBattleState(snapAfter), m2);
        (m3, listAppend(c1, listAppend(c2, c3)))
    },
    "demo" -> {
        let steps = [
            ("rig.fist.punch_a", "hit", "player", 18.0),
            ("rig.fist.punch_a", "hit", "player", 18.0),
            ("rig.sword.thrust_a", "parry", "enemy", 18.0),
            ("rig.fist.kick_a", "dodge", "player", 18.0),
            ("rig.sword.cut_a", "hit", "enemy", 26.0),
            ("rig.fist.heavy_a", "hit", "player", 35.0),
            ("rig.fist.healing_palm", "effect", "player", 0.0),
            ("rig.sword.rising_cut_a", "dodge", "enemy", 18.0),
            ("rig.fist.heavy_a", "hit", "player", 109.0)
        ];
        let (mSeed, c0) = handleLabCommand("seed", "female", "male", "", 0.0, m0);
        let (mMid, cMid) = std.list.listFold(steps, (mSeed, c0), (acc, step) -> match (acc, step) {
            ((accM, accC), (aid, r, s, d)) -> {
                let (nm, nc) = handleLabCommand("submit", aid, r, s, d, accM);
                (nm, listAppend(accC, nc))
            },
        });
        let (mEnd, cEnd) = applyServerMessage(SmCombatSettlement("行者", "守擂人", true), mMid);
        (mEnd, listAppend(cMid, cEnd))
    },
    "pause" -> {
        let paused = a1 != "false" && a1 != "0";
        let lb = m0.cmLab;
        (markDirty(withLab(m0, MkLabControls {
            labPaused: paused, labSpeed: lb.labSpeed,
            labActionIdx: lb.labActionIdx, labOutcomeIdx: lb.labOutcomeIdx, labSideIdx: lb.labSideIdx,
            labPlayerWeaponIdx: lb.labPlayerWeaponIdx, labEnemyWeaponIdx: lb.labEnemyWeaponIdx,
        })), Nil)
    },
    "speed" -> {
        let lb = m0.cmLab;
        (markDirty(withLab(m0, MkLabControls {
            labPaused: lb.labPaused, labSpeed: clampFloat(0.05, 4.0, numArg),
            labActionIdx: lb.labActionIdx, labOutcomeIdx: lb.labOutcomeIdx, labSideIdx: lb.labSideIdx,
            labPlayerWeaponIdx: lb.labPlayerWeaponIdx, labEnemyWeaponIdx: lb.labEnemyWeaponIdx,
        })), Nil)
    },
    "seek" -> match m0.cmBattle.btActiveTimeline {
        None -> (m0, Nil),
        Some(tl) -> {
            let clamped = clampFloat(0.0, tl.tlDurationMs, numArg);
            let bt0 = m0.cmBattle;
            let m1 = markDirty(withBattle(m0, MkBattleStateView {
                btInBattle: bt0.btInBattle, btSnap: bt0.btSnap,
                btCooldownSyncedMs: bt0.btCooldownSyncedMs, btActionLockUntilMs: bt0.btActionLockUntilMs,
                btPresentation: bt0.btPresentation, btPreEventSnap: bt0.btPreEventSnap,
                btActiveTimeline: bt0.btActiveTimeline, btTimelineElapsedMs: clamped,
                btAppliedHits: bt0.btAppliedHits, btNextTimelineId: bt0.btNextTimelineId,
                btQueue: bt0.btQueue,
            }));
            runClientM(commitHitsUpToM(clamped), m1)
        },
    },
    _ -> (m0, Nil),
}

// ============================================================================
// Shared HUD Evaluation, Portrait Hash & Playwright Lab State JSON
// ============================================================================

pub def liveEffectsOf(m: ClientModel, isPlayer: Bool): List (EffectInfo, Float) = {
    let cdAgeSec = maxFloat(0.0, (m.cmVp.vpClockMs - m.cmBattle.btCooldownSyncedMs) / 1000.0);
    let raw = match (m.cmBattle.btPresentation, m.cmBattle.btSnap) {
        (Some(pr), _) -> if (isPlayer) pr.prPlayerEffects else pr.prEnemyEffects,
        (None, Some(bs)) -> if (isPlayer) bs.bsPlayer.cbEffects else bs.bsEnemy.cbEffects,
        _ -> Nil,
    };
    listFilterMap(raw, (ef) -> {
        let remS = maxFloat(0.0, ef.efRemaining - cdAgeSec);
        if (remS > 0.05) Some((ef, remS)) else None
    })
}

pub data SkillEval {
    MkSkillEval {
        seSkill: ActiveSkillInfo,
        seCdRem: Float,
        seCdTotal: Float,
        seReady: Bool,
        seQueued: Bool,
        seUltimate: Bool,
        seReason: String,
    },
}

pub def evalSkillState(m: ClientModel): List SkillEval = match m.cmBattle.btSnap {
    None -> Nil,
    Some(bs) -> {
        let loc = m.cmVp.vpLocale;
        let zh = isZh(loc);
        let cdAgeSec = maxFloat(0.0, (m.cmVp.vpClockMs - m.cmBattle.btCooldownSyncedMs) / 1000.0);
        let cds = bs.bsCooldowns;
        let pEffs = liveEffectsOf(m, true);
        let presQi = match m.cmBattle.btPresentation {
            Some(pr) -> pr.prPlayerQi,
            None -> bs.bsPlayer.cbQi,
        };
        let apCur = maxInt(bs.bsPlayer.cbAp, floorInt(m.cmFx.fxPlayerApAnim));
        listMap(bs.bsActiveSkills, (sk) -> {
            let cdRem = maxFloat(0.0, optOr(mapLookup(cds, sk.asId), 0.0) - cdAgeSec);
            let nReqs = listLen(sk.asReqStatus);
            let missingReqs = listFilterMap(intRange(0, nReqs - 1), (idx) -> {
                let reqId = listNthOr(sk.asReqStatus, idx, "");
                let reqNm = listNthOr(sk.asReqStatusNames, idx, "");
                let present = optIsSome(listFind(pEffs, (p) -> match p { (ef, _) -> ef.efId == reqId }));
                if (!present) Some(reqNm) else None
            });
            let hasReqs = listIsEmpty(missingReqs);
            let ready = cdRem <= 0.05 && presQi >= sk.asCost && apCur >= sk.asApReq && hasReqs;
            let queued = optStrEq(bs.bsPendingSkillId, Some(sk.asId));
            let reasonTxt =
                if (queued) {
                    if (zh) "蓄势待发" else "Queued"
                } else if (cdRem > 0.05) {
                    (if (zh) "冷却 " else "CD ") + intToStr(ceilInt(cdRem)) + "s"
                } else if (!hasReqs) {
                    let nonEmpty = listFilter(missingReqs, (s) -> strLen(s) > 0);
                    (if (zh) "需「" else "Need ") + strJoin(nonEmpty, "、") + (if (zh) "」" else "")
                } else if (presQi < sk.asCost) {
                    (if (zh) "需气 " else "Qi ") + intToStr(sk.asCost)
                } else if (apCur < sk.asApReq) {
                    (if (zh) "需动 " else "AP ") + intToStr(sk.asApReq)
                } else {
                    (if (zh) "动 " else "AP ") + intToStr(sk.asApReq) + (if (zh) " · 气 " else " · Qi ") + intToStr(sk.asCost)
                };
            MkSkillEval {
                seSkill: sk,
                seCdRem: cdRem,
                seCdTotal: maxFloat(1.0, sk.asCooldown),
                seReady: ready,
                seQueued: queued,
                seUltimate: optOr(sk.asDamage, 0) >= 100,
                seReason: reasonTxt,
            }
        })
    },
}

pub def portraitScoreFile(gender: String, app: Int, playerName: String): String = {
    let evenScore = clampInt(0, 10, floorDiv(app + 1, 2) * 2);
    let twoDigit = if (evenScore < 10) "0" + intToStr(evenScore) else intToStr(evenScore);
    let trimmed = utf8Trim(playerName);
    let variant = 1 + utf8FoldCodepoints(trimmed, 0, (acc, cp) -> floorMod(acc * 31 + cp, 4));
    let variantText = "-0" + intToStr(variant);
    let version = if (evenScore >= 8) "v9" else "v8";
    let portraitGender = match gender {
        "female" -> "female",
        "male" -> "male",
        _ -> if (evenScore <= 2) "male" else "female",
    };
    "beauty-" + version + "-" + portraitGender + "-" + twoDigit + variantText
}

def encodeCombatantVal(mCb: Option CombatantInfo): Value = match mCb {
    None -> VNull,
    Some(cb) -> object([
        "combatantSnapshotName" := cb.cbName,
        "combatantSnapshotHp" := cb.cbHp,
        "combatantSnapshotMaxHp" := cb.cbMaxHp,
        "combatantSnapshotQi" := cb.cbQi,
        "combatantSnapshotMaxQi" := cb.cbMaxQi,
    ]),
}

pub def buildLabStateJson(m: ClientModel): String = {
    let bt = m.cmBattle;
    let mTl = bt.btActiveTimeline;
    let tlVal = match mTl {
        None -> VNull,
        Some(tl) -> object([
            "id" := tl.tlId,
            "kind" := tl.tlKind,
            "durationMs" := numVal(tl.tlDurationMs),
            "impactAtMs" := numVal(tl.tlImpactAtMs),
        ]),
    };
    let presVal = match bt.btPresentation {
        None -> VNull,
        Some(pr) -> object([
            "playerHp" := pr.prPlayerHp,
            "enemyHp" := pr.prEnemyHp,
            "playerQi" := pr.prPlayerQi,
            "enemyQi" := pr.prEnemyQi,
        ]),
    };
    let (playerDashX, playerDashY) =
        if (m.cmVp.vpReducedMotion) (0.0, 0.0)
        else match mTl {
            Some(tl) -> {
                let sc = sampleBattleScene(Some(tl), bt.btTimelineElapsedMs, tl.tlActor.raVisual, tl.tlTarget.rtVisual, false);
                let pf = sc.scPlayer;
                (pf.fsX - sideHome(SidePlayer), pf.fsY)
            },
            None -> (0.0, 0.0),
        };
    let stageEventId = match mTl { Some(tl) -> intToStr(tl.tlId), None -> "idle" };
    let pCb = match bt.btSnap { Some(bs) -> Some(bs.bsPlayer), None -> None };
    let eCb = match bt.btSnap { Some(bs) -> Some(bs.bsEnemy), None -> None };
    let activeCount = match mTl { Some(_) -> 1, None -> 0 };
    stringify(object([
        "stageEventId" := stageEventId,
        "playerDashX" := numVal(playerDashX),
        "playerDashY" := numVal(playerDashY),
        "soundOn" := m.cmVp.vpSoundOn,
        "logCount" := listLen(m.cmUi.uiLogs),
        "game" := object([
            "battle" := object([
                "active" := bt.btInBattle,
                "player" := encodeCombatantVal(pCb),
                "enemy" := encodeCombatantVal(eCb),
                "presentation" := presVal,
                "animation" := object([
                    "activeTimeline" := tlVal,
                    "queueDepth" := listLen(bt.btQueue) + activeCount,
                ]),
            ]),
        ]),
        "playback" := object([
            "paused" := m.cmLab.labPaused,
            "speed" := numVal(m.cmLab.labSpeed),
            "elapsedMs" := numVal(bt.btTimelineElapsedMs),
            "durationMs" := numVal(match mTl { Some(tl) -> tl.tlDurationMs, None -> 0.0 }),
        ]),
    ]))
}
