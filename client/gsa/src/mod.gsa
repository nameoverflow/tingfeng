// ============================================================================
// Persistent Global Kagura Runtime & Seeded Assets
// ============================================================================

def seededPageRef: Cell AppPage = cellNew(PageGame)
def seededReducedRef: Cell Bool = cellNew(false)
def seededAssetsRef: Cell (Option (PoseLibrary, ActionCatalog)) = cellNew(None)
def pendingCreationRef: Cell (Option CreationChoice) = cellNew(None)
def activeWsModeRef: Cell String = cellNew("")
def runtimeRef: Cell (Option (Runtime ClientModel ClientMsg)) = cellNew(None)

def isLogPinned(): Bool = match cellGet(runtimeRef) {
    Some(rt) -> rtIsPinnedBottom(rt, "log"),
    None -> true,
}

def translateClientCmd(c: ClientCmd): Cmd ClientMsg = match c {
    CmdSendWs(payload) -> CmdSendNet(payload),
    CmdOpenConfigWs -> CmdConnectNet("config_only", "", ""),
    CmdConnectWs(u, p, mChoice) -> {
        cellSet(pendingCreationRef, mChoice);
        let modeStr = match mChoice {
            None -> "login",
            Some(_) -> "create",
        };
        CmdConnectNet(modeStr, u, p)
    },
    CmdSetCursor(_) -> CmdNone,
    CmdPlaySfx(sfx) -> kagura.app.CmdPlaySfx(sfx),
    CmdSaveLocal(k, v) -> kagura.app.CmdSaveLocal(k, v),
    CmdFocusInput(_, _, _, _, _, _) -> CmdNone,
    CmdBlurInput -> CmdBlurIme,
}

def translateCmdList(cs: List ClientCmd): Cmd ClientMsg = match cs {
    Nil -> CmdNone,
    _ -> cmdBatch(listMap(cs, translateClientCmd)),
}

def updateTingfeng(msg: ClientMsg, m0: ClientModel): (ClientModel, Cmd ClientMsg) = match msg {
    MsgUi(kind, a1, a2) -> {
        let (m1, cs) = handleUiAction(kind, a1, a2, m0);
        let scrollCmd =
            if (kind == "scroll_log_bottom") CmdScrollToBottom("log")
            else if (kind == "desktop_drawer" || kind == "char_subtab" || kind == "mobile_tab") CmdScrollTo("drawer", 0.0)
            else if (kind == "select_npc") CmdScrollTo("npc", 0.0)
            else if (kind == "create_step" || kind == "create_pick" || kind == "login_mode") CmdScrollTo("onboard", 0.0)
            else CmdNone;
        (m1, cmdBatch([translateCmdList(cs), scrollCmd]))
    },
    MsgGoExit(dir) ->
        if (m0.cmAuth.auConnected && !m0.cmWorld.wvStoryActive)
            (m0, CmdSendNet(encodePlayerAction(ActGo(dir))))
        else
            (m0, CmdNone),
    MsgPanMap(dx, dy) -> (panCameraBy(dx, dy, m0), CmdNone),
    MsgZoomWheel(dy) -> (zoomCameraBy(if (dy < 0.0) 1.09 else 0.92, m0), CmdNone),
    MsgInputLogin(val) -> (handleTextInput("login", val, m0), CmdNone),
    MsgSubmitLogin -> {
        let (m1, cs) = handleTextSubmit("login", m0);
        (m1, translateCmdList(cs))
    },
    MsgInputSay(val) -> (handleTextInput("say", val, m0), CmdNone),
    MsgSubmitSay -> {
        let (m1, cs) = handleTextSubmit("say", m0);
        (m1, cmdBatch([translateCmdList(cs), CmdScrollToBottom("log")]))
    },
    MsgLab(cmd, a1, a2, a3, num) -> {
        let (m1, cs) = handleLabCommand(cmd, a1, a2, a3, num, m0);
        (m1, translateCmdList(cs))
    },
    MsgLabScrub(ratio) -> {
        let dur = match m0.cmBattle.btActiveTimeline { Some(tl) -> tl.tlDurationMs, None -> 0.0 };
        let (m1, c1) = handleLabCommand("pause", "true", "", "", 0.0, m0);
        let (m2, c2) = handleLabCommand("seek", "", "", "", ratio * dur, m1);
        (m2, translateCmdList(listAppend(c1, c2)))
    },
    MsgKeyDown(key) -> {
        let (m1, cs) = handleKeyDown(key, m0);
        (m1, translateCmdList(cs))
    },
    MsgNetOpen(mode, userRaw, pass) -> {
        let u = utf8Trim(userRaw);
        cellSet(activeWsModeRef, mode);
        if (mode == "config_only") {
            (m0, CmdSendNet(encodeRequestCreationConfig()))
        } else {
            let mChoice = cellGet(pendingCreationRef);
            cellSet(pendingCreationRef, None);
            let au0 = m0.cmAuth;
            let wv0 = m0.cmWorld;
            let m1 = markDirty(withWorld(
                withAuth(m0, MkAuthState {
                    auConnected: true,
                    auConnecting: false,
                    auUsername: u,
                    auLastError: au0.auLastError,
                    auLoginMode: au0.auLoginMode,
                    auCreateStep: au0.auCreateStep,
                    auCreationCfg: au0.auCreationCfg,
                    auCreateChoice: au0.auCreateChoice,
                    auDevReset: au0.auDevReset,
                }),
                MkWorldView {
                    wvRoomName: wv0.wvRoomName,
                    wvRoomDesc: wv0.wvRoomDesc,
                    wvRoomChars: wv0.wvRoomChars,
                    wvRoomExits: wv0.wvRoomExits,
                    wvMapOverview: wv0.wvMapOverview,
                    wvMapCache: wv0.wvMapCache,
                    wvRequestedInit: false,
                    wvStoryActive: wv0.wvStoryActive,
                    wvStoryQueue: wv0.wvStoryQueue,
                    wvStoryDelayRemMs: wv0.wvStoryDelayRemMs,
                    wvTransitionBanner: wv0.wvTransitionBanner,
                }
            ));
            (m1, CmdSendNet(encodeLogin(u, pass, mChoice)))
        }
    },
    MsgNetMessage(raw) -> match decodeServerMsg(raw) {
        Err(_) -> (m0, CmdNone),
        Ok(sm) -> {
            let (m1, cs) = applyServerMessage(sm, m0);
            (m1, translateCmdList(cs))
        },
    },
    MsgNetClose -> {
        let lastMode = cellGet(activeWsModeRef);
        if (lastMode != "config_only" && m0.cmWorld.wvRoomName != "竹间试招") {
            let au0 = m0.cmAuth;
            let errMsg =
                if (au0.auConnecting || !au0.auConnected)
                    Some("无法连接游戏服务端，请稍后重试。")
                else au0.auLastError;
            let m1 = markDirty(withAuth(m0, MkAuthState {
                auConnected: false,
                auConnecting: false,
                auUsername: au0.auUsername,
                auLastError: errMsg,
                auLoginMode: au0.auLoginMode,
                auCreateStep: au0.auCreateStep,
                auCreationCfg: au0.auCreationCfg,
                auCreateChoice: au0.auCreateChoice,
                auDevReset: au0.auDevReset,
            }));
            (m1, CmdNone)
        } else (m0, CmdNone)
    },
    MsgSetHidden(hidden) -> (setDocumentHidden(hidden, m0), CmdNone),
}

def tickTingfeng(dtMs: Float, vp: Rect, m0: ClientModel): (ClientModel, Cmd ClientMsg) = {
    let (m1, cs) = stepClientFrame(dtMs, vp.rw, vp.rh, m0);
    (m1, translateCmdList(cs))
}

def buildAppConfig(poseLib: PoseLibrary, cat: ActionCatalog): AppConfig ClientModel ClientMsg = MkAppConfig {
    appTheme: tingfengTheme(false),
    appDynamicTheme: Some((m) -> tingfengTheme(m.cmBattle.btInBattle || pageEq(m.cmVp.vpPage, PageBattleLab))),
    appPaperGrain: true,
    appInit: (vp) -> {
        let page = cellGet(seededPageRef);
        let red = cellGet(seededReducedRef);
        let m0 = initClientModel(page, poseLib, cat, vp.rw, vp.rh, red);
        if (pageEq(page, PageBattleLab)) {
            let (m1, cs) = handleLabCommand("seed", "female", "male", "", 0.0, m0);
            (m1, translateCmdList(cs))
        } else (m0, CmdNone)
    },
    appUpdate: updateTingfeng,
    appView: (vp, m) -> viewRoot(vp, isLogPinned(), m),
    appTick: Some(tickTingfeng),
    appOnKey: Some((k) -> Some(MsgKeyDown(k))),
    appOnNetOpen: None,
    appOnNetMessage: Some((raw) -> Some(MsgNetMessage(raw))),
    appOnNetClose: Some(MsgNetClose),
}

// ============================================================================
// Exported Kagura Host Entry Points (`kagura_*`) + Asset/Lab Hooks (`tf_*`)
// ============================================================================

pub def tf_seed_assets(
    pageStr: String,
    poseStr: String,
    stgStr: String,
    fistStr: String,
    swordStr: String,
    effStr: String,
    redInt: Int
): Void = {
    let page = match pageStr {
        "lab" -> PageBattleLab,
        "poses" -> PagePoseSheet,
        _ -> PageGame,
    };
    cellSet(seededPageRef, page);
    cellSet(seededReducedRef, redInt != 0);
    match parsePoseLibrary(poseStr) {
        Err(err) -> printLn("PoseLibrary error: " + err),
        Ok(poseLib) -> match parseActionCatalog(stgStr, [fistStr, swordStr, effStr]) {
            Err(err) -> printLn("ActionCatalog error: " + err),
            Ok(cat) -> cellSet(seededAssetsRef, Some((poseLib, cat))),
        },
    }
}

pub def kagura_init(w: Float, h: Float): Void =
    match cellGet(seededAssetsRef) {
        None -> printLn("kagura_init called before tf_seed_assets"),
        Some((poseLib, cat)) -> {
            let cfg = buildAppConfig(poseLib, cat);
            let rt = runtimeCreate(cfg, maxFloat(320.0, w), maxFloat(220.0, h), envHost());
            cellSet(runtimeRef, Some(rt))
        },
    }

pub def kagura_step_frame(dtMs: Float, w: Float, h: Float): Void =
    match cellGet(runtimeRef) {
        Some(rt) -> {
            let _ = rtStepFrame(rt, dtMs, w, h);
            ()
        },
        None -> (),
    }

pub def kagura_pointer_move(x: Float, y: Float): Void =
    match cellGet(runtimeRef) {
        Some(rt) -> rtPointerMove(rt, x, y),
        None -> (),
    }

pub def kagura_pointer_click(x: Float, y: Float): Void =
    match cellGet(runtimeRef) {
        Some(rt) -> rtPointerClick(rt, x, y),
        None -> (),
    }

pub def kagura_pointer_drag(sx: Float, sy: Float, cx: Float, cy: Float, dx: Float, dy: Float): Void =
    match cellGet(runtimeRef) {
        Some(rt) -> rtPointerDrag(rt, sx, sy, cx, cy, dx, dy),
        None -> (),
    }

pub def kagura_scroll_wheel(x: Float, y: Float, deltaY: Float): Void =
    match cellGet(runtimeRef) {
        Some(rt) -> rtScrollWheel(rt, x, y, deltaY),
        None -> (),
    }

pub def kagura_text_input(inpId: String, valStr: String): Void =
    match cellGet(runtimeRef) {
        Some(rt) -> rtTextInput(rt, inpId, valStr),
        None -> (),
    }

pub def kagura_text_submit(inpId: String): Void =
    match cellGet(runtimeRef) {
        Some(rt) -> rtTextSubmit(rt, inpId),
        None -> (),
    }

pub def kagura_blur_input(): Void =
    match cellGet(runtimeRef) {
        Some(rt) -> rtBlurInput(rt),
        None -> (),
    }

pub def kagura_key_down(keyStr: String): Void =
    match cellGet(runtimeRef) {
        Some(rt) -> rtKeyDown(rt, keyStr),
        None -> (),
    }

pub def kagura_on_net_open(mode: String, user: String, pass: String): Void =
    match cellGet(runtimeRef) {
        Some(rt) -> rtDispatch(rt, MsgNetOpen(mode, user, pass)),
        None -> (),
    }

pub def kagura_on_net_message(raw: String): Void =
    match cellGet(runtimeRef) {
        Some(rt) -> rtDispatch(rt, MsgNetMessage(raw)),
        None -> (),
    }

pub def kagura_on_net_close(): Void =
    match cellGet(runtimeRef) {
        Some(rt) -> rtDispatch(rt, MsgNetClose),
        None -> (),
    }

pub def tf_ui_action(kind: String, a1: String, a2: String): Void =
    match cellGet(runtimeRef) {
        Some(rt) -> rtDispatch(rt, MsgUi(kind, a1, a2)),
        None -> (),
    }

pub def tf_lab_cmd(cmd: String, a1: String, a2: String, a3: String, numArg: Float): Void =
    match cellGet(runtimeRef) {
        Some(rt) -> rtDispatch(rt, MsgLab(cmd, a1, a2, a3, numArg)),
        None -> (),
    }

pub def tf_set_hidden(hiddenInt: Int): Void =
    match cellGet(runtimeRef) {
        Some(rt) -> rtDispatch(rt, MsgSetHidden(hiddenInt != 0)),
        None -> (),
    }

pub def tf_lab_state_json(): String =
    match cellGet(runtimeRef) {
        Some(rt) -> buildLabStateJson(rtModel(rt)),
        None -> "{}",
    }

def main(): Void =
    if (argCount() > 1) runClientCli()
    else ()
