    match cellGet(globalModelRef) {
        None -> (),
        Some(m0) -> {
            let m1 = setDocumentHidden(hiddenInt != 0, m0);
            let m2 = flushState(m1);
            cellSet(globalModelRef, Some(m2))
        },
    }

