// ----------------------------------------------------------------------------
// 5. Deterministic Hash Mixing & Selection
// ----------------------------------------------------------------------------

def nextSeed(s: Int): Int = {
    let x = if (s < 0) -s else s;
    let m = floorMod(x * 1103515245 + 12345, 2147483647);
    if (m < 0) -m else m
}

def pickFrom(xs: List String, s: Int): String = {
    let n = listLen(xs);
    if (n <= 0) "沈青蝉"
    else listNthOr(xs, floorMod(s, n), "沈青蝉")
}

def hashString(txt: String): Int =
    utf8FoldCodepoints(txt, 216613626, (acc, cp) -> floorMod(acc * 33 + cp + 7, 2147483647))

def rollOnce(style: String, seed0: Int): String = {
    let s1 = nextSeed(seed0);
    let s2 = nextSeed(s1);
    let s3 = nextSeed(s2);
    let s4 = nextSeed(s3);

    // Resolve effective bucket: "male", "female", or "unisex"
    let bucket =
        if (style == "male") (if (floorMod(s1, 100) < 18) "unisex" else "male")
        else if (style == "female") (if (floorMod(s1, 100) < 18) "unisex" else "female")
        else if (style == "unisex") "unisex"
        else {
            let b = floorMod(s1, 3);
            if (b == 0) "male" else if (b == 1) "female" else "unisex"
        };

    // 20% curated full name, 80% high-taste surname + given-name combination
    if (floorMod(s2, 100) < 20) {
        if (bucket == "male") pickFrom(curatedMaleNames(), s3)
        else if (bucket == "female") pickFrom(curatedFemaleNames(), s3)
        else pickFrom(curatedUnisexNames(), s3)
    } else {
        // 8% restrained compound surname, 92% classic single surname
        let useCompound = floorMod(s2, 100) >= 92;
        let sur =
            if (useCompound) pickFrom(compoundSurnames(), s3)
            else pickFrom(singleSurnames(), s3);

        // Single surnames get 22% crisp two-char names; compound surnames get 28% three-char names
        let singleChance = if (useCompound) 28 else 22;
        let useSingle = floorMod(s3, 100) < singleChance;
        let given =
            if (useSingle) {
                if (bucket == "male") pickFrom(maleSingleGiven(), s4)
                else if (bucket == "female") pickFrom(femaleSingleGiven(), s4)
                else pickFrom(unisexSingleGiven(), s4)
            } else {
                if (bucket == "male") pickFrom(maleDoubleGiven(), s4)
                else if (bucket == "female") pickFrom(femaleDoubleGiven(), s4)
                else pickFrom(unisexDoubleGiven(), s4)
            };
        sur + given
    }
}

pub def rollWuxiaName(style: String, seed: Int, avoidName: String): String = {
    let mixed = nextSeed(seed + hashString(avoidName) + hashString(style));
    let first = rollOnce(style, mixed);
    if (first != avoidName) first
    else rollOnce(style, nextSeed(mixed + 104729))
}
