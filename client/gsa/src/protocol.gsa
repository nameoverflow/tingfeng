pub data CombatResult {
    ResHit,
    ResDodge,
    ResParry,
    ResEffect,
}

def resRank(r: CombatResult): Int = match r {
    ResHit -> 0,
    ResDodge -> 1,
    ResParry -> 2,
    ResEffect -> 3,
}

pub def combatResEq(a: CombatResult, b: CombatResult): Bool = resRank(a) == resRank(b)

instance Ord CombatResult {
    def compare(a, b) = compare(resRank(a), resRank(b))
}

pub def combatResultText(r: CombatResult): String = match r {
    ResHit -> "hit",
    ResDodge -> "dodge",
    ResParry -> "parry",
    ResEffect -> "effect",
}

pub def parseCombatResult(raw: String): CombatResult = match raw {
    "dodge" -> ResDodge,
    "parry" -> ResParry,
    "effect" -> ResEffect,
    _ -> ResHit,
}

pub data CombatHit {
    MkCombatHit {
        chResult: CombatResult,
        chDamage: Option Int,
        chHeal: Option Int,
    },
}

