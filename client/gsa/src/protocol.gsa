// Network Protocol Models & 100% Aeson-Compatible Wire Codecs (`protocol`).
// Built on Geisha's `std.codec` combinators (`:=`, `object`, `Decoder`) and `Monoid` algebra.

use std.option.{Option, Some, None}
use std.result.{Result, Ok, Err}
use std.codec.{
    Value, VNull, VBool, VInt, VFloat, VStr, VArr, VObj,
    object, (:=),
    Decoder, run, makeErr
}
use std.json.{parse, stringify}
use prelude.{
    Ord, Ordering, Lt, EqOrd, Gt, compare,
    Semigroup, (<+>), Monoid, empty,
    maxInt, maxFloat, roundInt, listFilterMap
}
use ordmap.{OrdMap, mapEmpty, mapFromList}
use i18n.{Locale, Zh, En}

// ============================================================================
// Directions & Spatial Coordinates
// ============================================================================

pub data Direction {
    North,
    South,
    East,
    West,
    NorthEast,
    NorthWest,
    SouthEast,
    SouthWest,
}

def dirRank(d: Direction): Int = match d {
    North -> 0,
    South -> 1,
    East -> 2,
    West -> 3,
    NorthEast -> 4,
    NorthWest -> 5,
    SouthEast -> 6,
    SouthWest -> 7,
}

pub def dirEq(a: Direction, b: Direction): Bool = dirRank(a) == dirRank(b)

instance Ord Direction {
    def compare(a, b) = compare(dirRank(a), dirRank(b))
}

pub def directionText(d: Direction): String = match d {
    North -> "North",
    South -> "South",
    East -> "East",
    West -> "West",
    NorthEast -> "NorthEast",
    NorthWest -> "NorthWest",
    SouthEast -> "SouthEast",
    SouthWest -> "SouthWest",
}

pub def parseDirection(raw: String): Option Direction = match raw {
    "North" -> Some(North),
    "South" -> Some(South),
    "East" -> Some(East),
    "West" -> Some(West),
    "NorthEast" -> Some(NorthEast),
    "NorthWest" -> Some(NorthWest),
    "SouthEast" -> Some(SouthEast),
    "SouthWest" -> Some(SouthWest),
    _ -> None,
}

pub def directionLabel(loc: Locale, d: Direction): String = match loc {
    Zh -> match d {
        North -> "北",
        South -> "南",
        East -> "东",
        West -> "西",
        NorthEast -> "东北",
        NorthWest -> "西北",
        SouthEast -> "东南",
        SouthWest -> "西南",
    },
    En -> match d {
        North -> "N",
        South -> "S",
        East -> "E",
        West -> "W",
        NorthEast -> "NE",
        NorthWest -> "NW",
        SouthEast -> "SE",
        SouthWest -> "SW",
    },
}

pub def directionGridDelta(d: Direction): (Int, Int) = match d {
    North -> (0, 1),
    South -> (0, -1),
    East -> (1, 0),
    West -> (-1, 0),
    NorthEast -> (1, 1),
    NorthWest -> (-1, 1),
    SouthEast -> (1, -1),
    SouthWest -> (-1, -1),
}

// ============================================================================
// Client -> Server: `PlayerAction` & Login Requests
// ============================================================================

pub data PlayerAction {
    ActGo(Direction),
    ActTalk(String),
    ActAttack(String),
    ActPerform(String),
    ActTrain(String),
    ActPractice(String, Int),
    ActLearn(String, String, Int),
    ActStudy(String, Int),
    ActResearch(String, Int),
    ActMeditate(Int, Int),
    ActEnable(String, String),
    ActPrepare(String, String),
    ActEquip(String),
    ActUnequip(String),
    ActBuy(Option String, String),
    ActUse(String),
    ActSay(String),
    ActOther(String),
}

pub data CreationBonus {
    MkCreationBonus {
        cbStrength: Int,
        cbAgilityValue: Int,
        cbVitality: Int,
        cbMaxQiBonus: Int,
        cbAppearance: Int,
    },
}

pub def emptyBonus(): CreationBonus = MkCreationBonus {
    cbStrength: 0,
    cbAgilityValue: 0,
    cbVitality: 0,
    cbMaxQiBonus: 0,
    cbAppearance: 0,
}

pub def addBonus(a: CreationBonus, b: CreationBonus): CreationBonus = MkCreationBonus {
    cbStrength: a.cbStrength + b.cbStrength,
    cbAgilityValue: a.cbAgilityValue + b.cbAgilityValue,
    cbVitality: a.cbVitality + b.cbVitality,
    cbMaxQiBonus: a.cbMaxQiBonus + b.cbMaxQiBonus,
    cbAppearance: a.cbAppearance + b.cbAppearance,
}

instance Semigroup CreationBonus {
    def (<+>)(a, b) = addBonus(a, b)
}

instance Monoid CreationBonus {
    def empty() = emptyBonus()
}

pub data CreationOption {
    MkCreationOption {
        coId: String,
        coLabel: String,
        coStory: String,
        coBonus: CreationBonus,
    },
}

pub data CreationConfig {
    MkCreationConfig {
        cfgBaseStats: CreationBonus,
        cfgGenders: List (String, String),
        cfgOrigins: List CreationOption,
        cfgChildhood1: List CreationOption,
        cfgChildhood2: List CreationOption,
    },
}

pub data CreationChoice {
    MkCreationChoice {
        ccGender: String,
        ccOrigin: String,
        ccChildhood1: String,
        ccChildhood2: String,
    },
}

pub def encodeLogin(user: String, pass: String, mChoice: Option CreationChoice): String = {
    let creationVal = match mChoice {
        None -> VNull,
        Some(cc) -> object([
            "gender" := cc.ccGender,
            "origin" := cc.ccOrigin,
            "childhood1" := cc.ccChildhood1,
            "childhood2" := cc.ccChildhood2,
        ]),
    };
    stringify(object([
        "tag" := "Login",
        "username" := user,
        "password" := pass,
        "creation" := creationVal,
    ]))
}

pub def encodeRequestCreationConfig(): String =
    stringify(object(["tag" := "RequestCharacterCreationConfig"]))

def encodeActionBody(act: PlayerAction): Value = match act {
    ActGo(dir) -> object(["go" := directionText(dir)]),
    ActTalk(cid) -> object(["talk" := cid]),
    ActAttack(cid) -> object(["attack" := cid]),
    ActPerform(sid) -> object(["perform" := sid]),
    ActTrain(aid) -> object(["train" := aid]),
    ActPractice(aid, n) -> object(["practice" := object(["art" := aid, "times" := n])]),
    ActLearn(tid, aid, n) -> object(["learn" := object(["teacher" := tid, "art" := aid, "times" := n])]),
    ActStudy(iid, n) -> object(["study" := object(["item" := iid, "times" := n])]),
    ActResearch(aid, n) -> object(["research" := object(["art" := aid, "times" := n])]),
    ActMeditate(amt, n) -> object(["meditate" := object(["amount" := amt, "times" := n])]),
    ActEnable(ty, aid) -> object(["enable" := object(["type" := ty, "art" := aid])]),
    ActPrepare(ty, aid) -> object(["prepare" := object(["type" := ty, "art" := aid])]),
    ActEquip(iid) -> object(["equip" := iid]),
    ActUnequip(slot) -> object(["unequip" := slot]),
    ActBuy(mMerch, iid) -> match mMerch {
        None -> object(["buy" := object(["item" := iid])]),
        Some(merch) -> object(["buy" := object(["item" := iid, "merchant" := merch])]),
    },
    ActUse(iid) -> object(["use" := iid]),
    ActSay(msg) -> object(["say" := msg]),
    ActOther(cmd) -> object(["other" := cmd]),
}

pub def encodePlayerAction(act: PlayerAction): String =
    stringify(object([
        "tag" := "NetPlayerAction",
        "contents" := encodeActionBody(act),
    ]))

