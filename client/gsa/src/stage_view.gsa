// 2D Game Stage Renderers (`stage_view`) built directly on `kagura.gfx.DrawList` & `kagura.ui`.
// Renders Xuan-paper parallax ink mountains, ink-silhouette martial artists,
// 3-pass Song-Dynasty cartographic maps, combat choreography, and the 41-pose inspector grid.

use std.option.{Option, Some, None}
use std.list.{listLen, listMap, listRev}
use std.vec.{Vec, vecNew, vecPush, vecToList}
use std.str.intToStr
use kagura.gfx.{
    Vec2, vec2, Rect, rect,
    Color, rgba, hexColor, withAlpha,
    AlignCenter, fontSans, fontSerif,
    sin, cos, absFloat, minInt, maxInt, minFloat, maxFloat, clampFloat, floorInt,
    DrawList, drawCard, drawRect, drawFillRect, drawCircle, drawEllipse,
    drawLine, drawPolygon, drawRibbon, drawText,
    pushClip, pushCircleClip, popClip, pushTransform, popTransform
}
use kagura.ui.{
    Element, CanvasHit, canvasHit, fillSpace, canvasStage
}
use prelude.{fmodPos, optOr, optIsSome, listFind, utf8CharCount}
use ordmap.{mapLookup, mapFromList}
use i18n.tr
use protocol.{
    Direction, dirEq, directionText, directionLabel, directionGridDelta,
    RoomExit, MapRoom, MapEdge, MapOverview,
    CombatResult, ResHit, ResDodge, ResParry, ResEffect
}
use pose.{
    CombatStyle, StyleFist, StyleSword, styleEq, parseCombatStyle,
    VisualProfile, ProfileMale, ProfileFemale, parseVisualProfile,
    LookStyle, SvgPose, ShapePrim, SCircle, SPoly,
    allPoseIds, svgPose, blendPose, swordTipOf, buildActorParts
}
use catalog.{MkFrameHold, idleActionIdForStyle}
use battle.{
    SidePlayer, SideEnemy, sideEq, sideHome,
    ActorVisual, MkActorVisual, sampleSvgPose, sampleBattleScene
}
use state.{ClientModel, worldPosFromGrid}
use theme.{ClientMsg, MsgGoExit}

// ============================================================================
// 1. Parallax Ink-Wash Mountains & Xuan-Paper Dust Motes
// ============================================================================

def drawMountainRidge(
    dl: DrawList,
    vp: Rect,
    yBase: Float,
    amp: Float,
    parallax: Float,
    camShiftX: Float,
    col: Color
): Void = {
    let step = 32.0;
    let ptsRev: Cell (List Vec2) = cellNew([vec2(vp.rx, vp.ry + vp.rh)]);
    let xCell = cellNew(vp.rx);
    while (cellGet(xCell) <= vp.rx + vp.rw + step) {
        let x = minFloat(vp.rx + vp.rw, cellGet(xCell));
        let wx = (x + camShiftX * parallax) * 0.0052;
        let wave = sin(wx) * 0.52 + sin(wx * 2.1 + 1.3) * 0.30 + cos(wx * 3.7 + 0.6) * 0.18;
        let y = yBase - wave * amp;
        cellSet(ptsRev, Cons(vec2(x, y), cellGet(ptsRev)));
        cellSet(xCell, cellGet(xCell) + step)
    };
    let pts = listRev(Cons(vec2(vp.rx + vp.rw, vp.ry + vp.rh), cellGet(ptsRev)));
    drawPolygon(dl, pts, col, 0, 0.0)
}

pub def drawAtmosphere(dl: DrawList, vp: Rect, m: ClientModel): Void = {
    let w = vp.rw;
    let h = vp.rh;
    let tSec = m.cmVp.vpClockMs / 1000.0;
    let camShiftX = m.cmCam.camX - m.cmCam.panX;
    let camShiftY = m.cmCam.camY - m.cmCam.panY;

    drawMountainRidge(dl, vp, h * 0.50, 40.0, 0.05, camShiftX, rgba(159, 154, 142, 34));
    drawMountainRidge(dl, vp, h * 0.62, 26.0, 0.11, camShiftX + 280.0, rgba(135, 131, 119, 38));
    drawMountainRidge(dl, vp, h * 0.74, 18.0, 0.19, camShiftX + 560.0, rgba(113, 108, 97, 42));

    if (!m.cmVp.vpReducedMotion) {
        let i = cellNew(1);
        while (cellGet(i) <= 10) {
            let idx = cellGet(i);
            let fi = intToFloat(idx);
            let mx = fmodPos(fi * 211.3 - camShiftX * 0.18 + tSec * (6.5 + intToFloat(idx % 3) * 2.5), w);
            let my = fmodPos(fi * 137.7 - camShiftY * 0.12 + sin(tSec * 0.55 + fi) * 12.0, h * 0.72);
            let mr = 1.1 + intToFloat(idx % 3) * 0.65;
            let ma = 0.07 + 0.03 * sin(tSec * 0.9 + fi);
            drawCircle(dl, mx, my, mr, withAlpha(hexColor("#6e6354"), ma), 0, 0.0);
            cellSet(i, idx + 1)
        }
    } else ()
}

// ============================================================================
// 2. Ink-Silhouette Martial Artist Renderer on Binary `DrawList`
// ============================================================================

def polyToVec2List(pts: List (Float, Float)): List Vec2 =
    listMap(pts, (xy) -> match xy { (px, py) -> vec2(px, py) })

def emitShapeStroke(dl: DrawList, s: ShapePrim, strokeCol: Color): Void = match s {
    SCircle(cx, cy, r, _, _) -> drawCircle(dl, cx, cy, r, 0, strokeCol, 3.8),
    SPoly(pts, _, _) -> drawPolygon(dl, polyToVec2List(pts), 0, strokeCol, 3.8),
}

def emitShapeFill(dl: DrawList, s: ShapePrim, defaultFill: Color, flash: Float, partAlpha: Float): Void = {
    let hitCol = hexColor("#a32c22");
    match s {
        SCircle(cx, cy, r, mFill, op) -> {
            let base = if (flash > 0.2) hitCol else match mFill { Some(h) -> hexColor(h), None -> defaultFill };
            drawCircle(dl, cx, cy, r, withAlpha(base, op * partAlpha), 0, 0.0)
        },
        SPoly(pts, mFill, op) -> {
            let base = if (flash > 0.2) hitCol else match mFill { Some(h) -> hexColor(h), None -> defaultFill };
            drawPolygon(dl, polyToVec2List(pts), withAlpha(base, op * partAlpha), 0, 0.0)
        },
    }
}

pub def drawInkActor(
    dl: DrawList,
    wx: Float, wy: Float,
    scaleSign: Float, rotDeg: Float,
    fillCol: Color, outlineCol: Color,
    flash: Float, alpha: Float,
    pose: SvgPose, style: CombatStyle, prof: VisualProfile, look: LookStyle,
    hairFlow: (Float, Float), clockMs: Float
): Void = {
    let parts = buildActorParts(pose, style, prof, look, hairFlow, clockMs);
    pushTransform(dl, wx, wy, scaleSign, absFloat(scaleSign), rotDeg);
    let outCol = withAlpha(outlineCol, alpha);
    let pcur = cellNew(parts);
    while (match cellGet(pcur) { Nil -> false, _ -> true }) {
        match cellGet(pcur) {
            Cons(part, prest) -> {
                // Pass A: outer halo stroke across all shapes of the body part
                let s1 = cellNew(part.apShapes);
                while (match cellGet(s1) { Nil -> false, _ -> true }) {
                    match cellGet(s1) {
                        Cons(sh, srest) -> {
                            emitShapeStroke(dl, sh, outCol);
                            cellSet(s1, srest)
                        },
                        Nil -> (),
                    }
                };
                // Pass B: unified silhouette fill
                let s2 = cellNew(part.apShapes);
                while (match cellGet(s2) { Nil -> false, _ -> true }) {
                    match cellGet(s2) {
                        Cons(sh, srest) -> {
                            emitShapeFill(dl, sh, fillCol, flash, alpha);
                            cellSet(s2, srest)
                        },
                        Nil -> (),
                    }
                };
                // Pass C: circular joint patch fills (`OP_PUSH_CIRCLE_CLIP`)
                let jcur = cellNew(part.apJoins);
                while (match cellGet(jcur) { Nil -> false, _ -> true }) {
                    match cellGet(jcur) {
                        Cons(jn, jrest) -> {
                            let (jx, jy) = jn.jpAt;
                            pushCircleClip(dl, jx, jy, jn.jpRadius);
                            let js = cellNew(jn.jpShapes);
                            while (match cellGet(js) { Nil -> false, _ -> true }) {
                                match cellGet(js) {
                                    Cons(sh, jsrest) -> {
                                        emitShapeFill(dl, sh, fillCol, flash, alpha);
                                        cellSet(js, jsrest)
                                    },
                                    Nil -> (),
                                }
                            };
                            popClip(dl);
                            cellSet(jcur, jrest)
                        },
                        Nil -> (),
                    }
                };
                cellSet(pcur, prest)
            },
            Nil -> (),
        }
    };
    popTransform(dl)
}

// ============================================================================
// 3. Stage 1: Calm Onboarding Backdrop
// ============================================================================

pub def renderOnboardingStage(stageRect: Rect, _ptr: Vec2, dl: DrawList, m: ClientModel): List (CanvasHit ClientMsg) = {
    drawAtmosphere(dl, stageRect, m);
    let w = stageRect.rw;
    let h = stageRect.rh;
    let breath = if (m.cmVp.vpReducedMotion) 0.1 else sin(m.cmVp.vpClockMs / 540.0) * 0.14 + 0.14;
    let cc = m.cmAuth.auCreateChoice;
    let prof = if (m.cmAuth.auLoginMode == "create") parseVisualProfile(cc.ccGender) else ProfileFemale;
    let pose = blendPose(m.cmPoseLib, "idle", "guard", breath, StyleSword);
    let ax = stageRect.rx + (if (w > 960.0) w * 0.80 else w * 0.50);
    let ay = stageRect.ry + (if (w > 960.0) h * 0.66 else h * 0.88);
    let sc = if (w > 960.0) 1.04 else 0.72;
    drawCircle(dl, ax, ay - 84.0, 116.0, withAlpha(hexColor("#dfd4be"), 0.48), 0, 0.0);
    drawInkActor(
        dl, ax, ay, sc, 0.0,
        hexColor("#cfc4af"), hexColor("#ece4d2"),
        0.0, 0.96, pose, StyleSword, prof, m.cmVp.vpLookStyle,
        (0.0, 0.0), m.cmVp.vpClockMs
    );
    Nil
}

// ============================================================================
// 4. Stage 2: 3-Pass Song-Dynasty Cartographic Map Stage
// ============================================================================

def posEq(a: (Int, Int), b: (Int, Int)): Bool = match (a, b) {
    ((x1, y1), (x2, y2)) -> x1 == x2 && y1 == y2,
}

def posLess(a: (Int, Int), b: (Int, Int)): Bool = match (a, b) {
    ((x1, y1), (x2, y2)) -> x1 < x2 || (x1 == x2 && y1 < y2),
}

def dirInList(ds: List Direction, target: Direction): Bool = match ds {
    Nil -> false,
    Cons(h, t) -> if (dirEq(h, target)) true else dirInList(t, target),
}

def rectBorderPoint(cx: Float, cy: Float, hw: Float, hh: Float, tx: Float, ty: Float): (Float, Float) = {
    let dx = tx - cx;
    let dy = ty - cy;
    let adx = absFloat(dx);
    let ady = absFloat(dy);
    if (adx < 0.01 && ady < 0.01) (cx, cy)
    else {
        let sx = if (adx > 0.01) hw / adx else 1000000.0;
        let sy = if (ady > 0.01) hh / ady else 1000000.0;
        let s = minFloat(sx, sy);
        (cx + dx * s, cy + dy * s)
    }
}

def roadMidpoint(
    cx: Float, cy: Float, cw: Float, ch: Float,
    tx: Float, ty: Float, tw: Float, th: Float
): (Float, Float) = {
    let (p1x, p1y) = rectBorderPoint(cx, cy, cw * 0.5, ch * 0.5, tx, ty);
    let (p2x, p2y) = rectBorderPoint(tx, ty, tw * 0.5, th * 0.5, cx, cy);
    ((p1x + p2x) * 0.5, (p1y + p2y) * 0.5)
}

data DirBadge {
    MkDirBadge {
        dbMx: Float,
        dbMy: Float,
        dbLabel: String,
        dbDir: Direction,
        dbIsCross: Bool,
        dbHovered: Bool,
    },
}

def exitHitKey(d: Direction): String = "exit:" + directionText(d)

def emitDirSeal(
    dl: DrawList,
    hitsOut: Vec (CanvasHit ClientMsg),
    storyLocked: Bool,
    db: DirBadge
): Void = {
    let nChars = utf8CharCount(db.dbLabel);
    let pw = maxFloat(19.0, intToFloat(nChars) * 10.5 + 8.5);
    let ph = 16.5;
    let bx = db.dbMx - pw * 0.5;
    let by = db.dbMy - ph * 0.5;
    let bg = if (db.dbHovered) hexColor("#fbf6ea") else if (db.dbIsCross) hexColor("#f5ead4") else hexColor("#f7f1e3");
    let bd = if (db.dbHovered) hexColor("#9e2a22") else if (db.dbIsCross) hexColor("#946623") else hexColor("#2a564a");
    let fg = if (db.dbHovered) hexColor("#9e2a22") else if (db.dbIsCross) hexColor("#7d5318") else hexColor("#224a3f");
    drawRect(dl, rect(bx, by, pw, ph), 3.5, withAlpha(bg, 0.99), bd, 0.85);
    drawText(dl, db.dbMx, db.dbMy + 3.7, fontSans(10.0, 700), AlignCenter, fg, db.dbLabel);
    if (!storyLocked) {
        vecPush(hitsOut, canvasHit(rect(bx, by, pw, ph), exitHitKey(db.dbDir), "pointer", MsgGoExit(db.dbDir)))
    } else ()
}

def roomPlaqueSize(name: String, isCur: Bool, isMobile: Bool, zoom: Float): (Float, Float, Float) = {
    let zScale = clampFloat(0.82, 1.15, zoom);
    let baseFont = if (isCur) (if (isMobile) 13.0 else 13.5) else (if (isMobile) 11.4 else 12.0);
    let fontSz = baseFont * zScale;
    let charPitch = fontSz + (if (isMobile) 1.2 else 1.8);
    let padW = if (isMobile) 20.0 else 26.0;
    let minW = if (isCur) (if (isMobile) 84.0 else 90.0) else (if (isMobile) 70.0 else 74.0);
    let nw = maxFloat(minW, intToFloat(utf8CharCount(name)) * charPitch + padW);
    let baseH = if (isCur) (if (isMobile) 33.0 else 35.0) else (if (isMobile) 28.0 else 30.0);
    let nh = baseH * clampFloat(0.84, 1.14, zoom);
    (fontSz, nw, nh)
}

def drawRoomPlaque(
    dl: DrawList,
    r: MapRoom,
    sx: Float, sy: Float,
    fontSz: Float, nw: Float, nh: Float,
    isCur: Bool, isReachable: Bool, hov: Bool,
    pulse: Float, effZoom: Float
): Void = {
    let rx = sx - nw * 0.5;
    let ry = sy - nh * 0.5;
    let kindAccent = match r.mrRoomKind {
        "landmark" -> hexColor("#9e2a22"),
        "transit" -> hexColor("#a67c37"),
        "building" -> hexColor("#8f8575"),
        _ -> hexColor("#b5aa98"),
    };
    let (fillTop, fillBot, bdCol, txtCol, lw, shBlur, useDbl) =
        if (isCur) (hexColor("#1c1915"), hexColor("#26211c"), hexColor("#b89552"), hexColor("#f8f4eb"), 1.1, 14.0, true)
        else if (hov) (hexColor("#fbf8f1"), hexColor("#f3ecdd"), hexColor("#9e2a22"), hexColor("#1c1915"), 1.1, 12.0, false)
        else if (isReachable) (hexColor("#faf6ee"), hexColor("#f2ebdc"), rgba(42, 86, 74, 118), hexColor("#1c1915"), 0.9, 8.0, false)
        else (hexColor("#f1eadc"), hexColor("#ebe2d0"), rgba(130, 118, 98, 76), hexColor("#6b6255"), 0.75, 0.0, false);

    if (isCur) {
        drawCircle(dl, sx, sy, 24.0 * pulse * effZoom, 0, withAlpha(hexColor("#b89552"), 0.28), 1.0)
    } else ();
    drawCard(
        dl, rect(rx, ry, nw, nh), 3.0,
        withAlpha(fillTop, 0.99), withAlpha(fillBot, 0.99),
        bdCol, lw,
        if (shBlur > 0.0) rgba(28, 22, 16, 28) else 0, 3.0, shBlur, useDbl
    );
    if (isCur) {
        drawCircle(dl, rx + 10.0, sy, 2.5, withAlpha(hexColor("#b33529"), 0.95), 0, 0.0)
    } else if (isReachable) {
        drawFillRect(dl, rect(rx + 1.0, ry + 5.0, 2.4, nh - 10.0), 1.0, withAlpha(hexColor("#2a564a"), 0.85))
    } else if (r.mrRoomKind == "landmark" || r.mrRoomKind == "transit") {
        drawCircle(dl, rx + 8.0, sy, 2.0, withAlpha(kindAccent, 0.55), 0, 0.0)
    } else ();
    drawText(
        dl,
        if (isCur) sx + 3.0 else sx,
        sy + fontSz * 0.35,
        fontSerif(fontSz, if (isCur) 700 else 600),
        AlignCenter,
        txtCol,
        r.mrRoomName
    )
}

pub def renderMapStage(
    stageRect: Rect,
    _ptr: Vec2,
    hoveredKey: String,
    dl: DrawList,
    m: ClientModel
): List (CanvasHit ClientMsg) = {
    let hitsOut: Vec (CanvasHit ClientMsg) = vecNew();
    let loc = m.cmVp.vpLocale;
    let isMobile = m.cmVp.vpWidth <= 768.0;
    let vx = stageRect.rx;
    let vy = stageRect.ry;
    let vw = stageRect.rw;
    let vh = stageRect.rh;
    let zoom = m.cmCam.mapZoom;
    let effZoom = zoom * (if (isMobile) 0.72 else 1.0);
    let baseCenterY =
        if (isMobile) vy + vh * 0.49
        else vy + maxFloat(160.0, vh - 196.0) * 0.54;
    let centerX = vx + vw * 0.5 + m.cmCam.panX - m.cmCam.camX * effZoom;
    let centerY = baseCenterY + m.cmCam.panY - m.cmCam.camY * effZoom;
    let tSec = m.cmVp.vpClockMs / 1000.0;
    let pulse = if (m.cmVp.vpReducedMotion) 1.0 else 1.0 + 0.12 * sin(tSec * 2.8);
    let storyLocked = m.cmWorld.wvStoryActive;
    let inFrustum = (sx: Float, sy: Float) ->
        sx >= vx - 180.0 && sx <= vx + vw + 180.0 && sy >= vy - 120.0 && sy <= vy + vh + 120.0;

    let rName = m.cmWorld.wvRoomName;
    let mapValid = (mo: MapOverview) ->
        !prelude.listIsEmpty(mo.moRooms)
            && (strLen(rName) == 0 || optIsSome(listFind(mo.moRooms, (r) -> posEq(r.mrPos, mo.moCurrentPos) && r.mrRoomName == rName)));

    match m.cmWorld.wvMapOverview {
        Some(mo) if (mapValid(mo)) -> {
            let curPos = mo.moCurrentPos;
            let (curWx, curWy) = worldPosFromGrid(curPos);
            let curSx = centerX + curWx * effZoom;
            let curSy = centerY + curWy * effZoom;
            let curDispName = match listFind(mo.moRooms, (r) -> posEq(r.mrPos, curPos)) {
                Some(cr) -> cr.mrRoomName,
                None -> rName,
            };
            let (_, curW, curH) = roomPlaqueSize(curDispName, true, isMobile, zoom);

            let sameMapExit = (e: RoomExit) -> strLen(e.reMapId) == 0 || e.reMapId == mo.moMapId;
            let exitByRoomId = mapFromList(prelude.listFilterMap(m.cmWorld.wvRoomExits, (e) ->
                if (sameMapExit(e) && strLen(e.reRoomId) > 0) Some((e.reRoomId, e.reDirection)) else None
            ));
            let exitByPos = mapFromList(prelude.listFilterMap(m.cmWorld.wvRoomExits, (e) ->
                if (sameMapExit(e)) match e.rePos { Some(p) -> Some((p, e.reDirection)), None -> None }
                else None
            ));

            let preCovered: Cell (List Direction) = cellNew(Nil);
            let prCur = cellNew(mo.moRooms);
            while (match cellGet(prCur) { Nil -> false, _ -> true }) {
                match cellGet(prCur) {
                    Cons(r, rest) -> {
                        let mDir = match mapLookup(exitByRoomId, r.mrRoomId) {
                            Some(d) -> Some(d),
                            None -> mapLookup(exitByPos, r.mrPos),
                        };
                        match mDir {
                            Some(d) -> cellSet(preCovered, Cons(d, cellGet(preCovered))),
                            None -> (),
                        };
                        cellSet(prCur, rest)
                    },
                    Nil -> (),
                }
            };
            let peCur = cellNew(mo.moEdges);
            while (match cellGet(peCur) { Nil -> false, _ -> true }) {
                match cellGet(peCur) {
                    Cons(e, rest) -> {
                        if (strLen(e.meToMapId) > 0 && e.meToMapId != mo.moMapId && posEq(e.meFrom, curPos)) {
                            if (optIsSome(listFind(m.cmWorld.wvRoomExits, (ex) -> dirEq(ex.reDirection, e.meDirection)))) {
                                cellSet(preCovered, Cons(e.meDirection, cellGet(preCovered)))
                            } else ()
                        } else ();
                        cellSet(peCur, rest)
                    },
                    Nil -> (),
                }
            };
            let coveredDirsList = cellGet(preCovered);

            // PASS 1: Roads & cross-map portal dashed lines
            let isSameEdge = (e: MapEdge) -> strLen(e.meToMapId) == 0 || e.meToMapId == mo.moMapId;
            let ecur = cellNew(mo.moEdges);
            while (match cellGet(ecur) { Nil -> false, _ -> true }) {
                match cellGet(ecur) {
                    Cons(e, rest) -> {
                        if (isSameEdge(e)) {
                            let hasReverse = optIsSome(listFind(mo.moEdges, (r) ->
                                isSameEdge(r) && posEq(r.meFrom, e.meTo) && posEq(r.meTo, e.meFrom)
                            ));
                            if (posLess(e.meFrom, e.meTo) || !hasReverse) {
                                let (x1, y1) = worldPosFromGrid(e.meFrom);
                                let (x2, y2) = worldPosFromGrid(e.meTo);
                                let sx1 = centerX + x1 * effZoom;
                                let sy1 = centerY + y1 * effZoom;
                                let sx2 = centerX + x2 * effZoom;
                                let sy2 = centerY + y2 * effZoom;
                                if (inFrustum(sx1, sy1) || inFrustum(sx2, sy2)) {
                                    let isNear = posEq(e.meFrom, curPos) || posEq(e.meTo, curPos);
                                    let col = if (isNear) withAlpha(hexColor("#2a564a"), 0.76) else withAlpha(hexColor("#8f8575"), 0.34);
                                    let lw = (if (isNear) 1.8 else 0.95) * minFloat(1.2, zoom);
                                    drawLine(dl, sx1, sy1, sx2, sy2, lw, col, false)
                                } else ()
                            } else ()
                        } else {
                            let (wx0, wy0) = worldPosFromGrid(e.meFrom);
                            let sx1 = centerX + wx0 * effZoom;
                            let sy1 = centerY + wy0 * effZoom;
                            if (inFrustum(sx1, sy1)) {
                                let (fx, fy) = e.meFrom;
                                let (dgx, dgy) = directionGridDelta(e.meDirection);
                                let (x2, y2) = worldPosFromGrid((fx + dgx, fy + dgy));
                                let sx2 = centerX + x2 * effZoom;
                                let sy2 = centerY + y2 * effZoom;
                                let isFromCur = posEq(e.meFrom, curPos)
                                    && optIsSome(listFind(m.cmWorld.wvRoomExits, (ex) -> dirEq(ex.reDirection, e.meDirection)));
                                let lw = if (isFromCur) 1.6 else 1.1;
                                let al = if (isFromCur) 0.88 else 0.52;
                                drawLine(dl, sx1, sy1, sx2, sy2, lw, withAlpha(hexColor("#946623"), al), true)
                            } else ()
                        };
                        cellSet(ecur, rest)
                    },
                    Nil -> (),
                }
            };

            let xlCur = cellNew(m.cmWorld.wvRoomExits);
            while (match cellGet(xlCur) { Nil -> false, _ -> true }) {
                match cellGet(xlCur) {
                    Cons(ex, rest) -> {
                        let d = ex.reDirection;
                        if (!dirInList(coveredDirsList, d)) {
                            let (cpx, cpy) = curPos;
                            let (dgx, dgy) = directionGridDelta(d);
                            let (tx0, ty0) = worldPosFromGrid((cpx + dgx, cpy + dgy));
                            let sx2 = centerX + tx0 * effZoom;
                            let sy2 = centerY + ty0 * effZoom;
                            let isCross = strLen(ex.reMapId) > 0 && ex.reMapId != mo.moMapId;
                            let lCol = if (isCross) hexColor("#946623") else hexColor("#2b594b");
                            drawLine(dl, curSx, curSy, sx2, sy2, 1.7, withAlpha(lCol, 0.80), isCross)
                        } else ();
                        cellSet(xlCur, rest)
                    },
                    Nil -> (),
                }
            };

            // PASS 2: Plaques (current room plaque topmost)
            let badgesVec: Vec DirBadge = vecNew();
            let curRoomOpt: Cell (Option MapRoom) = cellNew(None);

            let rcur = cellNew(mo.moRooms);
            while (match cellGet(rcur) { Nil -> false, _ -> true }) {
                match cellGet(rcur) {
                    Cons(r, rest) -> {
                        let pos = r.mrPos;
                        if (posEq(pos, curPos)) {
                            cellSet(curRoomOpt, Some(r))
                        } else {
                            let (wx, wy) = worldPosFromGrid(pos);
                            let sx = centerX + wx * effZoom;
                            let sy = centerY + wy * effZoom;
                            if (inFrustum(sx, sy)) {
                                let mDir = match mapLookup(exitByRoomId, r.mrRoomId) {
                                    Some(d) -> Some(d),
                                    None -> mapLookup(exitByPos, pos),
                                };
                                let hov = match mDir {
                                    Some(d) -> !storyLocked && hoveredKey == exitHitKey(d),
                                    None -> false,
                                };
                                let (fontSz, nw, nh) = roomPlaqueSize(r.mrRoomName, false, isMobile, zoom);
                                drawRoomPlaque(dl, r, sx, sy, fontSz, nw, nh, false, optIsSome(mDir), hov, pulse, effZoom);
                                match mDir {
                                    Some(d) -> {
                                        let (mx, my) = roadMidpoint(curSx, curSy, curW, curH, sx, sy, nw, nh);
                                        vecPush(badgesVec, MkDirBadge {
                                            dbMx: mx, dbMy: my,
                                            dbLabel: directionLabel(loc, d),
                                            dbDir: d, dbIsCross: false, dbHovered: hov,
                                        });
                                        if (!storyLocked) {
                                            vecPush(hitsOut, canvasHit(rect(sx - nw * 0.5, sy - nh * 0.5, nw, nh), exitHitKey(d), "pointer", MsgGoExit(d)))
                                        } else ()
                                    },
                                    None -> (),
                                }
                            } else ()
                        };
                        cellSet(rcur, rest)
                    },
                    Nil -> (),
                }
            };

            let pcur = cellNew(mo.moEdges);
            while (match cellGet(pcur) { Nil -> false, _ -> true }) {
                match cellGet(pcur) {
                    Cons(e, rest) -> {
                        if (strLen(e.meToMapId) > 0 && e.meToMapId != mo.moMapId) {
                            let (wx0, wy0) = worldPosFromGrid(e.meFrom);
                            let sx1 = centerX + wx0 * effZoom;
                            let sy1 = centerY + wy0 * effZoom;
                            if (inFrustum(sx1, sy1)) {
                                let d = e.meDirection;
                                let (fx, fy) = e.meFrom;
                                let (dgx, dgy) = directionGridDelta(d);
                                let (x2, y2) = worldPosFromGrid((fx + dgx, fy + dgy));
                                let sx2 = centerX + x2 * effZoom;
                                let sy2 = centerY + y2 * effZoom;
                                let isFromCur = posEq(e.meFrom, curPos)
                                    && optIsSome(listFind(m.cmWorld.wvRoomExits, (ex) -> dirEq(ex.reDirection, d)));
                                let hov = isFromCur && !storyLocked && hoveredKey == exitHitKey(d);
                                let destRoom =
                                    if (strLen(e.meToRoomName) > 0) e.meToRoomName
                                    else if (strLen(e.meToMapName) > 0) e.meToMapName
                                    else e.meToMapId;
                                let labelTxt = "⇄ " + destRoom;
                                let fontSz = (if (isMobile) 11.4 else 12.0) * clampFloat(0.82, 1.14, zoom);
                                let nw = maxFloat(if (isMobile) 80.0 else 86.0, intToFloat(utf8CharCount(labelTxt)) * (fontSz + 1.2) + 22.0);
                                let nh = (if (isMobile) 28.0 else 30.0) * clampFloat(0.85, 1.12, zoom);
                                let rx = sx2 - nw * 0.5;
                                let ry = sy2 - nh * 0.5;
                                let bg = if (hov) hexColor("#ebdcb9") else if (isFromCur) hexColor("#f3e8cf") else hexColor("#e9dfca");
                                let bd = if (hov) hexColor("#a32c22") else if (isFromCur) hexColor("#946623") else hexColor("#9c8760");
                                let txtCol = if (isFromCur) hexColor("#4f320d") else hexColor("#6f5d42");
                                let lw = if (isFromCur) 1.5 else 1.05;

                                drawRect(dl, rect(rx, ry, nw, nh), 3.0, withAlpha(bg, 0.99), bd, lw);
                                drawText(dl, sx2, sy2 + fontSz * 0.36, fontSans(fontSz, 600), AlignCenter, txtCol, labelTxt);
                                if (strLen(e.meToMapName) > 0 && e.meToMapName != destRoom) {
                                    let subW = maxFloat(44.0, intToFloat(utf8CharCount(e.meToMapName)) * 10.6 + 10.0);
                                    let subY = if (sy2 < sy1 - 4.0) ry - 16.5 else ry + nh + 2.5;
                                    drawFillRect(dl, rect(sx2 - subW * 0.5, subY, subW, 14.0), 2.5, withAlpha(hexColor("#f5efe1"), 0.92));
                                    drawText(dl, sx2, subY + 10.2, fontSans(10.0, 600), AlignCenter, withAlpha(hexColor("#8a5d1c"), 0.92), e.meToMapName)
                                } else ();
                                if (isFromCur) {
                                    let (mx, my) = roadMidpoint(curSx, curSy, curW, curH, sx2, sy2, nw, nh);
                                    vecPush(badgesVec, MkDirBadge {
                                        dbMx: mx, dbMy: my,
                                        dbLabel: directionLabel(loc, d),
                                        dbDir: d, dbIsCross: true, dbHovered: hov,
                                    });
                                    if (!storyLocked) {
                                        vecPush(hitsOut, canvasHit(rect(rx, ry, nw, nh), exitHitKey(d), "pointer", MsgGoExit(d)))
                                    } else ()
                                } else ()
                            } else ()
                        } else ();
                        cellSet(pcur, rest)
                    },
                    Nil -> (),
                }
            };

            let xcur = cellNew(m.cmWorld.wvRoomExits);
            while (match cellGet(xcur) { Nil -> false, _ -> true }) {
                match cellGet(xcur) {
                    Cons(ex, rest) -> {
                        let d = ex.reDirection;
                        if (!dirInList(coveredDirsList, d)) {
                            let (cpx, cpy) = curPos;
                            let (dgx, dgy) = directionGridDelta(d);
                            let (tx0, ty0) = worldPosFromGrid((cpx + dgx, cpy + dgy));
                            let sx2 = centerX + tx0 * effZoom;
                            let sy2 = centerY + ty0 * effZoom;
                            let hov = !storyLocked && hoveredKey == exitHitKey(d);
                            let isCross = strLen(ex.reMapId) > 0 && ex.reMapId != mo.moMapId;
                            let lbl = (if (isCross) "⇄ " else "") + ex.reRoomName;
                            let ew = maxFloat(76.0, intToFloat(utf8CharCount(lbl)) * 13.0 + 22.0);
                            let eh = if (isMobile) 28.0 else 30.0;
                            let rx = sx2 - ew * 0.5;
                            let ry = sy2 - eh * 0.5;
                            let bg = if (hov) hexColor("#efe4cc") else if (isCross) hexColor("#f3e8cf") else hexColor("#f8f3e6");
                            let bd = if (hov) hexColor("#946623") else if (isCross) hexColor("#946623") else hexColor("#2b594b");
                            drawRect(dl, rect(rx, ry, ew, eh), 3.0, withAlpha(bg, 0.99), bd, 1.5);
                            drawText(dl, sx2, sy2 + 4.3, fontSans(11.8, 600), AlignCenter, hexColor("#1e1a16"), lbl);
                            let (mx, my) = roadMidpoint(curSx, curSy, curW, curH, sx2, sy2, ew, eh);
                            vecPush(badgesVec, MkDirBadge {
                                dbMx: mx, dbMy: my,
                                dbLabel: directionLabel(loc, d),
                                dbDir: d, dbIsCross: isCross, dbHovered: hov,
                            });
                            if (!storyLocked) {
                                vecPush(hitsOut, canvasHit(rect(rx, ry, ew, eh), exitHitKey(d), "pointer", MsgGoExit(d)))
                            } else ()
                        } else ();
                        cellSet(xcur, rest)
                    },
                    Nil -> (),
                }
            };

            match cellGet(curRoomOpt) {
                Some(cr) ->
                    if (inFrustum(curSx, curSy)) {
                        let (fontSz, nw, nh) = roomPlaqueSize(cr.mrRoomName, true, isMobile, zoom);
                        drawRoomPlaque(dl, cr, curSx, curSy, fontSz, nw, nh, true, false, false, pulse, effZoom)
                    } else (),
                None -> (),
            };

            // PASS 3: Road-midpoint direction seal capsules
            let bcur = cellNew(vecToList(badgesVec));
            while (match cellGet(bcur) { Nil -> false, _ -> true }) {
                match cellGet(bcur) {
                    Cons(db, rest) -> {
                        emitDirSeal(dl, hitsOut, storyLocked, db);
                        cellSet(bcur, rest)
                    },
                    Nil -> (),
                }
            }
        },
        _ -> {
            let cx = vx + vw * 0.5 + m.cmCam.panX;
            let cy = baseCenterY + m.cmCam.panY;
            let dispRoom = if (strLen(rName) == 0) tr(loc, "app.title") else rName;
            let (curFont, curW, curH) = roomPlaqueSize(dispRoom, true, isMobile, zoom);

            let lcur = cellNew(m.cmWorld.wvRoomExits);
            while (match cellGet(lcur) { Nil -> false, _ -> true }) {
                match cellGet(lcur) {
                    Cons(ex, rest) -> {
                        let (wx, wy) = worldPosFromGrid(directionGridDelta(ex.reDirection));
                        let isCross = strLen(ex.reMapId) > 0;
                        let lCol = if (isCross) hexColor("#946623") else hexColor("#2a564a");
                        drawLine(dl, cx, cy, cx + wx * effZoom, cy + wy * effZoom, 1.7, withAlpha(lCol, 0.76), isCross);
                        cellSet(lcur, rest)
                    },
                    Nil -> (),
                }
            };

            let badgesVec: Vec DirBadge = vecNew();
            let xcur = cellNew(m.cmWorld.wvRoomExits);
            while (match cellGet(xcur) { Nil -> false, _ -> true }) {
                match cellGet(xcur) {
                    Cons(ex, rest) -> {
                        let d = ex.reDirection;
                        let (wx, wy) = worldPosFromGrid(directionGridDelta(d));
                        let exX = cx + wx * effZoom;
                        let exY = cy + wy * effZoom;
                        let (efont, ew, eh) = roomPlaqueSize(ex.reRoomName, false, isMobile, zoom);
                        let rx = exX - ew * 0.5;
                        let ry = exY - eh * 0.5;
                        let hov = !storyLocked && hoveredKey == exitHitKey(d);
                        let bg = if (hov) hexColor("#fbf8f1") else hexColor("#faf6ee");
                        let bd = if (hov) hexColor("#9e2a22") else rgba(42, 86, 74, 118);
                        drawCard(dl, rect(rx, ry, ew, eh), 3.0, withAlpha(bg, 0.99), withAlpha(hexColor("#f2ebdc"), 0.99), bd, 0.9, rgba(28, 22, 16, 24), 3.0, 8.0, false);
                        drawFillRect(dl, rect(rx + 1.0, ry + 5.0, 2.4, eh - 10.0), 1.0, withAlpha(hexColor("#2a564a"), 0.85));
                        drawText(dl, exX, exY + efont * 0.35, fontSerif(efont, 600), AlignCenter, hexColor("#1c1915"), ex.reRoomName);
                        let (mx, my) = roadMidpoint(cx, cy, curW, curH, exX, exY, ew, eh);
                        vecPush(badgesVec, MkDirBadge {
                            dbMx: mx, dbMy: my,
                            dbLabel: directionLabel(loc, d),
                            dbDir: d, dbIsCross: false, dbHovered: hov,
                        });
                        if (!storyLocked) {
                            vecPush(hitsOut, canvasHit(rect(rx, ry, ew, eh), exitHitKey(d), "pointer", MsgGoExit(d)))
                        } else ();
                        cellSet(xcur, rest)
                    },
                    Nil -> (),
                }
            };

            drawCircle(dl, cx, cy, 24.0 * pulse * effZoom, 0, withAlpha(hexColor("#b89552"), 0.28), 1.0);
            drawCard(dl, rect(cx - curW * 0.5, cy - curH * 0.5, curW, curH), 3.0, hexColor("#1c1915"), hexColor("#26211c"), hexColor("#b89552"), 1.1, rgba(28, 22, 16, 36), 3.0, 14.0, true);
            drawCircle(dl, cx - curW * 0.5 + 10.0, cy, 2.5, withAlpha(hexColor("#b33529"), 0.95), 0, 0.0);
            drawText(dl, cx + 3.0, cy + curFont * 0.35, fontSerif(curFont, 700), AlignCenter, hexColor("#f8f4eb"), dispRoom);

            let bcur = cellNew(vecToList(badgesVec));
            while (match cellGet(bcur) { Nil -> false, _ -> true }) {
                match cellGet(bcur) {
                    Cons(db, rest) -> {
                        emitDirSeal(dl, hitsOut, storyLocked, db);
                        cellSet(bcur, rest)
                    },
                    Nil -> (),
                }
            }
        },
    };

    // Story transition banner inside stage
    match m.cmWorld.wvTransitionBanner {
        None -> (),
        Some((txt, remMs)) -> {
            let al = minFloat(1.0, remMs / 350.0);
            let bw = minFloat(vw - 24.0, maxFloat(200.0, intToFloat(utf8CharCount(txt)) * 18.5 + 52.0));
            let by = vy + vh * 0.16;
            drawRect(dl, rect(vx + (vw - bw) * 0.5, by, bw, 42.0), 3.0, withAlpha(hexColor("#f7f1e3"), al * 0.97), withAlpha(hexColor("#a32c22"), al), 1.5);
            drawText(dl, vx + vw * 0.5, by + 27.0, fontSerif(16.0, 700), AlignCenter, withAlpha(hexColor("#1e1a16"), al), txt)
        },
    };

    vecToList(hitsOut)
}

// ============================================================================
// 5. Stage 3: Song-Dynasty Ink-Wash Combat Stage
// ============================================================================

pub def renderBattleStage(stageRect: Rect, _ptr: Vec2, dl: DrawList, m: ClientModel): List (CanvasHit ClientMsg) = {
    let w = stageRect.rw;
    let h = stageRect.rh;
    let ox = stageRect.rx;
    let oy = stageRect.ry;
    let isMobile = m.cmVp.vpWidth <= 768.0;
    let pStyle = match m.cmBattle.btSnap { Some(bs) -> parseCombatStyle(bs.bsPlayer.cbStyle), None -> StyleFist };
    let eStyle = match m.cmBattle.btSnap { Some(bs) -> parseCombatStyle(bs.bsEnemy.cbStyle), None -> StyleSword };
    let pProf = match m.cmBattle.btSnap {
        Some(bs) -> parseVisualProfile(bs.bsPlayer.cbGender),
        None -> parseVisualProfile(m.cmHero.hsStats.psGender),
    };
    let eProf = match m.cmBattle.btSnap { Some(bs) -> parseVisualProfile(bs.bsEnemy.cbGender), None -> ProfileMale };

    let idleP = MkActorVisual { avActionId: idleActionIdForStyle(pStyle), avProfile: pProf, avStyle: pStyle, avFrames: [MkFrameHold { fhFrameId: "idle", fhHoldMs: 640.0 }], avKeyPoses: None };
    let idleE = MkActorVisual { avActionId: idleActionIdForStyle(eStyle), avProfile: eProf, avStyle: eStyle, avFrames: [MkFrameHold { fhFrameId: "idle", fhHoldMs: 640.0 }], avKeyPoses: None };
    let mTl = m.cmBattle.btActiveTimeline;
    let elapsed = m.cmBattle.btTimelineElapsedMs;
    let reduced = m.cmVp.vpReducedMotion;
    let scene = sampleBattleScene(mTl, elapsed, idleP, idleE, reduced);

    let fitScale = minFloat(1.04, (w - 32.0) / 580.0) * scene.scCameraScale;
    let stageCx = ox + w * 0.5 + scene.scCameraX * fitScale;
    let groundY = oy + (if (isMobile) h * 0.62 else minFloat(h * 0.58, h - 220.0)) + scene.scShakeY * fitScale;

    let pFig = scene.scPlayer;
    let eFig = scene.scEnemy;
    let pPose = sampleSvgPose(m.cmPoseLib, mTl, SidePlayer, elapsed, pFig.fsVisual.avStyle, pFig.fsFrameId, reduced);
    let ePose = sampleSvgPose(m.cmPoseLib, mTl, SideEnemy, elapsed, eFig.fsVisual.avStyle, eFig.fsFrameId, reduced);

    let px = stageCx + (sideHome(SidePlayer) + pFig.fsX) * fitScale;
    let py = groundY + pFig.fsY * fitScale;
    let ex = stageCx + (sideHome(SideEnemy) + eFig.fsX) * fitScale;
    let ey = groundY + eFig.fsY * fitScale;

    let inv = scene.scInvert > 0.5;
    if (inv) {
        drawFillRect(dl, stageRect, 0.0, withAlpha(hexColor("#1a1612"), 0.82))
    } else if (scene.scShade > 0.01) {
        drawFillRect(dl, stageRect, 0.0, withAlpha(hexColor("#2b241c"), minFloat(0.24, scene.scShade * 0.45)))
    } else ();

    let moonCol = if (inv) hexColor("#352e26") else hexColor("#dfd4be");
    let horizonCol = if (inv) hexColor("#d6cab2") else hexColor("#3a3228");
    let shadowCol = if (inv) withAlpha(hexColor("#000000"), 0.35) else withAlpha(hexColor("#1e1a16"), 0.18);

    drawCircle(dl, ox + w * 0.5, groundY - 90.0 * fitScale, 138.0 * fitScale, withAlpha(moonCol, 0.55), 0, 0.0);
    drawLine(dl, ox + w * 0.08, groundY + 2.0, ox + w * 0.92, groundY + 2.0, 2.0, withAlpha(horizonCol, 0.58), false);
    drawEllipse(dl, px, groundY + 3.0, 28.0 * fitScale, 5.5 * fitScale, shadowCol, 0, 0.0);
    drawEllipse(dl, ex, groundY + 3.0, 28.0 * fitScale, 5.5 * fitScale, shadowCol, 0, 0.0);

    if (scene.scGhost > 0.04) {
        match mTl {
            Some(tl) ->
                if (sideEq(tl.tlTargetSide, SidePlayer)) {
                    drawInkActor(dl, stageCx + sideHome(SidePlayer) * fitScale, groundY, fitScale, 0.0, hexColor("#2b594b"), hexColor("#f6f0e2"), 0.0, scene.scGhost * 0.65, pPose, pFig.fsVisual.avStyle, pProf, m.cmVp.vpLookStyle, (0.0, 0.0), m.cmVp.vpClockMs)
                } else {
                    drawInkActor(dl, stageCx + sideHome(SideEnemy) * fitScale, groundY, 0.0 - fitScale, 0.0, hexColor("#6e6354"), hexColor("#f6f0e2"), 0.0, scene.scGhost * 0.65, ePose, eFig.fsVisual.avStyle, eProf, m.cmVp.vpLookStyle, (0.0, 0.0), m.cmVp.vpClockMs)
                },
            None -> (),
        }
    } else ();

    let (pFill, eFill, outlineCol) =
        if (inv) (hexColor("#f6f0e2"), hexColor("#e6d8be"), hexColor("#181410"))
        else (hexColor("#1b2521"), hexColor("#2f221b"), hexColor("#f6f0e2"));
    let pFlow = if (reduced) (0.0, 0.0) else (0.0 - pFig.fsX * 0.09, absFloat(pFig.fsY) * 0.2);
    let eFlow = if (reduced) (0.0, 0.0) else (eFig.fsX * 0.09, absFloat(eFig.fsY) * 0.2);

    drawInkActor(dl, px, py, fitScale, pFig.fsAngle, pFill, outlineCol, pFig.fsFlash, pFig.fsAlpha, pPose, pFig.fsVisual.avStyle, pProf, m.cmVp.vpLookStyle, pFlow, m.cmVp.vpClockMs);
    drawInkActor(dl, ex, ey, 0.0 - fitScale, eFig.fsAngle, eFill, outlineCol, eFig.fsFlash, eFig.fsAlpha, ePose, eFig.fsVisual.avStyle, eProf, m.cmVp.vpLookStyle, eFlow, m.cmVp.vpClockMs + 360.0);

    // Tapered slash ribbon (`OP_RIBBON`), parry guard ring & focus aura
    match mTl {
        None -> (),
        Some(tl) -> {
            let actorIsP = sideEq(tl.tlActorSide, SidePlayer);
            let aStyle = if (actorIsP) pFig.fsVisual.avStyle else eFig.fsVisual.avStyle;
            let aPose = if (actorIsP) pPose else ePose;
            let ax = if (actorIsP) px else ex;
            let ay = if (actorIsP) py else ey;
            let sgn = if (actorIsP) fitScale else 0.0 - fitScale;
            let (tipLx, tipLy) = if (styleEq(aStyle, StyleSword)) swordTipOf(aPose) else aPose.spHand;
            let tipWx = ax + sgn * tipLx;
            let tipWy = ay + absFloat(fitScale) * tipLy;
            let (shLx, shLy) = aPose.spShoulder;
            let shWx = ax + sgn * shLx;
            let shWy = ay + absFloat(fitScale) * shLy;

            if (scene.scTrail > 0.04) {
                let midX = (shWx + tipWx) * 0.5 + (if (actorIsP) 18.0 else -18.0) * fitScale;
                let midY = minFloat(shWy, tipWy) - 24.0 * fitScale;
                let col =
                    if (inv) hexColor("#f6f0e2")
                    else if (tl.tlStaging.spForce >= 0.85) hexColor("#a32c22")
                    else hexColor("#2b594b");
                drawRibbon(
                    dl,
                    [(shWx, shWy, 4.0 * fitScale), (midX, midY, 8.5 * fitScale), (tipWx, tipWy, 12.5 * fitScale)],
                    col,
                    scene.scTrail * 0.92
                )
            } else ();

            let (cx0, cy0) = scene.scContact;
            let cWx = stageCx + cx0 * fitScale * 0.65;
            let cWy = groundY + cy0 * fitScale;
            if (scene.scGuard > 0.04) {
                drawCircle(dl, cWx, cWy, (18.0 + (1.0 - scene.scGuard) * 26.0) * fitScale, 0, withAlpha(hexColor("#946623"), scene.scGuard), 2.6)
            } else ();
            if (scene.scAura > 0.04) {
                let ux = if (actorIsP) px else ex;
                let aFill = withAlpha(hexColor("#2b594b"), scene.scAura * 0.28);
                let aStrk = withAlpha(hexColor("#386944"), scene.scAura * 0.55);
                drawCircle(dl, ux, groundY - 58.0 * fitScale, 44.0 * fitScale, aFill, aStrk, 1.6)
            } else ()
        },
    };

    // Shockwave & ink particles
    let fx = m.cmFx;
    if (!reduced && fx.fxShockAge < 0.44 && fx.fxShockPower > 0.05) {
        let age = fx.fxShockAge;
        let pwr = minFloat(1.2, fx.fxShockPower);
        let (su, sv) = fx.fxShockPos;
        let sx = ox + su * w;
        let sy = oy + (1.0 - sv) * h;
        let rad1 = (18.0 + age * 260.0) * fitScale;
        let rad2 = (10.0 + age * 180.0) * fitScale;
        let al1 = maxFloat(0.0, 1.0 - age / 0.44) * 0.45 * pwr;
        let al2 = maxFloat(0.0, 1.0 - age / 0.34) * 0.28 * pwr;
        let col1 = if (inv) hexColor("#f6f0e2") else hexColor("#a32c22");
        let col2 = if (inv) hexColor("#d6cab2") else hexColor("#946623");
        drawCircle(dl, sx, sy, rad1, 0, withAlpha(col1, al1), 2.0);
        drawCircle(dl, sx, sy, rad2, 0, withAlpha(col2, al2), 1.2)
    } else ();

    let ptCur = cellNew(fx.fxParticles);
    while (match cellGet(ptCur) { Nil -> false, _ -> true }) {
        match cellGet(ptCur) {
            Cons(p, rest) -> {
                let al = maxFloat(0.0, 1.0 - p.ipLife / maxFloat(0.01, p.ipMaxLife));
                let rad = p.ipRadius * (0.55 + 0.45 * al);
                drawCircle(dl, p.ipX, p.ipY, rad, withAlpha(hexColor(p.ipColor), al), 0, 0.0);
                cellSet(ptCur, rest)
            },
            Nil -> (),
        }
    };

    // Move Stamp Seal, Floating Damage Callout & Settlement Seal
    match mTl {
        None -> (),
        Some(tl) ->
            if (tl.tlKind == "settlement") {
                let al = scene.scResultAlpha;
                drawRect(dl, rect(ox + w * 0.5 - 46.0, groundY - 130.0 * fitScale, 92.0, 92.0), 4.0, withAlpha(hexColor("#a32c22"), al * 0.96), withAlpha(hexColor("#f6f0e2"), al), 2.5);
                drawText(dl, ox + w * 0.5, groundY - 70.0 * fitScale, fontSerif(42.0, 700), AlignCenter, withAlpha(hexColor("#f6f0e2"), al), tl.tlLabel)
            } else {
                if (tl.tlKind != "effect_tick") {
                    let lbl = tl.tlLabel;
                    let bw = maxFloat(118.0, intToFloat(utf8CharCount(lbl)) * 18.5 + 40.0);
                    let bannerY = maxFloat(oy + 18.0, 122.0);
                    drawRect(dl, rect(ox + w * 0.5 - bw * 0.5, bannerY, bw, 34.0), 3.0, withAlpha(hexColor("#f7f1e3"), 0.95), hexColor("#a32c22"), 1.5);
                    drawText(dl, ox + w * 0.5, bannerY + 23.0, fontSerif(15.5, 700), AlignCenter, hexColor("#1e1a16"), "「" + lbl + "」")
                } else ();

                let hIdx = scene.scHitIndex;
                let curFloat =
                    if (hIdx >= 0 && hIdx < listLen(tl.tlHits)) {
                        match std.list.listNth(tl.tlHits, hIdx) {
                            Some(rh) -> rh.rhFloatText,
                            None -> tl.tlFloatText,
                        }
                    } else tl.tlFloatText;
                if (scene.scTextAlpha > 0.03 && strLen(curFloat) > 0) {
                    let tx = if (sideEq(tl.tlTargetSide, SidePlayer)) px else ex;
                    let ty = groundY - (122.0 + scene.scTextLift) * fitScale;
                    let fCol = match tl.tlResult {
                        ResParry -> hexColor("#946623"),
                        ResDodge -> hexColor("#2b594b"),
                        ResEffect -> hexColor("#386944"),
                        ResHit -> if (inv) hexColor("#ffdf9e") else if (sideEq(tl.tlTargetSide, SideEnemy)) hexColor("#a32c22") else hexColor("#8f1f16"),
                    };
                    drawText(dl, tx, ty, fontSans(22.0 * scene.scTextScale, 700), AlignCenter, withAlpha(fCol, scene.scTextAlpha), curFloat)
                } else ()
            },
    };
    Nil
}

// ============================================================================
// 6. Pose Sheet Inspector Grid (`/pose-sheet.html`)
// ============================================================================

pub def viewPoseSheet(_vp: Rect, m: ClientModel): Element ClientMsg =
    canvasStage([fillSpace()], (r, _ptr, dl) -> {
        let w = r.rw;
        let h = r.rh;
        let pids = allPoseIds(m.cmPoseLib);
        let cols = maxInt(2, floorInt((w - 40.0) / 176.0));
        let cellW = (w - 40.0) / intToFloat(cols);
        let cellH = 168.0;
        drawText(dl, r.rx + w * 0.5, r.ry + 42.0, fontSerif(18.0, 700), AlignCenter, hexColor("#1e1a16"),
            "听风录 · 宣纸剪影姿势总览（svg-poses.json 共 " + intToStr(listLen(pids)) + " 式）");
        let idxCell = cellNew(0);
        let cur = cellNew(pids);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(pid, rest) -> {
                    let idx = cellGet(idxCell);
                    let colIdx = idx % cols;
                    let rowIdx = idx / cols;
                    if (72.0 + intToFloat(rowIdx) * cellH < h + 160.0) {
                        let cx = r.rx + 20.0 + intToFloat(colIdx) * cellW + cellW * 0.5;
                        let cy = r.ry + 72.0 + intToFloat(rowIdx) * cellH + 126.0;
                        let pose = svgPose(m.cmPoseLib, pid, StyleSword);
                        drawRect(dl, rect(cx - cellW * 0.46, cy - 118.0, cellW * 0.92, 150.0), 3.0, withAlpha(hexColor("#f6f0e2"), 0.96), hexColor("#c8bca4"), 1.1);
                        drawLine(dl, cx - cellW * 0.36, cy, cx + cellW * 0.36, cy, 1.2, withAlpha(hexColor("#6e6354"), 0.55), false);
                        drawInkActor(dl, cx, cy, 0.58, 0.0, hexColor("#1e2320"), hexColor("#f6f0e2"), 0.0, 1.0, pose, StyleSword, ProfileFemale, m.cmVp.vpLookStyle, (0.0, 0.0), 0.0);
                        drawText(dl, cx, cy + 22.0, fontSans(11.5, 600), AlignCenter, hexColor("#3d352c"), pid)
                    } else ();
                    cellSet(idxCell, idx + 1);
                    cellSet(cur, rest)
                },
                Nil -> (),
            }
        };
        Nil
    })
