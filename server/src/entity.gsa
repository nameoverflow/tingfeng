// ============================================================================
// Derived Stats Formulas (1:1 parity with `Game/Entity.hs`)
// ============================================================================

pub data DerivedStats {
    MkDerivedStats {
        dsMaxHp: Int,
        dsMaxQi: Int,
        dsMaxJing: Int,
        dsHpRegen: Float,
        dsQiRegen: Float,
        dsJingRegen: Float,
        dsStrength: Int,
        dsAgility: Int,
        dsVitality: Int,
        dsAttack: Int,
        dsDefense: Int,
        dsHit: Int,
        dsDodge: Int,
        dsParry: Int,
        dsDamageBonus: Int,
        dsDamageReduction: Int,
        dsLoadLimit: Int,
    },
}

pub data DerivedStatSources {
    MkDerivedStatSources {
        derivedEquipmentModifiers: DerivedStatModifiers,
        derivedTechniqueModifiers: DerivedStatModifiers,
        derivedStatusModifiers: DerivedStatModifiers,
    },
}

pub def emptyDerivedStatSources(): DerivedStatSources =
    MkDerivedStatSources {
        derivedEquipmentModifiers: empty(),
        derivedTechniqueModifiers: empty(),
        derivedStatusModifiers: empty(),
    }

pub def characterKnownArtLevel(targetArtId: String, char: Character): Int = {
    let groups = mapElems(char.charArt);
    let levels = fp.listConcatMap(
        groups,
        (knownArts) -> fp.listFilterMap(
            knownArts,
            (known) -> if (known.artDef == targetArtId) Some(known.artLevel) else None
        )
    );
    listMaxInt(levels, 0)
}

pub def equippedArtLevel(artType: ArtType, char: Character): Int =
    match mapLookup(char.charEnabled, artType) {
        Some(ent) -> ent.artLevel,
        None -> 0,
    }

pub def characterCombatRank(char: Character): Int = match char.charRank {
    Some(r) -> r,
    None -> listMaxInt([
        equippedArtLevel(Sword, char),
        equippedArtLevel(Blade, char),
        equippedArtLevel(Spear, char),
        equippedArtLevel(Staff, char),
        equippedArtLevel(Fist, char),
        characterKnownArtLevel("basic_sword", char),
        characterKnownArtLevel("basic_blade", char),
        characterKnownArtLevel("basic_spear", char),
        characterKnownArtLevel("basic_staff", char),
        characterKnownArtLevel("basic_fist", char),
    ], 0),
}

pub def equipmentDerivedModifiers(char: Character): DerivedStatModifiers =
    foldMapList(mapElems(char.charEquipped), (eq) -> eq.equippedModifiers)

pub def techniqueDerivedModifiers(char: Character): DerivedStatModifiers =
    match mapLookup(char.charEnabled, Internal) {
        Some(ent) ->
            if (ent.artDef == "taihu_breath") {
                let lvl = ent.artLevel;
                let base = emptyDerivedStatModifiers();
                MkDerivedStatModifiers {
                    dsmStrength: base.dsmStrength,
                    dsmAgility: base.dsmAgility,
                    dsmVitality: base.dsmVitality,
                    dsmMaxHp: base.dsmMaxHp,
                    dsmMaxQi: base.dsmMaxQi,
                    dsmMaxJing: base.dsmMaxJing,
                    dsmHpRegen: 0.4 + intToFloat(lvl) * 0.05,
                    dsmQiRegen: 0.3 + intToFloat(lvl) * 0.04,
                    dsmJingRegen: 0.2 + intToFloat(lvl) * 0.02,
                    dsmHit: base.dsmHit,
                    dsmDodge: 2 + floorDiv(lvl, 3),
                    dsmParry: base.dsmParry,
                    dsmDamageBonus: base.dsmDamageBonus,
                    dsmDamageReduction: base.dsmDamageReduction,
                    dsmLoadLimit: base.dsmLoadLimit,
                }
            } else if (ent.artDef == "duan_zen_breath") {
                let lvl = ent.artLevel;
                let base = emptyDerivedStatModifiers();
                MkDerivedStatModifiers {
                    dsmStrength: base.dsmStrength,
                    dsmAgility: base.dsmAgility,
                    dsmVitality: maxInt(1, floorDiv(lvl, 8)),
                    dsmMaxHp: base.dsmMaxHp,
                    dsmMaxQi: 10 + lvl * 2,
                    dsmMaxJing: base.dsmMaxJing,
                    dsmHpRegen: base.dsmHpRegen,
                    dsmQiRegen: base.dsmQiRegen,
                    dsmJingRegen: base.dsmJingRegen,
                    dsmHit: base.dsmHit,
                    dsmDodge: base.dsmDodge,
                    dsmParry: 3 + floorDiv(lvl, 3),
                    dsmDamageBonus: base.dsmDamageBonus,
                    dsmDamageReduction: 2 + floorDiv(lvl, 4),
                    dsmLoadLimit: base.dsmLoadLimit,
                }
            } else emptyDerivedStatModifiers(),
        None -> emptyDerivedStatModifiers(),
    }

def statusMagnitudeModifiers(mag: Int): DerivedStatModifiers = {
    let base = emptyDerivedStatModifiers();
    MkDerivedStatModifiers {
        dsmStrength: mag,
        dsmAgility: mag,
        dsmVitality: mag,
        dsmMaxHp: base.dsmMaxHp,
        dsmMaxQi: base.dsmMaxQi,
        dsmMaxJing: base.dsmMaxJing,
        dsmHpRegen: base.dsmHpRegen,
        dsmQiRegen: base.dsmQiRegen,
        dsmJingRegen: base.dsmJingRegen,
        dsmHit: mag * 4,
        dsmDodge: mag * 4,
        dsmParry: mag * 4,
        dsmDamageBonus: mag,
        dsmDamageReduction: mag,
        dsmLoadLimit: base.dsmLoadLimit,
    }
}

pub def activeEffectDerivedModifiers(
    effectDefs: OrdMap String Effect,
    activeEffects: OrdMap String ActiveEffect
): DerivedStatModifiers =
    foldMapList(
        mapElems(activeEffects),
        (ae) -> match mapLookup(effectDefs, ae.activeEffectDef) {
            Some(eff) -> match eff.effectType {
                Buff -> statusMagnitudeModifiers(ae.activeEffectValue),
                DeBuff -> statusMagnitudeModifiers(-ae.activeEffectValue),
                DoT -> emptyDerivedStatModifiers(),
                HoT -> emptyDerivedStatModifiers(),
            },
            None -> emptyDerivedStatModifiers(),
        }
    )

pub def characterDerivedStatSources(
    effectDefs: OrdMap String Effect,
    activeEffects: OrdMap String ActiveEffect,
    char: Character
): DerivedStatSources =
    MkDerivedStatSources {
        derivedEquipmentModifiers: equipmentDerivedModifiers(char),
        derivedTechniqueModifiers: techniqueDerivedModifiers(char),
        derivedStatusModifiers: activeEffectDerivedModifiers(effectDefs, activeEffects),
    }

pub def deriveCharacterStats(char: Character, combatExp: Int, sources: DerivedStatSources): DerivedStats = {
    // Combine all three modifier sources via `Semigroup` `<+>`!
    let mods = sources.derivedEquipmentModifiers <+> sources.derivedTechniqueModifiers <+> sources.derivedStatusModifiers;
    let innate = char.charInnate;
    let basicInternal = characterKnownArtLevel("basic_internal", char);
    let basicLightness = characterKnownArtLevel("basic_lightness", char);
    let basicFist = characterKnownArtLevel("basic_fist", char);
    let basicSword = characterKnownArtLevel("basic_sword", char);
    let basicBlade = characterKnownArtLevel("basic_blade", char);
    let basicSpear = characterKnownArtLevel("basic_spear", char);
    let basicStaff = characterKnownArtLevel("basic_staff", char);

    let effStr = clampEffectiveAttr(innate.innateStrength + floorDiv(basicFist, 20) + mods.dsmStrength);
    let effAgi = clampEffectiveAttr(innate.innateAgility + floorDiv(basicLightness, 20) + mods.dsmAgility);
    let effVit = clampEffectiveAttr(innate.innateVitality + floorDiv(basicInternal, 20) + mods.dsmVitality);

    let enabledInternal = equippedArtLevel(Internal, char);
    let enabledLightness = equippedArtLevel(Lightness, char);
    let internalPower = floorDiv(basicInternal, 2) + enabledInternal;
    let lightnessPower = floorDiv(basicLightness, 2) + enabledLightness;

    let maxMelee = listMaxInt([
        equippedArtLevel(Sword, char),
        equippedArtLevel(Blade, char),
        equippedArtLevel(Spear, char),
        equippedArtLevel(Staff, char),
        equippedArtLevel(Fist, char),
    ], 0);
    let meleeLevel = match mapLookup(char.charEquipped, WeaponSlot) {
        Some(eq) -> match eq.equippedWeaponKind {
            Some(SwordWeapon) if (mapMember(char.charEnabled, Sword)) -> equippedArtLevel(Sword, char),
            Some(BladeWeapon) if (mapMember(char.charEnabled, Blade)) -> equippedArtLevel(Blade, char),
            Some(SpearWeapon) if (mapMember(char.charEnabled, Spear)) -> equippedArtLevel(Spear, char),
            Some(StaffWeapon) if (mapMember(char.charEnabled, Staff)) -> equippedArtLevel(Staff, char),
            Some(FistWeapon) if (mapMember(char.charEnabled, Fist)) -> equippedArtLevel(Fist, char),
            _ -> maxMelee,
        },
        None -> maxMelee,
    };

    let foundationMelee = listMaxInt([basicFist, basicSword, basicBlade, basicSpear, basicStaff], 0);
    let parryArtLevel = meleeLevel;
    let combatExpHpBonus = minInt(80, floorDiv(combatExp, 2000));
    let combatExpJingBonus = minInt(60, floorDiv(combatExp, 3000));
    let damageReduction = maxInt(0, floorDiv(effVit - 10, 4)) + floorDiv(internalPower, 12);
    let finalDamageBonus = maxInt(0, maxInt(0, floorDiv(effStr - 10, 3)) + mods.dsmDamageBonus);
    let finalDamageReduction = maxInt(0, damageReduction + mods.dsmDamageReduction);

    MkDerivedStats {
        dsMaxHp: 80 + effVit * 5 + internalPower * 4 + combatExpHpBonus + mods.dsmMaxHp,
        dsMaxQi: char.charMaxQi + effVit * 2 + internalPower * 6 + mods.dsmMaxQi,
        dsMaxJing: 80 + effVit * 4 + internalPower * 2 + combatExpJingBonus + mods.dsmMaxJing,
        dsHpRegen: 0.5 + intToFloat(effVit) / 30.0 + mods.dsmHpRegen,
        dsQiRegen: 1.0 + intToFloat(effVit) / 25.0 + intToFloat(internalPower) / 30.0 + mods.dsmQiRegen,
        dsJingRegen: 0.5 + intToFloat(effVit) / 40.0 + intToFloat(internalPower) / 60.0 + mods.dsmJingRegen,
        dsStrength: effStr,
        dsAgility: effAgi,
        dsVitality: effVit,
        dsAttack: 30 + meleeLevel * 7 + foundationMelee * 2 + effStr * 3 + effAgi * 2,
        dsDefense: finalDamageReduction,
        dsHit: effStr * 2 + effAgi * 2 + meleeLevel * 3 + mods.dsmHit,
        dsDodge: 20 + effAgi * 5 + effVit * 2 + lightnessPower * 6 + mods.dsmDodge,
        dsParry: 15 + effVit * 4 + effStr * 2 + parryArtLevel * 6 + mods.dsmParry,
        dsDamageBonus: finalDamageBonus,
        dsDamageReduction: finalDamageReduction,
        dsLoadLimit: 20000 + effStr * 1500 + basicFist * 100 + mods.dsmLoadLimit,
    }
}

pub def deriveStats(player: Player): DerivedStats =
    deriveCharacterStats(
        player.playerCharacter,
        player.playerCombatExp,
        characterDerivedStatSources(mapEmpty(), mapEmpty(), player.playerCharacter)
    )

// ============================================================================
// Directions, Rooms & Maps
// ============================================================================

pub data Direction {
    North,
    South,
    East,
    West,
    NorthEast,
    NorthWest,
    SouthEast,
    SouthWest,
}

def directionRank(d: Direction): Int = match d {
    North -> 0,
    South -> 1,
    East -> 2,
    West -> 3,
    NorthEast -> 4,
    NorthWest -> 5,
    SouthEast -> 6,
    SouthWest -> 7,
}

pub def directionEq(a: Direction, b: Direction): Bool =
    directionRank(a) == directionRank(b)

instance Ord Direction {
    def compare(a, b) = compare(directionRank(a), directionRank(b))
}

// Capitalized constructor name (matches Haskell `ToJSON Direction` / `Prelude.show`)
pub def directionToText(d: Direction): String = match d {
    North -> "North",
    South -> "South",
    East -> "East",
    West -> "West",
    NorthEast -> "NorthEast",
    NorthWest -> "NorthWest",
    SouthEast -> "SouthEast",
    SouthWest -> "SouthWest",
}

pub def directionFromText(raw: String): Option Direction = {
    let s = strToLowerAscii(raw);
    if (s == "north") Some(North)
    else if (s == "south") Some(South)
    else if (s == "east") Some(East)
    else if (s == "west") Some(West)
    else if (s == "northeast") Some(NorthEast)
    else if (s == "northwest") Some(NorthWest)
    else if (s == "southeast") Some(SouthEast)
    else if (s == "southwest") Some(SouthWest)
    else None
}

pub def parseDirectionKey(raw: String): Result Direction String = match directionFromText(raw) {
    Some(d) -> Ok(d),
    None -> Err("Invalid direction: " + raw),
}

pub def decodeDirection(): Decoder Direction =
    std.codec.andThen(
        (raw) -> match directionFromText(raw) {
            Some(d) -> succeed(d),
            None -> fail("Invalid direction: " + raw),
        },
        str
    )

instance Encode Direction {
    def encode(d) = encode(directionToText(d))
}

pub data RoomRef {
    MkRoomRef {
        roomRefMapId: String,
        roomRefPos: (Int, Int),
    },
}

def decodeRoomExitRef(): Decoder RoomRef =
    (succeed((m) -> (p) -> MkRoomRef { roomRefMapId: m, roomRefPos: p })
        |> req("map", str)
        |> req("position", decodePos()))
    <|> std.codec.map((p) -> MkRoomRef { roomRefMapId: "", roomRefPos: p }, decodePos())

pub data RoomInsight {
    MkRoomInsight {
        roomInsightArts: List ArtType,
        roomInsightBonus: Int,
        roomInsightJingDiscount: Int,
        roomInsightNote: Option String,
    },
}

pub def decodeRoomInsight(): Decoder RoomInsight =
    succeed((arts) -> (bon) -> (disc) -> (note) ->
        MkRoomInsight {
            roomInsightArts: arts,
            roomInsightBonus: bon,
            roomInsightJingDiscount: disc,
            roomInsightNote: note,
        }
    )
        |> withDefault("arts", list(decodeArtType()), Nil)
        |> withDefault("bonus", int, 0)
        |> withDefault("jing_discount", int, 0)
        |> opt("note", str)

pub data Room {
    MkRoom {
        roomId: String,
        roomPos: (Int, Int),
        roomName: String,
        roomDesc: String,
        roomDescVariants: List (String, String),
        roomKind: String,
        roomRest: Bool,
        roomInsight: Option RoomInsight,
        roomScript: Option String,
        roomExits: OrdMap Direction RoomRef,
        roomChar: List String,
        roomPlayer: OrdSet String,
    },
}

pub def roomPlayerL(): Lens Room (OrdSet String) =
    lens((r) -> r.roomPlayer, (r, v) -> MkRoom {
        roomId: r.roomId, roomPos: r.roomPos, roomName: r.roomName, roomDesc: r.roomDesc,
        roomDescVariants: r.roomDescVariants, roomKind: r.roomKind, roomRest: r.roomRest,
        roomInsight: r.roomInsight, roomScript: r.roomScript, roomExits: r.roomExits,
        roomChar: r.roomChar, roomPlayer: v,
    })

def decodeRoomPart1(): Decoder (String, (Int, Int), String, String, List (String, String)) =
    succeed((id) -> (pos) -> (nm) -> (desc) -> (vars) -> (id, pos, nm, desc, vars))
        |> req("id", str)
        |> req("position", decodePos())
        |> req("name", str)
        |> req("desc", str)
        |> withDefault(
            "desc_variants",
            list(succeed((fl) -> (d) -> (fl, d)) |> req("flag", str) |> req("desc", str)),
            Nil
        )

def decodeRoomPart2(): Decoder (String, Bool, Option RoomInsight, Option String, OrdMap Direction RoomRef, List String) =
    succeed((kind) -> (rest) -> (ins) -> (scr) -> (exits) -> (chars) -> (kind, rest, ins, scr, exits, chars))
        |> withDefault("kind", str, "building")
        |> withDefault("rest", bool, false)
        |> opt("insight", decodeRoomInsight())
        |> opt("script", str)
        |> req("exits", decodeTypedMap(parseDirectionKey, decodeRoomExitRef()))
        |> withDefault("char", list(str), Nil)

pub def decodeRoom(): Decoder Room =
    succeed((p1) -> (p2) -> match (p1, p2) {
        ((id, pos, nm, desc, vars), (kind, rest, ins, scr, exits, chars)) ->
            MkRoom {
                roomId: id,
                roomPos: pos,
                roomName: nm,
                roomDesc: desc,
                roomDescVariants: vars,
                roomKind: kind,
                roomRest: rest,
                roomInsight: ins,
                roomScript: scr,
                roomExits: exits,
                roomChar: chars,
                roomPlayer: setEmpty(),
            },
    })
        |> custom(decodeRoomPart1())
        |> custom(decodeRoomPart2())

pub data GameMap {
    MkGameMap {
        mapId: String,
        mapName: String,
        mapDesc: String,
        mapRooms: OrdMap (Int, Int) Room,
    },
}

pub def mapRoomsL(): Lens GameMap (OrdMap (Int, Int) Room) =
    lens((m) -> m.mapRooms, (m, v) -> MkGameMap {
        mapId: m.mapId, mapName: m.mapName, mapDesc: m.mapDesc, mapRooms: v,
    })

def resolveRoomLocalExits(targetMapId: String, room: Room): Room = {
    let resolvedExits = mapMap(
        room.roomExits,
        (ref) ->
            if (strLen(ref.roomRefMapId) == 0) MkRoomRef { roomRefMapId: targetMapId, roomRefPos: ref.roomRefPos }
            else ref
    );
    MkRoom {
        roomId: room.roomId,
        roomPos: room.roomPos,
        roomName: room.roomName,
        roomDesc: room.roomDesc,
        roomDescVariants: room.roomDescVariants,
        roomKind: room.roomKind,
        roomRest: room.roomRest,
        roomInsight: room.roomInsight,
        roomScript: room.roomScript,
        roomExits: resolvedExits,
        roomChar: room.roomChar,
        roomPlayer: room.roomPlayer,
    }
}

pub def decodeGameMap(): Decoder GameMap =
    succeed((id) -> (nm) -> (desc) -> (rooms) -> {
        let pairs = listMap(rooms, (r) -> {
            let r2 = resolveRoomLocalExits(id, r);
            (r2.roomPos, r2)
        });
        MkGameMap {
            mapId: id,
            mapName: nm,
            mapDesc: desc,
            mapRooms: mapFromList(pairs),
        }
    })
        |> req("id", str)
        |> req("name", str)
        |> req("desc", str)
        |> req("rooms", list(decodeRoom()))

instance Configurable GameMap {
    def configId(m) = m.mapId
    def configDecoder() = decodeGameMap()
}
