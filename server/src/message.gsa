// Network Protocol Messages (`NetEvent`, `PlayerAction`, `ActionResp`) and 100%
// Aeson-Compatible Wire Encoders & Combinator Decoders (`message`).

use std.option.{Option, Some, None}
use std.result.{Result, Ok, Err}
use std.codec.{
    Value, DecodeErr,
    Encode, encode, object, array, (:=),
    Decoder, (|>), (<|>),
    succeed, int, str, oneOf, at, atOpt, req, opt, withDefault, tagged
}
use std.json.{toJson, decodeString}
use ordmap.OrdMap
use entity.{
    EquipSlot, decodeEquipSlot,
    ArtType, decodeArtType,
    Direction, decodeDirection,
    CombatVisualHint, mapD,
    encodePos, encodeStrOrdMap
}
use creation.{
    CharacterCreationChoice, decodeCharacterCreationChoice,
    CharacterCreationConfig
}

// ============================================================================
// Client -> Server: `PlayerAction` & `NetEvent`
// ============================================================================

pub data PlayerAction {
    Go(Direction),
    Talk(String),
    Attack(String),
    Perform(String),
    Train(String),
    Practice(String, Int),
    Learn(String, String, Int),
    Study(String, Int),
    Research(String, Int),
    Meditate(Int, Int),
    EnableArt(ArtType, String),
    PrepareArt(ArtType, String),
    Equip(String),
    Unequip(EquipSlot),
    Buy(Option String, String),
    Use(String),
    Say(String),
    Other(String),
}

// Either `{"<key>": {"<field>": target, "times": n}}` or bare `{"<key>": target}` (defaults `times = 1`)
def decodeTimedAction(
    key: String,
    field: String,
    valDec: Decoder a,
    build: (a, Int) -> PlayerAction
): Decoder PlayerAction =
    at(
        key,
        (succeed((x) -> (n) -> build(x, n))
            |> req(field, valDec)
            |> withDefault("times", int, 1))
        <|> std.codec.map((x) -> build(x, 1), valDec)
    )

pub def decodePlayerAction(): Decoder PlayerAction =
    oneOf([
        at("go", decodeDirection()) |> mapD((d) -> Go(d)),
        at("attack", str) |> mapD((c) -> Attack(c)),
        at("perform", str) |> mapD((s) -> Perform(s)),
        at("train", str) |> mapD((a) -> Train(a)),
        decodeTimedAction("practice", "art", str, (a, n) -> Practice(a, n)),
        at(
            "learn",
            succeed((t) -> (a) -> (n) -> Learn(t, a, n))
                |> req("teacher", str)
                |> req("art", str)
                |> withDefault("times", int, 1)
        ),
        decodeTimedAction("study", "item", str, (i, n) -> Study(i, n)),
        decodeTimedAction("research", "art", str, (a, n) -> Research(a, n)),
        decodeTimedAction("meditate", "amount", int, (amt, n) -> Meditate(amt, n)),
        at(
            "enable",
            succeed((ty) -> (a) -> EnableArt(ty, a))
                |> req("type", decodeArtType())
                |> req("art", str)
        ),
        at(
            "prepare",
            succeed((ty) -> (a) -> PrepareArt(ty, a))
                |> req("type", decodeArtType())
                |> req("art", str)
        ),
        at("equip", str) |> mapD((i) -> Equip(i)),
        at("unequip", decodeEquipSlot()) |> mapD((s) -> Unequip(s)),
        at(
            "buy",
            (succeed((m) -> (i) -> Buy(m, i))
                |> opt("merchant", str)
                |> req("item", str))
            <|> std.codec.map((i) -> Buy(None, i), str)
        ),
        at("use", str) |> mapD((i) -> Use(i)),
        at("say", str) |> mapD((m) -> Say(m)),
        at("other", str) |> mapD((c) -> Other(c)),
        at("talk", str) |> mapD((c) -> Talk(c)),
    ])

pub def decodePlayerActionJson(raw: String): Result PlayerAction DecodeErr =
    decodeString(decodePlayerAction(), raw)

pub data NetEvent {
    RequestCharacterCreationConfig,
    Login {
        username: String,
        password: String,
        creation: Option CharacterCreationChoice,
    },
    Disconnect,
    NetPlayerAction(PlayerAction),
}

pub def decodeNetEvent(): Decoder NetEvent =
    tagged("tag", [
        ("RequestCharacterCreationConfig", succeed(RequestCharacterCreationConfig)),
        (
            "Login",
            succeed((u) -> (p) -> (c) -> Login { username: u, password: p, creation: c })
                |> req("username", str)
                |> req("password", str)
                |> opt("creation", decodeCharacterCreationChoice())
        ),
        ("Disconnect", succeed(Disconnect)),
        ("NetPlayerAction", at("contents", decodePlayerAction()) |> mapD((a) -> NetPlayerAction(a))),
    ])

pub def decodeNetEventJson(raw: String): Result NetEvent DecodeErr =
    decodeString(decodeNetEvent(), raw)

