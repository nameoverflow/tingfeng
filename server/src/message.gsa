pub data CombatMessage {
    CombatScriptText(String),
    CombatEffectTick(String, String, String, Int),
}

instance Encode CombatMessage {
    def encode(m) = match m {
        CombatScriptText(txt) -> object([
            "kind" := "script",
            "text" := txt,
        ]),
        CombatEffectTick(effId, effName, effKind, amt) -> object([
            "kind"       := "effect_tick",
            "effectId"   := effId,
            "effectName" := effName,
            "effectKind" := effKind,
            "amount"     := amt,
        ]),
    }
}

pub data CombatEventKind {
    CombatEventNormal,
    CombatEventActiveSkill,
    CombatEventEffectTick,
}

pub def combatEventKindEq(a: CombatEventKind, b: CombatEventKind): Bool = match (a, b) {
    (CombatEventNormal, CombatEventNormal) -> true,
    (CombatEventActiveSkill, CombatEventActiveSkill) -> true,
    (CombatEventEffectTick, CombatEventEffectTick) -> true,
    _ -> false,
}

pub def combatEventKindText(k: CombatEventKind): String = match k {
    CombatEventNormal -> "normal",
    CombatEventActiveSkill -> "active_skill",
    CombatEventEffectTick -> "effect_tick",
}

pub data CombatResult {
    CombatHit,
    CombatDodge,
    CombatParry,
    CombatEffect,
}

pub def combatResultEq(a: CombatResult, b: CombatResult): Bool = match (a, b) {
    (CombatHit, CombatHit) -> true,
    (CombatDodge, CombatDodge) -> true,
    (CombatParry, CombatParry) -> true,
    (CombatEffect, CombatEffect) -> true,
    _ -> false,
}

pub def combatResultText(r: CombatResult): String = match r {
    CombatHit -> "hit",
    CombatDodge -> "dodge",
    CombatParry -> "parry",
    CombatEffect -> "effect",
}

pub data CombatHitOutcome {
    MkCombatHitOutcome {
        combatHitResult: CombatResult,
        combatHitDamage: Option Int,
        combatHitHeal: Option Int,
    },
}

instance Encode CombatHitOutcome {
    def encode(h) = object([
        "result" := combatResultText(h.combatHitResult),
        "damage" := h.combatHitDamage,
        "heal"   := h.combatHitHeal,
    ])
}

pub data CombatEvent {
    MkCombatEvent {
        combatEventKind: CombatEventKind,
        combatEventActorName: String,
        combatEventTargetName: String,
        combatEventMessage: CombatMessage,
        combatEventDamage: Option Int,
        combatEventHeal: Option Int,
        combatEventResult: CombatResult,
        combatEventHits: List CombatHitOutcome,
        combatEventVisual: CombatVisualHint,
    },
}

instance Encode CombatEvent {
    def encode(e) = object([
        "kind"       := combatEventKindText(e.combatEventKind),
        "actorName"  := e.combatEventActorName,
        "targetName" := e.combatEventTargetName,
        "message"    := e.combatEventMessage,
        "damage"     := e.combatEventDamage,
        "heal"       := e.combatEventHeal,
        "result"     := combatResultText(e.combatEventResult),
        "hits"       := e.combatEventHits,
        "visual"     := e.combatEventVisual,
    ])
}

pub data ActiveSkillFailureReason {
    ActiveSkillNeedAp(Int, Int),
    ActiveSkillNeedQi(Int, Int),
    ActiveSkillOnCooldown(Int),
    ActiveSkillMissingStatus(List String),
    ActiveSkillUnavailable(String),
}

instance Encode ActiveSkillFailureReason {
    def encode(r) = match r {
        ActiveSkillNeedAp(reqAp, curAp) -> object([
            "reason"   := "need_ap",
            "required" := reqAp,
            "current"  := curAp,
        ]),
        ActiveSkillNeedQi(reqQi, curQi) -> object([
            "reason"   := "need_qi",
            "required" := reqQi,
            "current"  := curQi,
        ]),
        ActiveSkillOnCooldown(rem) -> object([
            "reason"    := "cooldown",
            "remaining" := rem,
        ]),
        ActiveSkillMissingStatus(missing) -> object([
            "reason"   := "missing_status",
            "statuses" := missing,
        ]),
        ActiveSkillUnavailable(sid) -> object([
            "reason"        := "unavailable",
            "activeSkillId" := sid,
        ]),
    }
}

