pub data ActiveSkillSummary {
    MkActiveSkillSummary {
        activeSkillSummaryId: String,
        activeSkillSummaryName: String,
        activeSkillSummaryDesc: String,
        activeSkillSummaryCost: Int,
        activeSkillSummaryApReq: Int,
        activeSkillSummaryUnlockLevel: Int,
        activeSkillSummaryCooldown: Float,
        activeSkillSummaryReqStatus: List String,
        activeSkillSummaryReqStatusNames: List String,
        activeSkillSummaryDamage: Option Int,
        activeSkillSummaryHeal: Option Int,
    },
}

instance Encode ActiveSkillSummary {
    def encode(s) = object([
        "activeSkillSummaryId"             := s.activeSkillSummaryId,
        "activeSkillSummaryName"           := s.activeSkillSummaryName,
        "activeSkillSummaryDesc"           := s.activeSkillSummaryDesc,
        "activeSkillSummaryCost"           := s.activeSkillSummaryCost,
        "activeSkillSummaryApReq"          := s.activeSkillSummaryApReq,
        "activeSkillSummaryUnlockLevel"    := s.activeSkillSummaryUnlockLevel,
        "activeSkillSummaryCooldown"       := s.activeSkillSummaryCooldown,
        "activeSkillSummaryReqStatus"      := s.activeSkillSummaryReqStatus,
        "activeSkillSummaryReqStatusNames" := s.activeSkillSummaryReqStatusNames,
        "activeSkillSummaryDamage"         := s.activeSkillSummaryDamage,
        "activeSkillSummaryHeal"           := s.activeSkillSummaryHeal,
    ])
}

