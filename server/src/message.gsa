        "playerStatsSummaryMaxQi"          := p.playerStatsSummaryMaxQi,
        "playerStatsSummaryJing"           := p.playerStatsSummaryJing,
        "playerStatsSummaryMaxJing"        := p.playerStatsSummaryMaxJing,
        "playerStatsSummaryAp"             := p.playerStatsSummaryAp,
        "playerStatsSummaryStatus"         := p.playerStatsSummaryStatus,
        "playerStatsSummaryGender"         := p.playerStatsSummaryGender,
        "playerStatsSummaryAppearance"     := p.playerStatsSummaryAppearance,
        "playerStatsSummaryAppearanceText" := p.playerStatsSummaryAppearanceText,
        "playerStatsSummaryPortraitKey"    := p.playerStatsSummaryPortraitKey,
        "playerStatsSummaryStrength"       := p.playerStatsSummaryStrength,
        "playerStatsSummaryAgility"        := p.playerStatsSummaryAgility,
        "playerStatsSummaryVitality"       := p.playerStatsSummaryVitality,
        "playerStatsSummaryPotential"      := p.playerStatsSummaryPotential,
        "playerStatsSummaryCombatExp"      := p.playerStatsSummaryCombatExp,
        "playerStatsSummaryInjuredSeconds" := p.playerStatsSummaryInjuredSeconds,
        "playerStatsSummaryCombatInsight"  := p.playerStatsSummaryCombatInsight,
        "playerStatsSummaryBusy"           := p.playerStatsSummaryBusy,
    ])
}

// ============================================================================
// Server -> Client Envelope (`ActionResp`, exact Aeson Generic format)
// ============================================================================

pub data ActionResp {
    MoveMsg(String),
    ViewMsg(String, String, List RoomCharacterSummary, List RoomExitSummary),
    MapOverviewMsg(MapOverviewSummary),
    AttackMsg(String, String),
    CombatEventMsg(CombatEvent),
    CombatSettlementMsg(String, String, Bool),
    UseItemMsg(String, String),
    SayMsg(String, String),
    DialogueMsg(String, String),
    PlayerStatsMsg(PlayerStatsSummary),
    ActiveSkillFailureMsg(ActiveSkillFailureReason),
    BattleStateMsg(BattleSnapshot),
    StoryMsg(String, String),
    StorySequenceMsg(Bool),
    StoryDelayMsg(Int),
    StoryTransitionMsg(String, Int),
    QuestLogMsg(List QuestLogEntry),
    InventoryMsg(Int, List InventoryItemSummary),
    ArtsMsg(List ArtSummary),
    RewardMsg(List RewardSummary),
    CharacterCreationConfigMsg(CharacterCreationConfig),
    SystemMsg(SystemMessage),
    ErrorMsg(ErrorSummary),
}

def taggedEnvelope(tag: String, contents: Value): Value =
    object([
        "tag"      := tag,
        "contents" := contents,
    ])

instance Encode ActionResp {
    def encode(r) = match r {
        MoveMsg(dst) ->
            taggedEnvelope("MoveMsg", encode(dst)),
        ViewMsg(rName, rDesc, chars, exits) ->
            taggedEnvelope("ViewMsg", array([encode(rName), encode(rDesc), encode(chars), encode(exits)])),
        MapOverviewMsg(ov) ->
            taggedEnvelope("MapOverviewMsg", encode(ov)),
        AttackMsg(atk, defName) ->
            taggedEnvelope("AttackMsg", array([encode(atk), encode(defName)])),
        CombatEventMsg(ev) ->
            taggedEnvelope("CombatEventMsg", encode(ev)),
        CombatSettlementMsg(atk, defName, win) ->
            taggedEnvelope("CombatSettlementMsg", array([encode(atk), encode(defName), encode(win)])),
        UseItemMsg(who, txt) ->
            taggedEnvelope("UseItemMsg", array([encode(who), encode(txt)])),
        SayMsg(who, txt) ->
            taggedEnvelope("SayMsg", array([encode(who), encode(txt)])),
        DialogueMsg(who, txt) ->
            taggedEnvelope("DialogueMsg", array([encode(who), encode(txt)])),
        PlayerStatsMsg(st) ->
            taggedEnvelope("PlayerStatsMsg", encode(st)),
        ActiveSkillFailureMsg(reason) ->
            taggedEnvelope("ActiveSkillFailureMsg", encode(reason)),
        BattleStateMsg(snap) ->
            taggedEnvelope("BattleStateMsg", encode(snap)),
        StoryMsg(speaker, txt) ->
            taggedEnvelope("StoryMsg", array([encode(speaker), encode(txt)])),
        StorySequenceMsg(active) ->
            taggedEnvelope("StorySequenceMsg", encode(active)),
        StoryDelayMsg(ms) ->
            taggedEnvelope("StoryDelayMsg", encode(ms)),
        StoryTransitionMsg(txt, ms) ->
            taggedEnvelope("StoryTransitionMsg", array([encode(txt), encode(ms)])),
        QuestLogMsg(entries) ->
            taggedEnvelope("QuestLogMsg", encode(entries)),
        InventoryMsg(money, items) ->
            taggedEnvelope("InventoryMsg", array([encode(money), encode(items)])),
        ArtsMsg(arts) ->
            taggedEnvelope("ArtsMsg", encode(arts)),
        RewardMsg(rewards) ->
            taggedEnvelope("RewardMsg", encode(rewards)),
        CharacterCreationConfigMsg(cfg) ->
            taggedEnvelope("CharacterCreationConfigMsg", encode(cfg)),
        SystemMsg(sys) ->
            taggedEnvelope("SystemMsg", encode(sys)),
        ErrorMsg(err) ->
            taggedEnvelope("ErrorMsg", encode(err)),
    }
}

pub type PlayerResp = (String, ActionResp)

pub def formatResp(r: ActionResp): String = toJson(r)
