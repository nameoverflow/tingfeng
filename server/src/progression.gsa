// Pure Rules of Long-Term Progression: Level Caps, Proficiency, Action Costs,
// Job Streak Scaling, and Battle Growth Rewards (`progression`).

use std.option.{Option, Some, None}
use fp.{minInt, maxInt, clampFloat, floorDiv, floorInt}

pub def artProgressRequired(targetLevel: Int): Int =
    10 * maxInt(1, targetLevel) + 20

pub def combatExpRequiredForLevel(targetLevel: Int): Int = {
    let lv = maxInt(0, targetLevel);
    floorDiv(lv * lv * lv, 10)
}

pub data LevelBlock {
    BlockedByMaxLevel,
    BlockedByCombatExp(Int),
    BlockedBySourceCap(Int),
}

pub def levelBlockEq(a: Option LevelBlock, b: Option LevelBlock): Bool = match (a, b) {
    (None, None) -> true,
    (Some(BlockedByMaxLevel), Some(BlockedByMaxLevel)) -> true,
    (Some(BlockedByCombatExp(x)), Some(BlockedByCombatExp(y))) -> x == y,
    (Some(BlockedBySourceCap(x)), Some(BlockedBySourceCap(y))) -> x == y,
    _ -> false,
}

pub def levelBlock(maxLevel: Int, combatExp: Int, sourceCap: Option Int, level: Int): Option LevelBlock =
    if (level >= maxLevel) Some(BlockedByMaxLevel)
    else if (combatExp < combatExpRequiredForLevel(level + 1)) Some(BlockedByCombatExp(level + 1))
    else match sourceCap {
        Some(cap) if (level >= cap) -> Some(BlockedBySourceCap(cap)),
        _ -> None,
    }

pub def canGainProgress(
    maxLevel: Int,
    combatExp: Int,
    sourceCap: Option Int,
    level: Int,
    progress: Int
): Option LevelBlock = match levelBlock(maxLevel, combatExp, sourceCap, level) {
    Some(BlockedByCombatExp(target)) ->
        if (progress < artProgressRequired(level + 1) - 1) None
        else Some(BlockedByCombatExp(target)),
    other -> other,
}

def settleArtProgress(
    maxLevel: Int,
    combatExp: Int,
    sourceCap: Option Int,
    level: Int,
    total: Int
): (Int, Int) = match levelBlock(maxLevel, combatExp, sourceCap, level) {
    Some(BlockedByMaxLevel) -> (level, 0),
    Some(_) -> (level, minInt(total, artProgressRequired(level + 1) - 1)),
    None -> {
        let req = artProgressRequired(level + 1);
        if (total >= req) settleArtProgress(maxLevel, combatExp, sourceCap, level + 1, total - req)
        else (level, total)
    },
}

pub def addArtProgress(
    maxLevel: Int,
    combatExp: Int,
    sourceCap: Option Int,
    gain: Int,
    level: Int,
    progress: Int
): (Int, Int) =
    settleArtProgress(maxLevel, combatExp, sourceCap, level, progress + maxInt(0, gain))

pub def foundationShare(gain: Int): Int = floorDiv(gain, 2)

// Action costs & gains
pub def learnJingCost(level: Int): Int = maxInt(5, 12 + floorDiv(level, 2))
pub def learnProgress(teachBonus: Int): Int = 12 + teachBonus

pub def studyJingCost(level: Int): Int = maxInt(8, 18 + floorDiv(level, 2))
pub def studyProgress(quality: Int): Int = 10 + 2 * quality

pub def practiceJingCost(level: Int): Int = maxInt(5, 6 + floorDiv(level, 4))
pub def practiceHpCost(level: Int, vitality: Int): Int = maxInt(0, 8 + floorDiv(level, 2) - floorDiv(vitality, 4))
pub def practiceQiCost(level: Int): Int = 10 + floorDiv(level, 2)
pub def practiceProgress(foundationLevel: Int): Int = 4 + floorDiv(foundationLevel, 10)

pub def researchJingCost(level: Int): Int = maxInt(10, 20 + level)
pub def researchProgress(): Int = 20
pub def researchProgressWithInsight(insightBonus: Int): Int = researchProgress() + maxInt(0, insightBonus)

pub def combatInsightResearchBonus(): Int = 6
pub def combatInsightPracticeBonus(): Int = 3

pub def combatInsightStacksForWin(playerRank: Int, enemyRank: Int): Int =
    if (enemyRank > playerRank) 5
    else if (enemyRank == playerRank) 3
    else 0

pub def jobStreakScale(streak: Int, baseAmount: Int): Int =
    if (baseAmount <= 0) 0
    else {
        let clamped = maxInt(1, minInt(5, streak));
        let percent = 100 + (clamped - 1) * 15;
        floorDiv(baseAmount * percent + 50, 100)
    }

pub def meditateJingCost(amount: Int): Int = maxInt(5, floorDiv(amount, 10))
pub def meditateMaxQiGain(amount: Int, internalPower: Int): Int =
    maxInt(1, floorDiv(amount, 20) + floorDiv(internalPower, 50))
pub def storedMaxQiCap(basicInternal: Int, enabledInternal: Int): Int =
    100 + 10 * (basicInternal + enabledInternal)

// Busy seconds per step
pub def learnBusySeconds(): Float = 2.0
pub def studyBusySeconds(): Float = 3.0
pub def practiceBusySeconds(): Float = 3.0
pub def researchBusySeconds(): Float = 4.0
pub def meditateBusySeconds(amount: Int): Float =
    clampFloat(2.0, 10.0, intToFloat(amount) / 20.0)

// Battle rewards
pub def baseCombatExp(rank: Int): Int =
    3 + floorDiv(7 * maxInt(0, rank), 10)

pub def rewardScale(diff: Int): Float =
    if (diff <= -10) 0.1
    else if (diff <= -4) 0.5
    else if (diff <= 3) 1.0
    else if (diff <= 10) 1.3
    else 0.6

pub def battleCombatExpGain(playerRank: Int, enemyRank: Int): Int =
    floorInt(intToFloat(baseCombatExp(enemyRank)) * rewardScale(enemyRank - playerRank))

pub def battlePotentialGain(combatExpGain: Int): Int =
    if (combatExpGain <= 0) 0
    else maxInt(1, floorDiv(combatExpGain, 2))

pub def potentialCap(combatExp: Int): Int =
    200 + floorDiv(combatExp, 10)
